<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.CityObjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="City Objects"
      Background="{StaticResource BackgroundLightBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dropdown za kvart -->
        <Border Grid.Row="0" Margin="16,12,16,0" Padding="12"
                Background="White" CornerRadius="8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Select Neighborhood" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Neighborhoods}"
                          SelectedItem="{Binding SelectedNeighborhood, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          FontSize="14" Padding="8,6"/>
            </StackPanel>
        </Border>

        <!-- Lista objekata -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16,10,16,80">
                <ItemsControl ItemsSource="{Binding CityObjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="Bold" FontSize="15"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12" TextWrapping="Wrap"
                                                       Style="{StaticResource SecondaryText}"
                                                       Margin="0,2,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🗳" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding VoteDisplay}"
                                                           FontSize="12" Foreground="Gray"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Reserve"
                                                Tag="{Binding}"
                                                Click="ReserveButton_Click"
                                                Style="{StaticResource PrimaryButton}"
                                                VerticalAlignment="Center"
                                                Padding="12,6"
                                                Margin="12,0,0,0"/>
                                    </Grid>
                                    <!-- Success poruka u kartici -->
                                    <TextBlock Text="{Binding SuccessMessage}"
                                               Foreground="{StaticResource SuccessTextBrush}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding HasSuccessMessage, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>