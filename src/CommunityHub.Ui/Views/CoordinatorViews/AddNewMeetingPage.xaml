<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.AddNewMeetingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add New Meeting"
      Background="{StaticResource BackgroundLightBrush}">

    <ScrollViewer>
        <StackPanel Margin="16">

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>

                    <TextBlock Text="Topic:" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ThemeComboBox" HorizontalAlignment="Stretch" Margin="0,0,0,16" IsEditable="True">
                        <ComboBoxItem Content="Welcome"/>
                        <ComboBoxItem Content="Motivation"/>
                    </ComboBox>

                    <TextBlock Text="Start Date:" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <DatePicker x:Name="StartDatePicker" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                    <TextBlock Text="End Date:" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <DatePicker x:Name="EndDatePicker" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                    <TextBlock Text="Time (HH:mm):" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TimeTextBox" HorizontalAlignment="Stretch"
                             Margin="0,0,0,0" Text="20:00"
                             Padding="10,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

                </StackPanel>
            </Border>

            <Button Content="Schedule Meeting" HorizontalAlignment="Stretch"
                    Margin="0,0,0,8" Click="ScheduleMeetingButton_Click"
                    Style="{StaticResource PrimaryButtonLarge}"/>

            <Button Content="Cancel" HorizontalAlignment="Stretch"
                    Click="CancelButton_Click"
                    Style="{StaticResource OutlineButtonLarge}"/>

        </StackPanel>
    </ScrollViewer>
</Page>