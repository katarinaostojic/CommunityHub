<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.AddNewMeetingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add New Meeting">

    <ScrollViewer>
        <StackPanel Margin="16">

            <TextBlock Text="Topic:" FontWeight="Bold" Margin="0,0,0,4"/>
            <ComboBox x:Name="ThemeComboBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,16">
                <ComboBoxItem Content="Welcome" IsSelected="True"/>
                <ComboBoxItem Content="Motivation"/>
            </ComboBox>

            <TextBlock Text="Start Date:" FontWeight="Bold" Margin="0,0,0,4"/>
            <DatePicker x:Name="StartDatePicker" Width="200" HorizontalAlignment="Left" Margin="0,0,0,16"/>

            <TextBlock Text="End Date:" FontWeight="Bold" Margin="0,0,0,4"/>
            <DatePicker x:Name="EndDatePicker" Width="200" HorizontalAlignment="Left" Margin="0,0,0,16"/>

            <TextBlock Text="Time (HH:mm):" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="TimeTextBox" Width="200" HorizontalAlignment="Left" 
                     Margin="0,0,0,24" Text="Time..."/>

            <Button Content="Schedule Meeting" Width="200" HorizontalAlignment="Left" 
                    Margin="0,0,0,8" Click="ScheduleMeetingButton_Click"/>

            <Button Content="Cancel" Width="200" HorizontalAlignment="Left"
                    Click="CancelButton_Click"/>

        </StackPanel>
    </ScrollViewer>
</Page>