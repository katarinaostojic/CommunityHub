<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.MeetingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      Title="Meetings"
      Background="{StaticResource BackgroundLightBrush}">

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="16">

                <!-- Header sa Generate Report dugmetom -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Citizen Trust Statistics"
                               Style="{StaticResource PageTitle}"
                               Grid.Column="0"/>
                    <Button Content="Generate Report"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource PrimaryButton}"
                            Click="GenerateReportButton_Click"/>
                </Grid>

                <!-- Pie Chart statistika -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <lvc:PieChart Series="{Binding TrustSeriesCollection}"
                                      Height="150" Width="150"
                                      InnerRadius="40"
                                      LegendLocation="None"
                                      Hoverable="True"
                                      DataTooltip="{x:Null}"
                                      Grid.Column="0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <ItemsControl ItemsSource="{Binding TrustStats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                                            <Ellipse Width="8" Height="8"
                                                     Fill="{Binding Color}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="11"
                                                       Style="{StaticResource SecondaryText}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Count}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Suggestion -->
                <Border Background="{StaticResource SuccessBrush}"
                        CornerRadius="8" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding SuggestionText}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SuccessTextBrush}"
                                   FontSize="13"/>
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="12"
                                   Visibility="{Binding SuggestionLinkVisibility}">
                            <Hyperlink Foreground="{StaticResource SuccessTextBrush}"
                                       TextDecorations="Underline"
                                       Click="SuggestionLink_Click">
                                <Run Text="→ Schedule a meeting"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Filter dugmad -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="All" Margin="0,0,8,0"
                            Click="FilterAllButton_Click"
                            Style="{StaticResource FilterChipButton}"/>
                    <Button Content="Scheduled" Margin="0,0,8,0"
                            Click="FilterScheduledButton_Click"
                            Style="{StaticResource FilterChipButton}"/>
                    <Button Content="Cancelled" Margin="0,0,8,0"
                            Click="FilterCancelledButton_Click"
                            Style="{StaticResource FilterChipButton}"/>
                    <Button Content="In Preparation"
                            Click="FilterInPreparationButton_Click"
                            Style="{StaticResource FilterChipButton}"/>
                </StackPanel>

                <!-- Banneri -->
                <Border x:Name="SuccessBanner"
                        Background="{StaticResource SuccessBrush}"
                        CornerRadius="8" Padding="12" Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="SuccessText" TextWrapping="Wrap"
                               Foreground="{StaticResource SuccessTextBrush}" FontSize="13"/>
                </Border>

                <Border x:Name="ErrorBanner"
                        Background="{StaticResource DangerBrush}"
                        CornerRadius="8" Padding="12" Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap"
                               Foreground="White" FontSize="13"/>
                </Border>

                <!-- Lista sastanaka -->
                <ItemsControl ItemsSource="{Binding Meetings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TopicDisplay}"
                                               FontWeight="Bold" FontSize="15"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding DateDisplay}"
                                               Margin="0,6,0,0"
                                               Style="{StaticResource SecondaryText}"/>
                                    <TextBlock Text="{Binding TimeDisplay}"
                                               Margin="0,2,0,0"
                                               Style="{StaticResource SecondaryText}"/>
                                    <TextBlock Text="{Binding StatusDisplay}"
                                               Margin="0,2,0,0"
                                               Style="{StaticResource SecondaryText}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="View Details"
                                                Grid.Column="0"
                                                Tag="{Binding}"
                                                Style="{StaticResource OutlineButton}"
                                                Click="ViewDetailsButton_Click"/>
                                        <Button Content="Finalize Voting"
                                                Grid.Column="2"
                                                Tag="{Binding}"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="FinalizeVotingButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- FAB dugme -->
        <Button Click="AddMeetingButton_Click"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Style="{StaticResource PrimaryButton}"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Add New Meeting" VerticalAlignment="Center"
                           Margin="0,0,8,0" FontSize="13"/>
                <Border Width="28" Height="28" Background="White" CornerRadius="4">
                    <TextBlock Text="+" FontSize="18" HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </Border>
            </StackPanel>
        </Button>
    </Grid>
</Page>