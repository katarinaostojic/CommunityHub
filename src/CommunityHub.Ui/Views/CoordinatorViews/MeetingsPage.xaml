<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.MeetingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Meetings"
      Background="{StaticResource BackgroundLightBrush}">

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="16">

                <!-- Statistika -->
                <TextBlock Text="Citizen Trust Statistics" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Nov u kvartu" Style="{StaticResource SecondaryText}" Grid.Column="0"/>
                            <TextBlock Text="{Binding NewCount}" FontWeight="SemiBold" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Neaktivan gradjanin" Style="{StaticResource SecondaryText}" Grid.Column="0"/>
                            <TextBlock Text="{Binding InactiveCount}" FontWeight="SemiBold" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Aktivan gradjanin" Style="{StaticResource SecondaryText}" Grid.Column="0"/>
                            <TextBlock Text="{Binding ActiveCount}" FontWeight="SemiBold" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Istaknut gradjanin" Style="{StaticResource SecondaryText}" Grid.Column="0"/>
                            <TextBlock Text="{Binding DistinguishedCount}" FontWeight="SemiBold" Grid.Column="1"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gradjanin od povjerenja" Style="{StaticResource SecondaryText}" Grid.Column="0"/>
                            <TextBlock Text="{Binding TrustedCount}" FontWeight="SemiBold" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Suggestion -->
                <Border Background="{StaticResource SuccessBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                    <TextBlock Text="{Binding SuggestionText}" TextWrapping="Wrap"
                               Foreground="{StaticResource SuccessTextBrush}" FontSize="13"/>
                </Border>

                <!-- Filter dugmad -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="All" Margin="0,0,8,0" Click="FilterAllButton_Click"
                            Style="{StaticResource FilterChipButton}"/>
                    <Button Content="Scheduled" Margin="0,0,8,0" Click="FilterScheduledButton_Click"
                            Style="{StaticResource FilterChipButton}"/>
                    <Button Content="Cancelled" Margin="0,0,8,0" Click="FilterCancelledButton_Click"
                            Style="{StaticResource FilterChipButton}"/>
                    <Button Content="In Preparation" Click="FilterInPreparationButton_Click"
                            Style="{StaticResource FilterChipButton}"/>
                </StackPanel>

                <!-- Lista sastanaka -->
                <ItemsControl ItemsSource="{Binding Meetings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TopicDisplay}" FontWeight="Bold" FontSize="15"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding DateDisplay}" Margin="0,6,0,0"
                                               Style="{StaticResource SecondaryText}"/>
                                    <TextBlock Text="{Binding TimeDisplay}" Margin="0,2,0,0"
                                               Style="{StaticResource SecondaryText}"/>
                                    <TextBlock Text="{Binding StatusDisplay}" Margin="0,2,0,0"
                                               Style="{StaticResource SecondaryText}"/>
                                    <Button Content="Finalize Voting"
                                            Margin="0,10,0,0"
                                            Tag="{Binding}"
                                            Style="{StaticResource PrimaryButton}"
                                            Click="FinalizeVotingButton_Click"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- FAB dugme -->
        <Button Content="+" Width="50" Height="50"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,16" FontSize="24"
                Style="{StaticResource PrimaryButton}"
                Click="AddMeetingButton_Click"/>
    </Grid>
</Page>