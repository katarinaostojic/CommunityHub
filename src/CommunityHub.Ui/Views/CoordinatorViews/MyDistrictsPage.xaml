<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.MyDistrictsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Converters"
      Title="My Districts"
      Background="{StaticResource BackgroundLightBrush}">
    <Page.Resources>
        <converters:ImagePathConverter x:Key="ImageConverter"/>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <Grid Margin="16">
                <ItemsControl ItemsSource="{Binding Districts}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}" Click="DistrictCard_Click"
                                    BorderThickness="0" Padding="0" Cursor="Hand"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </ControlTemplate>
                                </Button.Template>
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource BackgroundLightBrush}"
                                                Width="70" Height="70" Margin="0,0,12,0" CornerRadius="6">
                                            <Image Source="{Binding ImagePaths, Converter={StaticResource ImageConverter}, Mode=OneWay}"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                       FontWeight="Bold" FontSize="18"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="{Binding Location, Mode=OneWay}"
                                                       FontSize="13" Style="{StaticResource SecondaryText}"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="requests pending" FontSize="12"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <Button Content="+" Click="AddDistrictButton_Click"
                Width="50" Height="50" FontSize="24"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Style="{StaticResource PrimaryButton}"/>
    </Grid>
</Page>