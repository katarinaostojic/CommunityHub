<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.MyDistrictsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Converters"
      Title="My Districts">
    <Page.Resources>
        <converters:ImagePathConverter x:Key="ImageConverter"/>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Districts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding}" Click="DistrictCard_Click"
                                Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                            <Border BorderBrush="#DDDDDD" BorderThickness="1"
                                    Margin="10,5" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#EEEEEE"
                                            Width="90" Height="90" Margin="0,0,10,0">
                                        <Image Source="{Binding ImagePaths, Converter={StaticResource ImageConverter}, Mode=OneWay}"
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                   FontWeight="Bold" FontSize="18"/>
                                        <TextBlock Text="{Binding Location, Mode=OneWay}" FontSize="13"/>
                                        <TextBlock Text="requests pending" FontSize="12" Foreground="Gray"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Margin="15">
            <TextBlock Text="Add New District" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <Button Content="+" Click="AddDistrictButton_Click"
                    Width="45" Height="45" FontSize="20"/>
        </StackPanel>
    </Grid>
</Page>