<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.NeighborhoodDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Neighborhood Details"
      Background="{StaticResource BackgroundLightBrush}">

    <ScrollViewer>
        <StackPanel Margin="16">

            <TextBlock x:Name="NeighborhoodNameText" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

            <TextBlock Text="Members" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>

            <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="{Binding Address}" Style="{StaticResource SecondaryText}"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding JoinedAt}" Style="{StaticResource SecondaryText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Meetings" HorizontalAlignment="Stretch" Margin="0,16,0,8"
                    Click="MeetingsButton_Click"
                    Style="{StaticResource PrimaryButton}"/>

            <Button Content="Back" HorizontalAlignment="Stretch"
                    Click="BackButton_Click"
                    Style="{StaticResource OutlineButton}"/>

        </StackPanel>
    </ScrollViewer>
</Page>