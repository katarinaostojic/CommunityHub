<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.NeighborhoodDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Converters"
      Title="Neighborhood Details"
      Background="{StaticResource BackgroundLightBrush}">

    <Page.Resources>
        <converters:NeighborhoodImageConverter x:Key="ImageConverter"/>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Margin="16">

            <!-- Slika + Naziv i Lokacija -->
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="100" Height="100" CornerRadius="6"
                            Background="{StaticResource BackgroundLightBrush}" Margin="0,0,12,0">
                        <Image x:Name="NeighborhoodImage" Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="NeighborhoodNameText" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="NeighborhoodLocationText" FontSize="13"
                                   Style="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Description -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Description" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="13"
                               Style="{StaticResource SecondaryText}"/>
                </StackPanel>
            </Border>

            <!-- Streets -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Streets" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="StreetsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" FontSize="13"
                                           Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Dugmad -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="View Requests" Click="RequestsButton_Click"
                        Style="{StaticResource OutlineButton}"/>
                <Button Grid.Column="2" Content="View Members" Click="MembersButton_Click"
                        Style="{StaticResource OutlineButton}"/>
            </Grid>

            <Button Content="Meetings" Click="MeetingsButton_Click"
                    HorizontalAlignment="Stretch" Margin="0,8,0,0"
                    Style="{StaticResource PrimaryButton}"/>

            <Button Content="🏙 City Objects" Click="CityObjectsButton_Click"
                    HorizontalAlignment="Stretch" Margin="0,8,0,0"
                    Style="{StaticResource OutlineButton}"/>

        </StackPanel>
    </ScrollViewer>
</Page>