<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.CityGiftsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="City Gifts"
      Background="{StaticResource BackgroundLightBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Dropdown za kvart -->
        <Border Grid.Row="0" Margin="16,12,16,0" Padding="12"
                Background="White" CornerRadius="8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Select Neighborhood" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Neighborhoods}"
                          SelectedItem="{Binding SelectedNeighborhood, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          FontSize="14" Padding="8,6"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16,10,16,16">

                <TextBlock Text="Available gifts from the city:"
                           FontSize="13" Foreground="Gray" Margin="0,0,0,8"/>

                <!-- Prazno stanje -->
                <TextBlock Text="No city gifts available at the moment."
                           FontSize="14" Foreground="Gray"
                           HorizontalAlignment="Center" Margin="0,24,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasGifts}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Lista poklona -->
                <ItemsControl ItemsSource="{Binding Gifts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="🎁 " FontSize="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding GiftTitle}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding AmountDisplay}"
                                               FontSize="13" Foreground="Gray"/>
                                    <TextBlock Text="{Binding Deadline}"
                                               FontSize="13" Foreground="Gray"
                                               Margin="0,2,0,10"/>
                                    <TextBlock Text="{Binding StatusDisplay}"
                                               FontSize="12"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Margin="0,0,0,8">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanApply}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="Apply"
                                            Tag="{Binding}"
                                            Click="ApplyButton_Click"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Center"
                                            Width="160" Padding="12,6"
                                            Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}"/>
                                    <Border Background="{StaticResource SuccessBrush}"
                                            CornerRadius="6" Padding="8,6" Margin="0,8,0,0"
                                            Visibility="{Binding HasAppliedMessage, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding AppliedMessage}"
                                                   Foreground="{StaticResource SuccessTextBrush}"
                                                   FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>