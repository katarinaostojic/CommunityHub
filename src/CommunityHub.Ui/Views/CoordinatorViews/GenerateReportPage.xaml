<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.GenerateReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Generate Report"
      Background="{StaticResource BackgroundLightBrush}">

    <ScrollViewer>
        <StackPanel Margin="16">

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>

                    <!-- Report type -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Report type:" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                    </StackPanel>
                    <ComboBox x:Name="ReportTypeComboBox"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,0,16"
                              SelectedIndex="0">
                        <ComboBoxItem Content="All meetings"/>
                        <ComboBoxItem Content="Scheduled"/>
                        <ComboBoxItem Content="Cancelled"/>
                        <ComboBoxItem Content="In Preparation"/>
                    </ComboBox>

                    <!-- Time period -->
                    <TextBlock Text="Time period:" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Start Date -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="Start Date:" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                            </StackPanel>
                            <Calendar x:Name="StartCalendar"
                                      Width="200"
                                      HorizontalAlignment="Center"
                                      SelectionMode="SingleDate"/>
                        </StackPanel>

                        <!-- End Date -->
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="End Date:" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                            </StackPanel>
                            <Calendar x:Name="EndCalendar"
                                      Width="200"
                                      HorizontalAlignment="Center"
                                      SelectionMode="SingleDate"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="DateErrorText" Foreground="{StaticResource DangerBrush}"
                               FontSize="11" Margin="0,6,0,0" Visibility="Collapsed"/>

                    <!-- Legenda -->
                    <TextBlock Text="* Required field" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" Margin="0,8,0,0"/>

                </StackPanel>
            </Border>

            <!-- Dugmad -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Cancel" Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Click="CancelButton_Click"
                        Style="{StaticResource OutlineButtonLarge}"/>
                <Button Content="Generate PDF" Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Click="GeneratePdfButton_Click"
                        Style="{StaticResource PrimaryButtonLarge}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>