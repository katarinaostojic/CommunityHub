<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.ManageRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Requests"
      Background="{StaticResource BackgroundLightBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,12">
            <Button Content="All" Margin="0,0,8,0" Click="FilterAllButton_Click"
                    Style="{StaticResource FilterChipButton}"/>
            <Button Content="Pending" Margin="0,0,8,0" Click="FilterPendingButton_Click"
                    Style="{StaticResource FilterChipButton}"/>
            <Button Content="Approved" Margin="0,0,8,0" Click="FilterApprovedButton_Click"
                    Style="{StaticResource FilterChipButton}"/>
            <Button Content="Rejected" Click="FilterRejectedButton_Click"
                    Style="{StaticResource FilterChipButton}"/>
        </StackPanel>

        <!-- Sort button -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,12">
            <Button Content="{Binding SortButtonLabel}" Click="SortButton_Click"
                    Style="{StaticResource OutlineButton}"/>
        </StackPanel>

        <!-- Requests list -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Margin="16,0,16,16">
                <ItemsControl ItemsSource="{Binding Requests}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource BackgroundLightBrush}"
                                            Width="44" Height="44" Margin="0,0,12,0"
                                            CornerRadius="22">
                                        <TextBlock Text="👤" FontSize="22"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="Bold" FontSize="14"
                                                   Foreground="{StaticResource PrimaryBrush}">
                                            <Run Text="{Binding CitizenFullName, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Style="{StaticResource SecondaryText}" Margin="0,4,0,0">
                                            <Run Text="Address: "/>
                                            <Run Text="{Binding CitizenAddress, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Style="{StaticResource SecondaryText}" Margin="0,2,0,0">
                                            <Run Text="District: "/>
                                            <Run Text="{Binding NeighborhoodName, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='Date: {0:dd.MM.yyyy.}', Mode=OneWay}"
                                                   FontSize="12" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding StatusDisplay, Mode=OneWay}"
                                                   FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding RejectionReasonDisplay, Mode=OneWay}"
                                                   FontSize="12" Foreground="{StaticResource DangerBrush}" Margin="0,2,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Approve" Margin="0,0,8,0"
                                                    Click="ApproveButton_Click" Tag="{Binding}"
                                                    Style="{StaticResource PrimaryButton}"/>
                                            <Button Content="Decline"
                                                    Click="RejectButton_Click" Tag="{Binding}"
                                                    Style="{StaticResource DangerButton}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>