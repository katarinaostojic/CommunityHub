<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.ManageRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Requests">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,5">
            <TextBlock Text="Filter by Status:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="StatusFilterComboBox" Width="130" Padding="5"
                      SelectionChanged="StatusFilterComboBox_SelectionChanged"/>
            <TextBlock Text="Sort:" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <ComboBox x:Name="SortComboBox" Width="100" Padding="5"
                      SelectionChanged="SortComboBox_SelectionChanged"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="RequestsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1"
                                Margin="10,5" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar placeholder -->
                                <Border Grid.Column="0" Background="#EEEEEE"
                                        Width="50" Height="50" Margin="0,0,10,0"
                                        CornerRadius="25">
                                    <TextBlock Text="👤" FontSize="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="Bold" FontSize="13">
                                        <Run Text="Citizen: "/>
                                        <Run Text="{Binding Citizen.Name, Mode=OneWay}"/>
                                        <Run Text="{Binding Citizen.Surname, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12">
                                        <Run Text="Address: "/>
                                        <Run Text="{Binding Citizen.Address, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12">
                                        <Run Text="District: "/>
                                        <Run Text="{Binding Neighborhood.Name, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='Date: {0:dd.MM.yyyy.}', Mode=OneWay}" FontSize="12"/>
                                    <TextBlock Text="{Binding Status, StringFormat='Status: {0}', Mode=OneWay}" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Approve" Padding="10,5" Margin="0,0,10,0"
                                                Click="ApproveButton_Click" Tag="{Binding}"/>
                                        <Button Content="Decline" Padding="10,5"
                                                Click="RejectButton_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>