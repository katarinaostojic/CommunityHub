<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.ManageRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Requests">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8">
            <Button x:Name="FilterAllButton" Content="All" Padding="10,5" Margin="0,0,5,0"
                    Click="FilterAllButton_Click"/>
            <Button x:Name="FilterPendingButton" Content="Pending" Padding="10,5" Margin="0,0,5,0"
                    Click="FilterPendingButton_Click"/>
            <Button x:Name="FilterApprovedButton" Content="Approved" Padding="10,5" Margin="0,0,5,0"
                    Click="FilterApprovedButton_Click"/>
            <Button x:Name="FilterRejectedButton" Content="Rejected" Padding="10,5"
                    Click="FilterRejectedButton_Click"/>
        </StackPanel>

        <!-- Sort button -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,8">
            <Button x:Name="SortButton" Content="{Binding SortButtonLabel}" Padding="10,5"
                    Click="SortButton_Click"/>
        </StackPanel>

        <!-- Requests list -->
        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Requests}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1"
                                Margin="10,5" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#EEEEEE"
                                        Width="50" Height="50" Margin="0,0,10,0"
                                        CornerRadius="25">
                                    <TextBlock Text="👤" FontSize="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="Bold" FontSize="13">
                                        <Run Text="Citizen: "/>
                                        <Run Text="{Binding CitizenFullName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12">
                                        <Run Text="Address: "/>
                                        <Run Text="{Binding CitizenAddress, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12">
                                        <Run Text="District: "/>
                                        <Run Text="{Binding NeighborhoodName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='Date: {0:dd.MM.yyyy.}', Mode=OneWay}" FontSize="12"/>
                                    <TextBlock Text="{Binding StatusDisplay, Mode=OneWay}" FontSize="12"/>
                                    <TextBlock Text="{Binding RejectionReasonDisplay, Mode=OneWay}" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Approve" Padding="10,5" Margin="0,0,10,0"
                                                Click="ApproveButton_Click" Tag="{Binding}"/>
                                        <Button Content="Decline" Padding="10,5"
                                                Click="RejectButton_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>