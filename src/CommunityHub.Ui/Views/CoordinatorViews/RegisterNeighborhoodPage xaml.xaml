<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.RegisterNeighborhoodPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add New District"
      Background="{StaticResource BackgroundLightBrush}">
    <ScrollViewer>
        <StackPanel Margin="16">

            <!-- Naziv i Grad -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="District Name" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <TextBox x:Name="NameTextBox" Padding="10,8" Margin="0,0,0,12"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

                    <TextBlock Text="City" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CityComboBox" HorizontalAlignment="Stretch"
                              DisplayMemberPath="Name" Margin="0,0,0,4"/>
                </StackPanel>
            </Border>

            <!-- Description -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Description" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <TextBox x:Name="DescriptionTextBox" Padding="10,8" Height="80"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                </StackPanel>
            </Border>

            <!-- Streets -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Streets" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="StreetsListBox" Grid.Column="0" Height="120" Margin="0,0,8,0"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Street Name" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="StreetNameTextBox" Padding="8,6" Margin="0,0,0,8"
                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            <TextBlock Text="Start Number" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="StartNumberTextBox" Padding="8,6" Margin="0,0,0,8"
                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            <TextBlock Text="End Number" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="EndNumberTextBox" Padding="8,6" Margin="0,0,0,8"
                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                            <Button Content="Add Street" Click="AddStreet_Click"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource OutlineButton}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Images -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Images" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <Button Content="Add Image" Click="AddImage_Click"
                            HorizontalAlignment="Stretch" Margin="0,0,0,8"
                            Style="{StaticResource OutlineButton}"/>
                    <ListBox x:Name="ImagesListBox" Height="60"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                </StackPanel>
            </Border>

            <!-- Dugmad -->
            <Button Content="Add District" Click="RegisterButton_Click"
                    HorizontalAlignment="Stretch" Margin="0,0,0,8"
                    Style="{StaticResource PrimaryButtonLarge}"/>
            <Button Content="Cancel" Click="CancelButton_Click"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource OutlineButtonLarge}"/>

        </StackPanel>
    </ScrollViewer>
</Page>