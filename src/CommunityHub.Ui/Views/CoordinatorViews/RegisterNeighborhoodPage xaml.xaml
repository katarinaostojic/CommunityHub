<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.RegisterNeighborhoodPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add New District">
    <ScrollViewer>
        <StackPanel Margin="15">

            <!-- Slika + Naziv i Grad -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#EEEEEE" Height="120" Margin="0,0,10,0">
                    <TextBlock Text="🖼" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="District Name" FontSize="12" Foreground="Gray"/>
                    <TextBox x:Name="NameTextBox" Padding="5" Margin="0,3,0,8"/>
                    <TextBlock Text="City" FontSize="12" Foreground="Gray"/>
                    <ComboBox x:Name="CityComboBox" Padding="5" Margin="0,3,0,0" DisplayMemberPath="Name"/>
                </StackPanel>
            </Grid>

            <!-- Description -->
            <TextBlock Text="Description" FontSize="12" Foreground="Gray"/>
            <TextBox x:Name="DescriptionTextBox" Padding="5" Height="80"
                     TextWrapping="Wrap" AcceptsReturn="True" Margin="0,3,0,10"/>

            <!-- Streets -->
            <TextBlock Text="Streets" FontSize="12" Foreground="Gray" Margin="0,0,0,3"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="StreetsListBox" Grid.Column="0" Height="120" Margin="0,0,5,0"/>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Street Name" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="StreetNameTextBox" Padding="5" Margin="0,2,0,5"/>
                    <TextBlock Text="Start Number" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="StartNumberTextBox" Padding="5" Margin="0,2,0,5"/>
                    <TextBlock Text="End Number" FontSize="11" Foreground="Gray"/>
                    <TextBox x:Name="EndNumberTextBox" Padding="5" Margin="0,2,0,5"/>
                    <Button Content="Add Street" Click="AddStreet_Click" Padding="5" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <!-- Images -->
            <TextBlock Text="Images" FontSize="12" Foreground="Gray"/>
            <Button Content="Add Image" Click="AddImage_Click"
                    Padding="10,5" Margin="0,3,0,5" HorizontalAlignment="Left"/>
            <ListBox x:Name="ImagesListBox" Height="60" Margin="0,0,0,10"/>

            <!-- Dugmad -->
            <Button Content="Add District" Click="RegisterButton_Click"
                    Padding="10,8" FontSize="14" Margin="0,0,0,5"/>
            <Button Content="Cancel" Click="CancelButton_Click"
                    Padding="10,8" FontSize="14"/>

        </StackPanel>
    </ScrollViewer>
</Page>