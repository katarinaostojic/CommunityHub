<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.ForumDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Forum Details"
      Background="{StaticResource BackgroundLightBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="16">

                <!-- Forum info -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{Binding Forum.Title}" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6"/>
                        <TextBlock FontSize="12" Style="{StaticResource SecondaryText}" Margin="0,0,0,2">
                            <Run Text="Author: "/>
                            <Run Text="{Binding Forum.CoordinatorFullName, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Forum.CreatedAtFormatted}" FontSize="12"
                                   Style="{StaticResource SecondaryText}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Forum.Description}" TextWrapping="Wrap"
                                   FontSize="13" Margin="0,0,0,12"/>
                        <Button Content="Close Forum" HorizontalAlignment="Left"
                                Visibility="{Binding CanClose, Converter={StaticResource BoolToVis}}"
                                Click="CloseForumButton_Click"
                                Style="{StaticResource DangerButton}"/>
                    </StackPanel>
                </Border>

                <!-- Comments -->
                <TextBlock Text="Comments" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>

                <ItemsControl ItemsSource="{Binding Comments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{StaticResource BackgroundLightBrush}"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="👤" FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CoordinatorFullName}"
                                                           FontWeight="Bold" FontSize="13"
                                                           Foreground="{StaticResource PrimaryBrush}"/>
                                                <TextBlock Text="{Binding AuthorLabel}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontSize="12" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock FontSize="11" Style="{StaticResource SecondaryText}">
                                                <Run Text="District: "/>
                                                <Run Text="{Binding NeighborhoodName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               FontSize="13" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="👍" Tag="{Binding}"
                                                Click="LikeButton_Click"
                                                Style="{StaticResource OutlineButton}"
                                                Padding="10,4" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding LikeCount}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   FontWeight="SemiBold"/>
                                        <Button Content="👎" Tag="{Binding}"
                                                Click="DislikeButton_Click"
                                                Style="{StaticResource OutlineButton}"
                                                Padding="10,4" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding DislikeCount}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add comment -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Write a comment" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                        <TextBox x:Name="CommentTextBox" Margin="0,0,0,10"
                                 Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="Write a comment..."
                                 Padding="10,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                        <Button Content="Send" HorizontalAlignment="Right"
                                Click="SendCommentButton_Click"
                                Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>