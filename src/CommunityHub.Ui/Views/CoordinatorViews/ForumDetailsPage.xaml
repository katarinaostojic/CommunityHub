<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.ForumDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Forum Details">
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="16">

                <!-- Forum info -->
                <TextBlock Text="{Binding Forum.Title}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock FontSize="12" Foreground="Gray" Margin="0,0,0,2">
                            <Run Text="Author: "/>
                            <Run Text="{Binding Forum.CoordinatorFullName, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Forum.CreatedAtFormatted}" FontSize="12"
                           Foreground="Gray" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Forum.Description}" TextWrapping="Wrap"
                           FontSize="13" Margin="0,0,0,16"/>

                <!-- Close button (only for author) -->
                <Button Content="Close Forum" HorizontalAlignment="Left"
                            Padding="10,5" Margin="0,0,0,16"
                            Click="CloseForumButton_Click"/>

                <!-- Comments -->
                <TextBlock Text="Comments:" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                <ItemsControl ItemsSource="{Binding Comments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDDDDD" BorderThickness="1"
                                    Margin="0,0,0,8" Padding="10">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CoordinatorFullName}"
                                                   FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding AuthorLabel}"
                                                   Foreground="Blue" FontSize="12" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="Gray">
                                        <Run Text="District: "/>
                                        <Run Text="{Binding NeighborhoodName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                               FontSize="13" Margin="0,6,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="👍" Tag="{Binding}"
                                                Click="LikeButton_Click" Padding="8,4" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding LikeCount}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Content="👎" Tag="{Binding}"
                                                Click="DislikeButton_Click" Padding="8,4" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding DislikeCount}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add comment -->
                <TextBox x:Name="CommentTextBox" Margin="0,8,0,4"
                         Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                         Text="Write a comment..."/>
                <Button Content="Send" HorizontalAlignment="Right"
                        Padding="15,6" Click="SendCommentButton_Click"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>