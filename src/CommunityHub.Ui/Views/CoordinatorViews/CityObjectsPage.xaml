<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.CityObjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="City Objects"
      Background="{StaticResource BackgroundLightBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0">
            <StackPanel Margin="16,12,16,80">

                <ItemsControl ItemsSource="{Binding CityObjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Bold" FontSize="15"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Style="{StaticResource SecondaryText}"
                                                   Margin="0,2,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🗳" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding VoteDisplay}"
                                                       FontSize="12" Foreground="Gray"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Reserve"
                                            Tag="{Binding}"
                                            Click="ReserveButton_Click"
                                            Style="{StaticResource PrimaryButton}"
                                            VerticalAlignment="Center"
                                            Padding="12,6"
                                            Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>