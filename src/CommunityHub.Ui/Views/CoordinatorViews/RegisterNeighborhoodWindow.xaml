<Window x:Class="CommunityHub.Ui.Views.CoordinatorViews.RegisterNeighborhoodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Registracija kvarta" Height="600" Width="500"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer>
        <StackPanel Margin="20">

            <TextBlock Text="Registracija kvarta" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Naziv"/>
            <TextBox x:Name="NameTextBox" Margin="0,5,0,15" Padding="5"/>

            <TextBlock Text="Opis"/>
            <TextBox x:Name="DescriptionTextBox" Margin="0,5,0,15" Padding="5" Height="80"
                     TextWrapping="Wrap" AcceptsReturn="True"/>

            <TextBlock Text="Grad"/>
            <ComboBox x:Name="CityComboBox" Margin="0,5,0,15" Padding="5"
                      DisplayMemberPath="Name"/>

            <TextBlock Text="Ulice" FontWeight="Bold" Margin="0,10,0,5"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="StreetNameTextBox" Grid.Column="0" Margin="0,0,5,0"
                         Padding="5" Tag="Naziv ulice"/>
                <TextBox x:Name="StartNumberTextBox" Grid.Column="1" Margin="0,0,5,0"
                         Padding="5" Tag="Od"/>
                <TextBox x:Name="EndNumberTextBox" Grid.Column="2" Margin="0,0,5,0"
                         Padding="5" Tag="Do"/>
                <Button Content="+" Grid.Column="3" Click="AddStreet_Click" Padding="5"/>
            </Grid>

            <ListBox x:Name="StreetsListBox" Margin="0,10,0,15" Height="150"/>

            <Button Content="Registruj kvart" Click="RegisterButton_Click"
                    Padding="10,8" FontSize="14" Margin="0,10,0,0"/>

        </StackPanel>
    </ScrollViewer>
</Window>