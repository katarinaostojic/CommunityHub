<Window x:Class="CommunityHub.Ui.Views.CoordinatorViews.RegisterNeighborhoodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add New District" Height="700" Width="500"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer>
        <StackPanel Margin="20">

            <TextBlock Text="Add New District" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="District Name"/>
            <TextBox x:Name="NameTextBox" Margin="0,5,0,15" Padding="5"/>

            <TextBlock Text="City"/>
            <ComboBox x:Name="CityComboBox" Margin="0,5,0,15" Padding="5"
                      DisplayMemberPath="Name"/>

            <TextBlock Text="Description"/>
            <TextBox x:Name="DescriptionTextBox" Margin="0,5,0,15" Padding="5" Height="80"
                     TextWrapping="Wrap" AcceptsReturn="True"/>

            <TextBlock Text="Streets" FontWeight="Bold" Margin="0,10,0,5"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="StreetNameTextBox" Grid.Column="0" Margin="0,0,5,0" Padding="5"/>
                <TextBox x:Name="StartNumberTextBox" Grid.Column="1" Margin="0,0,5,0" Padding="5"/>
                <TextBox x:Name="EndNumberTextBox" Grid.Column="2" Padding="5"/>
            </Grid>

            <Button Content="Add Street" Click="AddStreet_Click"
                    Padding="10,8" Margin="0,5,0,10" HorizontalAlignment="Right"/>

            <ListBox x:Name="StreetsListBox" Margin="0,0,0,15" Height="120"/>

            <TextBlock Text="Images" FontWeight="Bold" Margin="0,10,0,5"/>
            <Button Content="Add Image" Click="AddImage_Click"
                    Padding="10,8" Margin="0,5,0,5" HorizontalAlignment="Left"/>
            <ListBox x:Name="ImagesListBox" Margin="0,0,0,15" Height="80"/>

            <Button Content="Add District" Click="RegisterButton_Click"
                    Padding="10,8" FontSize="14" Margin="0,5,0,5"/>

            <Button Content="Cancel" Click="CancelButton_Click"
                    Padding="10,8" FontSize="14"/>

        </StackPanel>
    </ScrollViewer>
</Window>