<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.CategoryDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      Title="Category Details"
      Background="{StaticResource BackgroundLightBrush}">

    <ScrollViewer>
        <StackPanel Margin="16,12,16,24">

            <!-- Header kategorije -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding CategoryName}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding TotalDisplay}"
                               FontSize="13" Foreground="Gray" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Donacije -->
            <TextBlock Text="Donations:" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}" Margin="4,8,0,6"/>

            <TextBlock Text="No donations for this category yet."
                       FontSize="13" Foreground="Gray" Margin="4,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDonations}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Donations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding AmountDisplay}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DateDisplay}"
                                           FontSize="12" Foreground="Gray"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Troškovi -->
            <TextBlock Text="Expenses:" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}" Margin="4,8,0,6"/>

            <TextBlock Text="No expenses for this category yet."
                       FontSize="13" Foreground="Gray" Margin="4,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasExpenses}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Expenses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AmountDisplay}"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="#EF5350"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" | " FontSize="13" Foreground="Gray"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="13" Foreground="Gray"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" | " FontSize="13" Foreground="Gray"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DateDisplay}"
                                           FontSize="13" Foreground="Gray"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Donations by Month chart -->
            <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Donations by Month" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <lvc:CartesianChart Height="180"
                            Series="{Binding BudgetSeriesCollection}"
                            LegendLocation="Bottom"
                            DataTooltip="{x:Null}">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis>
                                <lvc:Axis.Separator>
                                    <lvc:Separator StrokeThickness="0"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis MinValue="0" FontSize="11">
                                <lvc:Axis.Separator>
                                    <lvc:Separator StrokeThickness="0.5" Stroke="#EEEEEE"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>