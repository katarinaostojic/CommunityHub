<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.BudgetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Budget"
      Background="{StaticResource BackgroundLightBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dropdown za kvart -->
        <Border Grid.Row="0" Margin="16,12,16,0" Padding="12"
                Background="White" CornerRadius="8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Select Neighborhood" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Neighborhoods}"
                          SelectedItem="{Binding SelectedNeighborhood, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          FontSize="14" Padding="8,6"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16,10,16,80">

                <!-- Total budget kartica -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Total budget"
                                   FontSize="13" Foreground="Gray"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalBudgetDisplay}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Kategorije -->
                <TextBlock Text="Categories:" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="4,8,0,6"/>

                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryName}"
                                                   FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                        <TextBlock Text="{Binding BudgetDisplay}"
                                                   FontSize="13" Foreground="Gray"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="▶"
                                            Tag="{Binding}"
                                            Click="CategoryButton_Click"
                                            Style="{StaticResource OutlineButton}"
                                            Width="36" Height="36"
                                            Padding="0"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- FAB dugme -->
        <Button Grid.Row="2"
                Content="➕  Add Expense"
                Click="AddExpenseButton_Click"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right"
                Margin="16,8,16,16"
                Padding="16,10"/>
    </Grid>
</Page>