<Window x:Class="CommunityHub.Ui.Views.CoordinatorViews.CoordinatorMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KvartAPP" Height="750" Width="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Action Bar -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="≡" FontSize="22" VerticalAlignment="Center"
                           Foreground="White" Cursor="Hand" MouseLeftButtonUp="HamburgerButton_Click"/>
                <TextBlock x:Name="PageTitleTextBlock" Grid.Column="1" Text="KvartApp" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="10,0,0,0" Foreground="White"/>
                <TextBlock Grid.Column="2" Text="⋮" FontSize="22" VerticalAlignment="Center" Foreground="White"/>
            </Grid>
        </Border>

        <!-- Sadrzaj -->
        <Grid Grid.Row="1" Background="{StaticResource BackgroundLightBrush}">
            <UniformGrid x:Name="DashboardGrid" Columns="2" Margin="15">
                <Button Content="My Districts" Click="MyDistrictsButton_Click" Margin="5"
                        FontSize="14" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Requests" Click="RequestsButton_Click" Margin="5"
                        FontSize="14" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Meetings" Click="MeetingsButton_Click" Margin="5"
                        FontSize="14" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Forums" Click="ForumsButton_Click" Margin="5"
                        FontSize="14" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Budget" Margin="5"
                        FontSize="14" Style="{StaticResource OutlineButton}"/>
                <Button Content="City Objects" Margin="5"
                        FontSize="14" Style="{StaticResource OutlineButton}"/>
                <Button Content="Citizen Statistics" Margin="5"
                        FontSize="14" Style="{StaticResource OutlineButton}"/>
                <Button Content="Reviews" Margin="5"
                        FontSize="14" Style="{StaticResource OutlineButton}"/>
                <Button Content="City Gifts" Margin="5"
                        FontSize="14" Style="{StaticResource OutlineButton}"/>
                <Button Content="Log Out" Click="LogoutButton_Click" Margin="5"
                        FontSize="14" Style="{StaticResource DangerButton}"/>
            </UniformGrid>

            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>