<Window x:Class="CommunityHub.Ui.Views.CoordinatorViews.ManageRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Manage Access Requests" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Manage Access Requests" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Filter by status:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="StatusFilterComboBox" Width="200" Padding="5"
                      SelectionChanged="StatusFilterComboBox_SelectionChanged"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="RequestsDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Citizen" Binding="{Binding CitizenFullName}" Width="150"/>
                <DataGridTextColumn Header="Neighborhood" Binding="{Binding NeighborhoodName}" Width="150"/>
                <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                <DataGridTextColumn Header="Rejection Reason" Binding="{Binding RejectionReason}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Approve" Click="ApproveButton_Click"
                    Padding="15,8" Margin="0,0,10,0" FontSize="14"/>
            <Button Content="Reject" Click="RejectButton_Click"
                    Padding="15,8" Margin="0,0,10,0" FontSize="14"/>
            <Button Content="Back" Click="BackButton_Click"
                    Padding="15,8" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>