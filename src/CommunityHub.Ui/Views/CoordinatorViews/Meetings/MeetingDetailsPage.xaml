<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.MeetingDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Meeting Details"
      Background="{StaticResource BackgroundLightBrush}">

    <ScrollViewer>
        <StackPanel Margin="16">

            <!-- Info kartica -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding TopicDisplay}"
                               FontWeight="Bold" FontSize="15"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding DateDisplay}"
                               Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DateRangeDisplay}"
                               Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TimeDisplay}"
                               Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding StatusDisplay}"
                               Style="{StaticResource SecondaryText}"/>
                </StackPanel>
            </Border>

            <!-- Citizen votes -->
            <TextBlock Text="Citizen votes:" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

            <ItemsControl ItemsSource="{Binding VoteItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DateLabel}"
                                               FontWeight="SemiBold" Grid.Column="0"/>
                                    <TextBlock Text="{Binding VotesLabel}"
                                               Style="{StaticResource SecondaryText}"
                                               Grid.Column="1"/>
                                </Grid>
                                <ProgressBar Value="{Binding Percentage}"
                                             Maximum="100" Height="6"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             Background="{StaticResource BorderBrush}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>