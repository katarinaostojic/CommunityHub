<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.CoordinatorDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard"
      Background="{StaticResource BackgroundLightBrush}">

    <UniformGrid Columns="2" Margin="15">
        <Button Content="My Districts" Click="MyDistrictsButton_Click" Margin="5"
                FontSize="14" Style="{StaticResource PrimaryButton}"/>
        <Button Content="Requests" Click="RequestsButton_Click" Margin="5"
                FontSize="14" Style="{StaticResource PrimaryButton}"/>
        <Button Content="Forums" Click="ForumsButton_Click" Margin="5"
                FontSize="14" Style="{StaticResource PrimaryButton}"/>
        <Button Content="Budget" Margin="5"
                FontSize="14" Style="{StaticResource OutlineButton}"/>
        <Button Content="City Objects" Margin="5"
                FontSize="14" Style="{StaticResource OutlineButton}"/>
        <Button Content="Citizen Statistics" Margin="5"
                FontSize="14" Style="{StaticResource OutlineButton}"/>
        <Button Content="Reviews" Margin="5"
                FontSize="14" Style="{StaticResource OutlineButton}"/>
        <Button Content="City Gifts" Margin="5"
                FontSize="14" Style="{StaticResource OutlineButton}"/>
        <Button Content="Log Out" Click="LogoutButton_Click" Margin="5"
                FontSize="14" Style="{StaticResource DangerButton}"/>
    </UniformGrid>
</Page>