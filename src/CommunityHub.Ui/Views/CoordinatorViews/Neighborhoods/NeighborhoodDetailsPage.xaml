<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.NeighborhoodDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Neighborhood Details"
      Background="{StaticResource BackgroundLightBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0">
            <StackPanel Margin="16">

                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="100" Height="100" CornerRadius="6"
                                Background="{StaticResource BackgroundLightBrush}" Margin="0,0,12,0">
                            <Image x:Name="NeighborhoodImage" Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="NeighborhoodNameText" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="NeighborhoodLocationText" FontSize="13"
                                       Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Description" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="13"
                                   Style="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Streets" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="StreetsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" FontSize="13"
                                               Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{StaticResource PrimaryBrush}" Padding="0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="MeetingsButton_Click"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📅" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Meetings" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Click="RequestsButton_Click"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Requests" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Click="MembersButton_Click"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="👥" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Members" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Click="BudgetButton_Click"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💰" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Budget" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Click="CityObjectsButton_Click"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="White">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🏛️" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="City Objects" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

    </Grid>
</Page>