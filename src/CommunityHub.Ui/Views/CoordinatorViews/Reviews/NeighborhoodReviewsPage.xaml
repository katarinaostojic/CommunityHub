<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.NeighborhoodReviewsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Neighborhood Reviews"
      Background="{StaticResource BackgroundLightBrush}">

    <ScrollViewer>
        <StackPanel Margin="16,12,16,24">

            <!-- Dropdown za kvart -->
            <Border Margin="0,0,0,10" Padding="12"
                    Background="White" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Select Neighborhood" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Neighborhoods}"
                              SelectedItem="{Binding SelectedNeighborhood, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              FontSize="14" Padding="8,6"/>
                </StackPanel>
            </Border>

            <!-- Average rating kartica -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Average rating (last 12 months)"
                               FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding AverageRating}"
                                   FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding AverageStarDisplay}"
                                   FontSize="28"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- All reviews label -->
            <TextBlock Text="All reviews:" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       Margin="4,8,0,4"/>

            <!-- Prazno stanje -->
            <TextBlock Text="No reviews for this neighborhood yet."
                       FontSize="14" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,24,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasReviews}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Lista recenzija -->
            <ItemsControl ItemsSource="{Binding Reviews}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding StarDisplay}"
                                               FontSize="20"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding CommentDisplay}"
                                               FontSize="13" TextWrapping="Wrap"
                                               Style="{StaticResource SecondaryText}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding RatingDisplay}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Top"
                                           Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>