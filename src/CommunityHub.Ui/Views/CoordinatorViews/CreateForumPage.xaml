<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.CreateForumPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add New Forum">
    <StackPanel Margin="16">

        <TextBlock Text="New Forum" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="Fill in the details below to create a new forum for all coordinators."
                   FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <TextBlock Text="Forum Title*" FontSize="13" Margin="0,0,0,4"/>
        <TextBox x:Name="TitleTextBox" Margin="0,0,0,12" Height="35"/>

        <TextBlock Text="Description*" FontSize="13" Margin="0,0,0,4"/>
        <TextBox x:Name="DescriptionTextBox" Margin="0,0,0,4"
                 Height="120" TextWrapping="Wrap" AcceptsReturn="True"
                 MaxLength="500"/>
        <TextBlock x:Name="CharCountText" Text="0/500" FontSize="11"
                   Foreground="Gray" HorizontalAlignment="Right" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="15,6" Margin="0,0,10,0"
                    Click="CancelButton_Click"/>
            <Button Content="Create Forum" Padding="15,6"
                    Click="CreateForumButton_Click"/>
        </StackPanel>

    </StackPanel>
</Page>