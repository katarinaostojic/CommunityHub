<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.CreateForumPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add New Forum"
      Background="{StaticResource BackgroundLightBrush}">
    <ScrollViewer>
        <StackPanel Margin="16">

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>

                    <!-- Forum Title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Forum Title:" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBox x:Name="TitleTextBox" Margin="0,0,0,4" Padding="10,8"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                    <TextBlock x:Name="TitleErrorText" Foreground="{StaticResource DangerBrush}"
                               FontSize="11" Margin="0,0,0,10" Visibility="Collapsed"/>

                    <!-- Description -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Description:" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text=" *" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBox x:Name="DescriptionTextBox" Margin="0,0,0,4"
                             Height="120" TextWrapping="Wrap" AcceptsReturn="True"
                             MaxLength="500" Padding="10,8"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                    <TextBlock x:Name="CharCountText" Text="0/500" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" Margin="0,0,0,4"/>
                    <TextBlock x:Name="DescriptionErrorText" Foreground="{StaticResource DangerBrush}"
                               FontSize="11" Margin="0,0,0,4" Visibility="Collapsed"/>

                    <!-- Legenda -->
                    <TextBlock Text="* Required field" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" Margin="0,4,0,0"/>

                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Cancel" Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Click="CancelButton_Click"
                        Style="{StaticResource OutlineButtonLarge}"/>
                <Button Content="Create Forum" Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Click="CreateForumButton_Click"
                        Style="{StaticResource PrimaryButtonLarge}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>