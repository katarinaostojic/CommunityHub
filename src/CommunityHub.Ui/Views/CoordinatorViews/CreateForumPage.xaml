<Page x:Class="CommunityHub.Ui.Views.CoordinatorViews.CreateForumPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Add New Forum"
      Background="{StaticResource BackgroundLightBrush}">
    <ScrollViewer>
        <StackPanel Margin="16">

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="New Forum" Style="{StaticResource PageTitle}" Margin="0,0,0,6"/>
                    <TextBlock Text="Fill in the details below to create a new forum for all coordinators."
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="Forum Title*" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TitleTextBox" Margin="0,0,0,16" Padding="10,8"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>

                    <TextBlock Text="Description*" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <TextBox x:Name="DescriptionTextBox" Margin="0,0,0,4"
                             Height="120" TextWrapping="Wrap" AcceptsReturn="True"
                             MaxLength="500" Padding="10,8"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                    <TextBlock x:Name="CharCountText" Text="0/500" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" Margin="0,0,0,4"/>
                </StackPanel>
            </Border>

            <Button Content="Create Forum" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                    Click="CreateForumButton_Click"
                    Style="{StaticResource PrimaryButtonLarge}"/>
            <Button Content="Cancel" HorizontalAlignment="Stretch"
                    Click="CancelButton_Click"
                    Style="{StaticResource OutlineButtonLarge}"/>

        </StackPanel>
    </ScrollViewer>
</Page>