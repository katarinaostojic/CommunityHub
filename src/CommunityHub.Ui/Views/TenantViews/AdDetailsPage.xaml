<Page x:Class="CommunityHub.Ui.Views.TenantViews.AdDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:CommunityHub.Ui.Controls"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="☰  Menu"
                        Style="{StaticResource GhostWhiteButton}"
                        Margin="0,0,10,0"
                        Click="MenuButton_Click"/>
                <TextBlock Grid.Column="2" x:Name="UserNameTextBlock"
                           VerticalAlignment="Center" Foreground="White"
                           FontSize="15" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="👤"
                           VerticalAlignment="Center" Foreground="White" FontSize="17"/>
            </Grid>
        </Border>

        <!-- Title + go back -->
        <Grid Grid.Row="1" Margin="16,12,16,8">
            <Button Content="← Go back"
                    Style="{StaticResource OutlineButton}"
                    HorizontalAlignment="Left"
                    Click="GoBackButton_Click"/>
            <TextBlock Text="My Ad Details"
                       Style="{StaticResource PageTitle}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16,0,16,16">
            <StackPanel>

                <!-- My advertisement section -->
                <TextBlock Text="My advertisement" FontSize="15" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16,12" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TYPE, CATEGORY, DATE RANGE -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="TYPE" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Style="{StaticResource StatusBadge}"
                                    VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock x:Name="AdTypeText" FontSize="13" FontWeight="SemiBold"/>
                            </Border>

                            <TextBlock Grid.Column="3" Text="CATEGORY" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" x:Name="AdCategoryText"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>

                            <TextBlock Grid.Column="6" Text="DATE RANGE" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="7" x:Name="AdDateRangeText"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>

                            <Button Grid.Column="9" x:Name="ArchiveButton"
                                    Content="Archive"
                                    Style="{StaticResource DangerButton}"
                                    VerticalAlignment="Center"
                                    Click="ArchiveButton_Click"/>
                        </Grid>

                        <!-- DESCRIPTION -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="AdDescriptionText" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Booked slots -->
                <TextBlock x:Name="BookedSlotsTitleText" FontSize="15" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <ItemsControl x:Name="BookedSlotsPanel" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <!-- Tenant name -->
                                    <TextBlock Text="{Binding TenantName}"
                                               FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>

                                    <!-- Slot chips -->
                                    <ItemsControl ItemsSource="{Binding Slots}" Margin="0,0,0,8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource PrimaryBrush}"
                                                        CornerRadius="20" Padding="12,6" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Display}"
                                                               Foreground="White" FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Their ad -->
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="THEIR AD" Style="{StaticResource SectionTitle}"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding TheirAdDescription}"
                                                       FontSize="13" FontStyle="Italic"
                                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding TheirAdType}"
                                                           Style="{StaticResource SecondaryText}"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Text="·"
                                                           Style="{StaticResource SecondaryText}"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding TheirAdCategory}"
                                                           Style="{StaticResource SecondaryText}"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Text="·"
                                                           Style="{StaticResource SecondaryText}"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding TheirAdDateRange}"
                                                           Style="{StaticResource SecondaryText}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Free slots -->
                <TextBlock Text="Free Slots" FontSize="15" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16,12">
                    <ItemsControl x:Name="FreeSlotsPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="20"
                                            Padding="12,6" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding DateDisplay}"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                    </Border>

                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Slots}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="20"
                                                        Padding="12,6" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Display}"
                                                               FontSize="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <controls:MenuPanel Grid.Row="0" Grid.RowSpan="3" x:Name="AppMenu"/>
    </Grid>
</Page>