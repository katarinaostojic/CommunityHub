<Page x:Class="CommunityHub.Ui.Views.TenantViews.AdPostedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:CommunityHub.Ui.Controls"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="☰  Menu"
                        Style="{StaticResource GhostWhiteButton}"
                        Margin="0,0,10,0"
                        Click="MenuButton_Click"/>
                <TextBlock Grid.Column="2" x:Name="UserNameTextBlock"
                           VerticalAlignment="Center" Foreground="White"
                           FontSize="15" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="👤"
                           VerticalAlignment="Center" Foreground="White" FontSize="17"/>
            </Grid>
        </Border>

        <!-- Title -->
        <TextBlock Grid.Row="1" Text="Ad posted"
                   Style="{StaticResource PageTitle}"
                   Margin="16,12,16,8"/>

        <!-- Success box -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="16,12" Margin="16,0,16,12">
            <StackPanel>
                <TextBlock Text="✔ Your ad has been posted successfully!"
                           FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Time slots created: 16:00–17:00, 17:00–18:00, 18:00–19:00, 19:00–20:00 for each day in your date range."
                           FontSize ="15" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Ad summary -->
        <Border Grid.Row="3" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1"
                CornerRadius="6" Padding="20,14" Margin="16,0,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="TYPE" Style="{StaticResource SectionTitle}"
                           FontSize="14" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Style="{StaticResource StatusBadge}"
                        VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock x:Name="AdTypeText" FontSize="15" FontWeight="SemiBold"/>
                </Border>

                <TextBlock Grid.Column="3" Text="CATEGORY" Style="{StaticResource SectionTitle}"
                           FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" x:Name="AdCategoryText"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>

                <TextBlock Grid.Column="6" Text="DATE RANGE" Style="{StaticResource SectionTitle}"
                           FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="7" x:Name="AdDateRangeText"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>

                <TextBlock Grid.Column="9" Text="BUILDING" Style="{StaticResource SectionTitle}"
                           FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="10" x:Name="AdBuildingText"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Matching ads -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="16,0,16,8">
            <StackPanel>
                <TextBlock x:Name="MatchingAdsTitle"
                           FontSize="13" Style="{StaticResource SecondaryText}"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,8"/>
                <ItemsControl x:Name="MatchingAdsPanel">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Author + type -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding AuthorName}"
                                                   FontSize="15" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource StatusBadge}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeDisplay}" FontSize="13"/>
                                        </Border>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Text="{Binding Description}"
                                               Style="{StaticResource SecondaryText}"
                                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                                    <!-- Footer -->
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DateRangeDisplay}"
                                                       Style="{StaticResource SecondaryText}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Border Background="#EEF2FF" CornerRadius="4"
                                                    Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryDisplay}"
                                                           FontSize="12" Foreground="#4338CA"/>
                                            </Border>
                                            <Border BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="4"
                                                    Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OverlapDisplay}" FontSize="12"/>
                                            </Border>
                                        </StackPanel>
                                        <Button Content="View Slots →"
                                                Style="{StaticResource OutlineButton}"
                                                HorizontalAlignment="Right"
                                                Tag="{Binding}"
                                                Click="ViewSlotsButton_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Grid Grid.Row="5" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="← Back to Notice Board"
                    Style="{StaticResource OutlineButtonLarge}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,8,0"
                    Click="BackButton_Click"/>
            <Button Grid.Column="1" Content="Done"
                    Style="{StaticResource PrimaryButtonLarge}"
                    HorizontalAlignment="Stretch"
                    Margin="8,0,0,0"
                    Click="BackButton_Click"/>
        </Grid>

        <controls:MenuPanel Grid.Row="0" Grid.RowSpan="6" x:Name="AppMenu"/>
    </Grid>
</Page>