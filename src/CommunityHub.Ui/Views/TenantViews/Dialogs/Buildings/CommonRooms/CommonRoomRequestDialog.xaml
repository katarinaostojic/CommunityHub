<Window x:Class="CommunityHub.Ui.Views.TenantViews.Dialogs.Buildings.CommonRoomRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <StackPanel Margin="30">

        <!-- Naslov -->
        <TextBlock Text="Request rental"
                   Style="{StaticResource PageTitle}"
                   Margin="0,0,0,20"/>

        <!-- Building info -->
        <Border BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6"
                Padding="16,12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Building: "
                           Style="{StaticResource SecondaryText}" FontSize="13"/>
                <TextBlock Text="{Binding BuildingInfo}"
                           FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Info o prostoriji -->
        <Border BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6"
                Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="ROOM"
                           Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="FLOOR"
                           Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="RENTAL TYPE"
                           Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{Binding RoomName}"
                           FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding FloorDisplay}"
                           FontSize="13"/>
                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="{Binding RentalTypeDisplay}"
                           FontSize="13"/>
            </Grid>
        </Border>

        <!-- Date range -->
        <TextBlock Text="DATE RANGE *"
                   Style="{StaticResource SecondaryText}"
                   FontSize="11" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DatePicker Grid.Column="0" x:Name="DateFromPicker"
                        DisplayDateStart="{x:Static sys:DateTime.Today}"/>
            <TextBlock Grid.Column="1" Text=" - "
                       VerticalAlignment="Center" Margin="8,0"/>
            <DatePicker Grid.Column="2" x:Name="DateToPicker"
                        DisplayDateStart="{x:Static sys:DateTime.Today}"/>
        </Grid>
        <TextBlock Text="{Binding DateError}"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="13" Margin="0,0,0,12"
                   Visibility="{Binding HasDateError, Converter={StaticResource BoolToVis}}"
                   TextWrapping="Wrap"/>

        <!-- What happens next -->
        <Border BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6"
                Padding="16,12" Margin="0,10,0,24">
            <StackPanel>
                <TextBlock Text="What happens next?"
                           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Style="{StaticResource SecondaryText}"
                           Text="Your request will be sent to the building administrator. Status will be set to Pending. If your requested dates are not available, the administrator may suggest alternative dates."/>
            </StackPanel>
        </Border>

        <!-- Dugmad -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel"
                    Style="{StaticResource OutlineButton}"
                    HorizontalAlignment="Stretch"
                    Click="CancelButton_Click"/>
            <Button Grid.Column="2" Content="Send request"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch"
                    Click="SendRequestButton_Click"/>
        </Grid>

    </StackPanel>
</Window>