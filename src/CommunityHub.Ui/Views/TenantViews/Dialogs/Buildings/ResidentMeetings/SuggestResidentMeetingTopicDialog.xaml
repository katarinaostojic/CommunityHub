<Window x:Class="CommunityHub.Ui.Views.TenantViews.Dialogs.Buildings.SuggestResidentMeetingTopicDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundLightBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24"
            Margin="18">
        <StackPanel>
            <TextBlock Text="Suggest a Topic"
                       Style="{StaticResource PageTitle}"
                       Margin="0,0,0,16"/>

            <Border Background="{StaticResource PrimarySoftBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding BuildingInfo}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,6,0,0">
                        <Run Text="Meeting: "/>
                        <Run Text="{Binding MeetingDate}" FontWeight="SemiBold"/>
                        <Run Text=" at "/>
                        <Run Text="{Binding MeetingTime}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="TOPIC *"
                       Style="{StaticResource SectionTitle}"
                       Margin="0,0,0,6"/>

            <TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}"
                     Height="110"
                     Padding="10"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     FontSize="14"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Margin="0,0,0,4"/>

            <TextBlock Text="{Binding TopicError}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="13"
                       Margin="0,0,0,16"
                       Visibility="{Binding HasTopicError, Converter={StaticResource BoolToVis}}"
                       TextWrapping="Wrap"/>

            <TextBlock Text="You can suggest topics up to 24h before the meeting."
                       Style="{StaticResource SecondaryText}"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancel"
                        Style="{StaticResource OutlineButton}"
                        HorizontalAlignment="Stretch"
                        Click="CancelButton_Click"/>

                <Button Grid.Column="2"
                        Content="Suggest Topic"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Click="SuggestTopicButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>