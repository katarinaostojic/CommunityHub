<Window x:Class="CommunityHub.Ui.Views.TenantViews.Dialogs.Buildings.ReportProblemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <StackPanel Margin="30">

        <TextBlock Text="Report a problem"
                   Style="{StaticResource PageTitle}"
                   Margin="0,0,0,20"/>

        <Border BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Building: "
                           Style="{StaticResource SecondaryText}"
                           FontSize="13"/>
                <TextBlock Text="{Binding BuildingInfo}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="DESCRIPTION *"
                   Style="{StaticResource SecondaryText}"
                   FontSize="11"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="DescriptionTextBox"
                 Height="120"
                 Padding="10"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 BorderBrush="{StaticResource BorderBrush}"
                 BorderThickness="1"
                 FontSize="14"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 Margin="0,0,0,4"/>

        <TextBlock Text="{Binding DescriptionError}"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="13"
                   Margin="0,0,0,12"
                   Visibility="{Binding HasDescriptionError, Converter={StaticResource BoolToVis}}"
                   TextWrapping="Wrap"/>

        <TextBlock Text="PRIORITY *"
                   Style="{StaticResource SecondaryText}"
                   FontSize="11"
                   Margin="0,0,0,6"/>

        <ComboBox x:Name="PriorityComboBox"
                  ItemsSource="{Binding PriorityOptions}"
                  Style="{StaticResource TenantFormComboBox}"
                  HorizontalAlignment="Stretch"
                  Margin="0,0,0,4"/>

        <TextBlock Text="{Binding PriorityError}"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="13"
                   Margin="0,0,0,12"
                   Visibility="{Binding HasPriorityError, Converter={StaticResource BoolToVis}}"
                   TextWrapping="Wrap"/>

        <Border BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,10,0,24">
            <StackPanel>
                <TextBlock Text="What happens next?"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Your problem report will be sent to the building administrator. It starts as unresolved. When the administrator marks it as potentially solved, you will be able to confirm that it is resolved."
                           TextWrapping="Wrap"
                           FontSize="12"
                           Style="{StaticResource SecondaryText}"/>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Cancel"
                    Style="{StaticResource OutlineButton}"
                    HorizontalAlignment="Stretch"
                    Click="CancelButton_Click"/>

            <Button Grid.Column="2"
                    Content="Send report"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch"
                    Click="SendReportButton_Click"/>
        </Grid>

    </StackPanel>
</Window>