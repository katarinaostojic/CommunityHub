<Window x:Class="CommunityHub.Ui.Views.TenantViews.BuildingAccessRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundLightBrush}">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24"
            Margin="18">

        <StackPanel>

            <!-- Title -->
            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource PageTitle}"
                       Margin="0,0,0,16"/>

            <!-- Info intro -->
            <Border Background="{StaticResource PrimarySoftBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏢"
                               FontSize="30"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>

                    <StackPanel>
                        <TextBlock Text="Request building access"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,0,0,3"/>

                        <TextBlock Text="Select your apartment number to request access."
                                   FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   Width="360"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Building info -->
            <Border Background="{StaticResource SurfaceSoftBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,16">
                <TextBlock Text="{Binding BuildingInfo}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Unit number -->
            <TextBlock Text="APARTMENT NUMBER *"
                       Style="{StaticResource SectionTitle}"
                       Margin="0,0,0,6"/>

            <ComboBox ItemsSource="{Binding SortedUnitNumbers}"
                      Text="{Binding UnitNumber, UpdateSourceTrigger=PropertyChanged}"
                      IsEditable="True"
                      HorizontalAlignment="Stretch"
                      Style="{StaticResource TenantEditableFormComboBox}"
                      Margin="0,0,0,12"/>

            <!-- Warning -->
            <Border Background="{StaticResource AccentSoftBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️"
                               FontSize="14"
                               Margin="0,0,8,0"
                               VerticalAlignment="Top"/>

                    <TextBlock Text="{Binding WarningMessage}"
                               Foreground="{StaticResource SecondaryBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Width="380"/>
                </StackPanel>
            </Border>

            <!-- Note -->
            <TextBlock Text="Make sure to provide correct details as your request must be approved by the building administrator."
                       Style="{StaticResource SecondaryText}"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <!-- Actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancel"
                        Style="{StaticResource OutlineButton}"
                        HorizontalAlignment="Stretch"
                        Click="CancelButton_Click"/>

                <Button Grid.Column="2"
                        Content="Send Request"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Click="SendRequestButton_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>