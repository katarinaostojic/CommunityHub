<Window x:Class="CommunityHub.Ui.Views.TenantViews.RequestAccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Margin="30">

        <!-- Naslov -->
        <TextBlock x:Name="TitleTextBlock"
                   Style="{StaticResource PageTitle}"
                   Margin="0,0,0,20"/>

        <!-- Ikonica i opis -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🏢" FontSize="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock Text="Select your apartment number to request access"
                       FontSize="14" VerticalAlignment="Center"
                       TextWrapping="Wrap" Width="360"/>
        </StackPanel>

        <!-- Info o zgradi -->
        <TextBlock x:Name="BuildingInfoTextBlock"
                   Style="{StaticResource SecondaryText}"
                   Margin="0,0,0,16"/>

        <!-- Unos broja stana -->
        <TextBlock Text="Enter Apartment Number:" FontWeight="SemiBold"
                   FontSize="13" Margin="0,0,0,6"/>
        <ComboBox x:Name="UnitComboBox"
                  IsEditable="True"
                  FontSize="13" Padding="6,4"
                  Margin="0,0,0,8"
                  SelectionChanged="UnitComboBox_SelectionChanged"
                  KeyUp="UnitComboBox_KeyUp"/>

        <!-- Warning -->
        <StackPanel x:Name="WarningPanel" Orientation="Horizontal"
                    Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"/>
            <TextBlock x:Name="WarningTextBlock"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="13"
                       TextWrapping="Wrap" Width="380"/>
        </StackPanel>

        <!-- Napomena -->
        <TextBlock Text="Make sure to provide correct details as your request must be approved by the building administrator."
                   Style="{StaticResource SecondaryText}"
                   FontStyle="Italic"
                   TextWrapping="Wrap" Margin="0,0,0,24"/>

        <!-- Dugmad -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel"
                    Style="{StaticResource OutlineButton}"
                    HorizontalAlignment="Stretch"
                    Click="CancelButton_Click"/>
            <Button Grid.Column="2" Content="Send Request"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch"
                    Click="SendRequestButton_Click"/>
        </Grid>

    </StackPanel>
</Window>