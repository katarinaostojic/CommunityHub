<Window x:Class="CommunityHub.Ui.Views.TenantViews.CancelBuildingAccessRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <StackPanel Margin="30">

        <TextBlock Text="Cancel request?" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="⚠️" FontSize="28" Margin="0,0,12,0" VerticalAlignment="Top"/>
            <TextBlock x:Name="MessageTextBlock" FontSize="13"
                       TextWrapping="Wrap" Width="320" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Go back"
                    Style="{StaticResource OutlineButton}"
                    HorizontalAlignment="Stretch"
                    Click="GoBackButton_Click"/>
            <Button Grid.Column="2" Content="Cancel Request"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch"
                    Click="ConfirmButton_Click"/>
        </Grid>
    </StackPanel>
</Window>