<Page x:Class="CommunityHub.Ui.Views.TenantViews.AdPostedPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:CommunityHub.Ui.Controls"
      mc:Ignorable="d">

    <Grid Background="{StaticResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0"
        Background="{StaticResource PrimaryBrush}"
        Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                Content="☰  Menu"
                Style="{StaticResource GhostWhiteButton}"
                Margin="0,0,10,0"
                Click="MenuButton_Click"/>

                <controls:NotificationBell Grid.Column="2"
                           x:Name="NotificationBell"
                           Margin="0,0,8,0"/>

                <TextBlock Grid.Column="3"
                   x:Name="UserNameTextBlock"
                   VerticalAlignment="Center"
                   Foreground="White"
                   FontSize="15"
                   Margin="0,0,8,0"/>

                <TextBlock Grid.Column="4"
                   Text="👤"
                   VerticalAlignment="Center"
                   Foreground="White"
                   FontSize="17"/>
            </Grid>
        </Border>

        <!-- Success banner -->
        <Border Grid.Row="1"
                x:Name="SuccessBanner"
                Visibility="Collapsed"
                Background="{StaticResource SuccessBrush}"
                BorderBrush="{StaticResource SuccessTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="16,8,16,0">
            <TextBlock x:Name="SuccessTextBlock"
                       Foreground="{StaticResource SuccessTextBrush}"
                       FontSize="13"/>
        </Border>

        <!-- Title -->
        <TextBlock Grid.Row="2"
                   Text="Ad posted"
                   Style="{StaticResource PageTitle}"
                   Margin="16,12,16,8"/>

        <!-- Success box -->
        <Border Grid.Row="3"
                Background="{StaticResource PrimarySoftBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="16,0,16,12">
            <StackPanel>
                <TextBlock Text="✔ Your ad has been posted successfully!"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Time slots created: 16:00–17:00, 17:00–18:00, 18:00–19:00, 19:00–20:00 for each day in your date range."
                           FontSize="15"
                           Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Ad summary -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20,14"
                Margin="16,0,16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="TYPE"
                           Style="{StaticResource SectionTitle}"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="1"
                        Background="{StaticResource PrimarySoftBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="9,4"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                    <TextBlock Text="{Binding TypeDisplay}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </Border>

                <TextBlock Grid.Column="3"
                           Text="CATEGORY"
                           Style="{StaticResource SectionTitle}"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="4"
                        Background="{StaticResource PrimarySoftBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="9,4"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                    <TextBlock Text="{Binding CategoryDisplay}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </Border>

                <TextBlock Grid.Column="6"
                           Text="DATE RANGE"
                           Style="{StaticResource SectionTitle}"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="7"
                           Text="{Binding DateRangeDisplay}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>

                <TextBlock Grid.Column="9"
                           Text="BUILDING"
                           Style="{StaticResource SectionTitle}"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="10"
                           Text="{Binding BuildingDisplay}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Matching ads -->
        <ScrollViewer Grid.Row="5"
                      VerticalScrollBarVisibility="Auto"
                      Margin="16,0,16,8">
            <StackPanel>
                <TextBlock Text="{Binding MatchingAdsTitle}"
                           FontSize="13"
                           Style="{StaticResource SecondaryText}"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,8"/>

                <ItemsControl ItemsSource="{Binding MatchingAds}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Author + type -->
                                    <Grid Grid.Row="0"
                                          Margin="0,0,0,6">
                                        <TextBlock Text="{Binding AuthorName}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <Border Background="{StaticResource PrimarySoftBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="9,4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeDisplay}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Description}"
                                               Style="{StaticResource SecondaryText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>

                                    <!-- Footer -->
                                    <Grid Grid.Row="2">
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DateRangeDisplay}"
                                                       Style="{StaticResource SecondaryText}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>

                                            <Border Background="{StaticResource PrimarySoftBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,3"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CategoryDisplay}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource PrimaryBrush}"
                                                           FontWeight="SemiBold"/>
                                            </Border>

                                            <Border Background="{StaticResource SurfaceSoftBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OverlapDisplay}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>

                                        <Button Content="View Slots →"
                                                Style="{StaticResource OutlineButton}"
                                                HorizontalAlignment="Right"
                                                Tag="{Binding}"
                                                Click="ViewSlotsButton_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Grid Grid.Row="6"
              Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="← Back to Notice Board"
                    Style="{StaticResource OutlineButtonLarge}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,8,0"
                    Click="BackButton_Click"/>

            <Button Grid.Column="1"
                    Content="Done"
                    Style="{StaticResource PrimaryButtonLarge}"
                    HorizontalAlignment="Stretch"
                    Margin="8,0,0,0"
                    Click="BackButton_Click"/>
        </Grid>

        <controls:MenuPanel Grid.Row="0"
                            Grid.RowSpan="7"
                            x:Name="AppMenu"/>
    </Grid>
</Page>