<Page x:Class="CommunityHub.Ui.Views.TenantViews.NoticeBoardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:CommunityHub.Ui.Controls"
      mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="{StaticResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="☰  Menu"
                        Style="{StaticResource GhostWhiteButton}"
                        Margin="0,0,10,0"
                        Click="MenuButton_Click"/>

                <Button Grid.Column="2"
                        Content="Demo"
                        Style="{StaticResource GhostWhiteOutlinedButton}"
                        IsEnabled="False"
                        Margin="0,0,10,0"/>

                <TextBlock Grid.Column="3"
                           x:Name="UserNameTextBlock"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="15"
                           Margin="0,0,8,0"/>

                <TextBlock Grid.Column="4"
                           Text="👤"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="17"/>
            </Grid>
        </Border>

        <!-- Success banner -->
        <Border x:Name="SuccessBanner"
                Grid.Row="1"
                Background="{StaticResource SuccessBrush}"
                Padding="12,8"
                Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="SuccessTextBlock"
                           Foreground="{StaticResource SuccessTextBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"/>

                <Button x:Name="RestoreAdButton"
                        Content="Restore"
                        HorizontalAlignment="Right"
                        Style="{StaticResource GhostButton}"
                        Foreground="{StaticResource SuccessTextBrush}"
                        FontWeight="Bold"
                        Visibility="Collapsed"
                        Click="RestoreAdButton_Click"/>
            </Grid>
        </Border>

        <!-- Notifications -->
        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding Notifications.Items}"
                      Margin="16,10,16,0"
                      Visibility="{Binding Notifications.HasItems, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource PrimarySoftBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{StaticResource PrimaryBrush}"/>

                                <TextBlock Text="{Binding Body}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontStyle="Italic"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>

                                <TextBlock Text="{Binding TimeDisplay}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0"
                                        Content="✕"
                                        Tag="{Binding Id}"
                                        Style="{StaticResource GhostButton}"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        VerticalAlignment="Top"
                                        Click="DismissNotificationButton_Click"/>

                                <Button Grid.Row="1"
                                        Content="View Ad →"
                                        Style="{StaticResource GhostButton}"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Right"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        FontWeight="SemiBold"
                                        Click="ViewSlotsFromNotificationButton_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Title row -->
        <Grid Grid.Row="3" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Notice Board"
                   Style="{StaticResource PageTitle}"/>

                <TextBlock Text="{Binding BuildingSubtitle}"
                   Style="{StaticResource SecondaryText}"
                   Margin="0,2,0,0"/>
            </StackPanel>

            <Border x:Name="ExportSuccessBanner"
            Grid.Column="1"
            Background="{StaticResource SuccessBrush}"
            BorderBrush="{StaticResource SuccessTextBrush}"
            BorderThickness="1"
            Padding="10,6"
            Margin="16,0,16,0"
            VerticalAlignment="Center"
            Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="ExportSuccessTextBlock"
                       Foreground="{StaticResource SuccessTextBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,28,0"/>

                    <Button Content="✕"
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource GhostButton}"
                    Foreground="{StaticResource SuccessTextBrush}"
                    Click="DismissExportSuccessButton_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
                <Button Content="Export PDF"
                Style="{StaticResource OutlineButton}"
                Margin="0,0,8,0"
                Click="ExportPdfButton_Click"/>

                <Button Content="+ New Ad"
                Style="{StaticResource PrimaryButton}"
                Click="NewAdButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="16,8,16,8">
            <TextBlock Text="Type:"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <Button x:Name="FilterAllButton"
                    Content="{Binding Filters.AllFilterText}"
                    Style="{StaticResource FilterChipButton}"
                    Margin="0,0,6,0"
                    Click="FilterTypeButton_Click"
                    Tag="All"/>

            <Button x:Name="FilterOfferingButton"
                    Content="{Binding Filters.OfferingFilterText}"
                    Style="{StaticResource FilterChipButton}"
                    Margin="0,0,6,0"
                    Click="FilterTypeButton_Click"
                    Tag="Offering"/>

            <Button x:Name="FilterSeekingButton"
                    Content="{Binding Filters.SeekingFilterText}"
                    Style="{StaticResource FilterChipButton}"
                    Margin="0,0,16,0"
                    Click="FilterTypeButton_Click"
                    Tag="Seeking"/>

            <TextBlock Text="Category:"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <ComboBox x:Name="CategoryComboBox"
                      Width="160"
                      SelectionChanged="CategoryComboBox_SelectionChanged"/>
        </StackPanel>

        <!-- Results count -->
        <TextBlock Grid.Row="5"
                   Text="{Binding ResultsCountText}"
                   Style="{StaticResource SecondaryText}"
                   Margin="16,0,16,10"/>

        <!-- Ad list -->
        <ScrollViewer Grid.Row="6"
                      VerticalScrollBarVisibility="Auto"
                      Margin="16,0,16,16">
            <ItemsControl ItemsSource="{Binding FilteredAds}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Author + badges -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding AuthorName}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Border Visibility="{Binding ArchiveButtonVisible}"
                                                Background="{StaticResource SurfaceSoftBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="your ad"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontWeight="SemiBold"/>
                                        </Border>

                                        <Border Background="{StaticResource PrimarySoftBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="9,4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeDisplay}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Description -->
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Description}"
                                           Style="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <!-- Footer -->
                                <Grid Grid.Row="2">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Border Background="{StaticResource PrimarySoftBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryDisplay}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       FontWeight="SemiBold"/>
                                        </Border>

                                        <TextBlock Text="{Binding DateRangeDisplay}"
                                                   Style="{StaticResource SecondaryText}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Button Content="{Binding ViewDetailsDisplay}"
                                                Style="{StaticResource GhostButton}"
                                                Foreground="{StaticResource PrimaryBrush}"
                                                FontWeight="SemiBold"
                                                Visibility="{Binding ViewDetailsVisible}"
                                                Tag="{Binding}"
                                                Margin="0,0,8,0"
                                                Click="ViewDetailsButton_Click"/>

                                        <Button Content="Archive"
                                                Style="{StaticResource DangerButton}"
                                                Visibility="{Binding ArchiveButtonVisible}"
                                                Tag="{Binding}"
                                                Margin="0,0,8,0"
                                                Click="ArchiveButton_Click"/>

                                        <Button Content="View Slots"
                                                Style="{StaticResource OutlineButton}"
                                                Visibility="{Binding ViewSlotsVisible}"
                                                Tag="{Binding}"
                                                Click="ViewSlotsButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <controls:MenuPanel Grid.Row="0"
                            Grid.RowSpan="7"
                            x:Name="AppMenu"/>
    </Grid>
</Page>