<Page x:Class="CommunityHub.Ui.Views.TenantViews.BuildingDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Building Details">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="☰ Menu"
                        Padding="10,6" Margin="0,0,10,0"
                        FontSize="13" Foreground="White" Background="Transparent"/>
                <TextBlock Grid.Column="2" x:Name="UserNameTextBlock"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="13"
                           Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="👤"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="15"/>
            </Grid>
        </Border>

        <!-- Header sa back dugmetom -->
        <Border Grid.Row="1" Background="#1a252f" Padding="10,8">
            <Grid>
                <Button HorizontalAlignment="Left"
                        Content="← Browse Buildings"
                        Foreground="White" Background="Transparent"
                        FontSize="13" Padding="10,6"
                        VerticalAlignment="Center"
                        Click="BackButton_Click"/>
                <TextBlock Text="Building details"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <!-- Slider za slike -->
        <Grid Grid.Row="2" Background="#CCCCCC">
            <Image x:Name="BuildingImage" Stretch="UniformToFill"/>

            <!-- Baner kao overlay na vrhu slike -->
            <Border x:Name="SuccessBanner"
                    Background="#DFF0D8" Padding="12,8"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="SuccessTextBlock" Foreground="#3C763D" FontSize="13"
                   VerticalAlignment="Center"/>
                    <Button x:Name="ViewRequestsButton" Content="View Requests →"
                            HorizontalAlignment="Right"
                            Margin="0,0,30,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#3C763D" FontWeight="Bold"
                            Visibility="Collapsed"
                            Click="ViewRequestsButton_Click"/>
                </Grid>
            </Border>

            <Button Content="❮" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Margin="10,0"
                    Padding="8" Width="36" Height="36"
                    Click="PrevImageButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="White" CornerRadius="18" Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="❯" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="10,0"
                    Padding="8" Width="36" Height="36"
                    Click="NextImageButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="White" CornerRadius="18" Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock x:Name="ImageCounterText"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,10,10,0" Foreground="White"
                       Background="#88000000" Padding="6,3"/>

            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock x:Name="SwipeText" Text="← swipe to browse photos →"
                           Foreground="White" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <ItemsControl x:Name="ImageDots" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="8" Height="8" Margin="3,0" Fill="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- Adresa -->
        <StackPanel Grid.Row="3" Margin="16,16,16,8">
            <TextBlock x:Name="AddressText" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="NeighborhoodText" FontSize="14" Margin="0,4,0,0"/>
            <TextBlock x:Name="CityCountryText" FontSize="14" Foreground="Gray"/>
        </StackPanel>

        <!-- Building Info label + kartice -->
        <StackPanel Grid.Row="4" Margin="16,8">
            <TextBlock Text="BUILDING INFO" FontSize="11" Foreground="Gray"
                       FontWeight="SemiBold" Margin="0,0,0,8"/>
            <UniformGrid Rows="1">
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="4" Padding="12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="FloorsText" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Floors" FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="4" Padding="12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TotalUnitsText" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Total units" FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="4" Padding="12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="VacanciesText" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Vacancies" FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Margin="4" Padding="12">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="PendingRequestsText" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Pending requests" FontSize="12" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- Request Access dugme -->
        <Border Grid.Row="5" VerticalAlignment="Bottom" Margin="16,8,16,16">
            <Button Content="Request Access →"
                    Padding="16,12"
                    FontSize="15" FontWeight="Bold"
                    HorizontalAlignment="Stretch"
                    Click="RequestAccessButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="White" BorderBrush="#CCCCCC"
                                BorderThickness="1" CornerRadius="8" Padding="16,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
    </Grid>
</Page>