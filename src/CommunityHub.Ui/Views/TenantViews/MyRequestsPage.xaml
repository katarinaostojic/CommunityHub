<Page x:Class="CommunityHub.Ui.Views.TenantViews.MyRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="My Requests">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="☰ Menu"
                        Padding="10,6" Margin="0,0,10,0"
                        FontSize="13" Foreground="White" Background="Transparent"/>

                <TextBlock Grid.Column="4" x:Name="UserNameTextBlock"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="13"
                           Margin="0,0,8,0"/>

                <TextBlock Grid.Column="5" Text="👤"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="15"/>
            </Grid>
        </Border>

        <!-- Success banner -->
        <Border x:Name="SuccessBanner" Grid.Row="1"
                Background="#DFF0D8" Padding="12,8"
                Visibility="Collapsed">
            <TextBlock x:Name="SuccessTextBlock"
                       Foreground="#3C763D" FontSize="13"/>
        </Border>

        <!-- Title i sort -->
        <Grid Grid.Row="2" Margin="16,12,16,8">
            <TextBlock Text="My Requests" FontSize="20" FontWeight="Bold"
                       TextDecorations="Underline" VerticalAlignment="Center"/>
            <Button x:Name="SortButton" Content="Sort by Date ↓"
                    HorizontalAlignment="Right"
                    Padding="12,6" FontSize="13"
                    Click="SortButton_Click"/>
        </Grid>

        <!-- Filteri po statusu -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="16,0,16,8">
            <TextBlock Text="Filters:" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="FilterAllButton" Content="All"
                    Padding="12,6" Margin="0,0,6,0" FontSize="13"
                    Click="FilterAllButton_Click"/>
            <Button x:Name="FilterPendingButton" Content="Pending approval"
                    Padding="12,6" Margin="0,0,6,0" FontSize="13"
                    Click="FilterPendingButton_Click"/>
            <Button x:Name="FilterAcceptedButton" Content="Accepted"
                    Padding="12,6" Margin="0,0,6,0" FontSize="13"
                    Click="FilterAcceptedButton_Click"/>
            <Button x:Name="FilterRejectedButton" Content="Rejected"
                    Padding="12,6" FontSize="13"
                    Click="FilterRejectedButton_Click"/>
        </StackPanel>

        <!-- Showing X results -->
        <TextBlock Grid.Row="4" x:Name="ResultsCountText"
           FontSize="12" Foreground="Gray" Margin="16,0,16,8"/>

        <!-- Lista zahteva -->
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="16,0,16,16">
            <ItemsControl x:Name="RequestsPanel">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#CCCCCC" BorderThickness="1"
                                CornerRadius="6" Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Status badge -->
                                <Border Grid.Row="0" HorizontalAlignment="Right"
                                        BorderBrush="#CCCCCC" BorderThickness="1,1,1,1"
                                        CornerRadius="4" Padding="8,4"
                                        Background="Transparent">
                                    <TextBlock Text="{Binding StatusDisplay}"
                                               FontSize="12"/>
                                </Border>

                                <!-- Adresa -->
                                <TextBlock Grid.Row="0" FontSize="15" FontWeight="Bold"
                                           Text="{Binding Building.Street}"/>

                                <!-- Naselje -->
                                <TextBlock Grid.Row="1" FontSize="13" Margin="0,2,0,0"
                                           Text="{Binding Building.Neighborhood}"/>

                                <!-- Grad, Drzava -->
                                <TextBlock Grid.Row="2" FontSize="13" Margin="0,2,0,8">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}, {1}">
                                            <Binding Path="Building.City.Name"/>
                                            <Binding Path="Building.City.Country.Name"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <!-- Unit i datum -->
                                <Grid Grid.Row="3" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Unit:" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Text="{Binding UnitNumber}" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Submission Date:" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" FontSize="13"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Rejection reason -->
                                <TextBlock Grid.Row="4" x:Name="RejectionReasonText"
                                           Text="{Binding RejectionReasonDisplay}"
                                           FontSize="12" Foreground="Gray" FontStyle="Italic"
                                           Margin="0,0,0,6"
                                           Visibility="{Binding RejectionReasonVisible, Converter={StaticResource BoolToVis}}"/>

                                <!-- Akcije -->
                                <Grid Grid.Row="5">
                                    <Button Content="Cancel request"
                                        Padding="10,6" FontSize="13"
                                        HorizontalAlignment="Right"
                                        Tag="{Binding}"
                                        Visibility="{Binding CancelButtonVisible, Converter={StaticResource BoolToVis}}"
                                        Click="CancelRequestButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>