<Page x:Class="CommunityHub.Ui.Views.TenantViews.MyRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:CommunityHub.Ui.Controls"
      mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="☰  Menu"
                        Style="{StaticResource GhostWhiteButton}"
                        Margin="0,0,10,0"
                        Click="MenuButton_Click"/>

                <TextBlock Grid.Column="4" x:Name="UserNameTextBlock"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="15"
                           Margin="0,0,8,0"/>

                <TextBlock Grid.Column="5" Text="👤"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="17"/>
            </Grid>
        </Border>

        <!-- Success banner -->
        <Border x:Name="SuccessBanner" Grid.Row="1"
                Background="{StaticResource SuccessBrush}" Padding="12,8"
                Visibility="Collapsed">
            <TextBlock x:Name="SuccessTextBlock"
                       Foreground="{StaticResource SuccessTextBrush}" FontSize="13"/>
        </Border>

        <!-- Title i sort -->
        <Grid Grid.Row="2" Margin="16,12,16,8">
            <TextBlock Text="My Requests"
                       Style="{StaticResource PageTitle}"
                       TextDecorations="Underline"
                       VerticalAlignment="Center"/>
            <Button x:Name="SortButton" Content="Sort by Date ↓"
                    Style="{StaticResource OutlineButton}"
                    HorizontalAlignment="Right"
                    Click="SortButton_Click"/>
        </Grid>

        <!-- Filteri po statusu -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="16,0,16,8">
            <TextBlock Text="Filters:" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button x:Name="FilterAllButton" Content="All"
                    Style="{StaticResource FilterChipButton}"
                    Margin="0,0,6,0"
                    Click="FilterAllButton_Click"/>
            <Button x:Name="FilterPendingButton" Content="Pending approval"
                    Style="{StaticResource FilterChipButton}"
                    Margin="0,0,6,0"
                    Click="FilterPendingButton_Click"/>
            <Button x:Name="FilterApprovedButton" Content="Approved"
                    Style="{StaticResource FilterChipButton}"
                    Margin="0,0,6,0"
                    Click="FilterApprovedButton_Click"/>
            <Button x:Name="FilterRejectedButton" Content="Rejected"
                    Style="{StaticResource FilterChipButton}"
                    Click="FilterRejectedButton_Click"/>
        </StackPanel>

        <!-- Showing X results -->
        <TextBlock Grid.Row="4" x:Name="ResultsCountText"
                   Style="{StaticResource SecondaryText}"
                   Margin="16,0,16,8"/>

        <!-- Lista zahteva -->
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="16,0,16,16">
            <ItemsControl x:Name="RequestsPanel">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Status badge -->
                                <Border Grid.Row="0" HorizontalAlignment="Right"
                                        Style="{StaticResource StatusBadge}">
                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="13"/>
                                </Border>

                                <!-- Adresa -->
                                <TextBlock Grid.Row="0" FontSize="15" FontWeight="Bold"
                                           Text="{Binding Building.Street}"/>

                                <!-- Naselje -->
                                <TextBlock Grid.Row="1" FontSize="13" Margin="0,2,0,0"
                                           Text="{Binding Building.Neighborhood}"/>

                                <!-- Grad, Drzava -->
                                <TextBlock Grid.Row="2" Style="{StaticResource SecondaryText}"
                                           Margin="0,2,0,8">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}, {1}">
                                            <Binding Path="Building.City.Name"/>
                                            <Binding Path="Building.City.Country.Name"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <!-- Unit i datum -->
                                <Grid Grid.Row="3" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Unit:" Style="{StaticResource SecondaryText}"/>
                                        <TextBlock Text="{Binding UnitNumber}" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Submission Date:" Style="{StaticResource SecondaryText}"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" FontSize="13"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Rejection reason -->
                                <TextBlock Grid.Row="4"
                                           Text="{Binding RejectionReasonDisplay}"
                                           Style="{StaticResource SecondaryText}"
                                           FontStyle="Italic"
                                           Margin="0,0,0,6"
                                           Visibility="{Binding RejectionReasonVisible, Converter={StaticResource BoolToVis}}"/>

                                <!-- Akcije -->
                                <Grid Grid.Row="5">
                                    <Button Content="Cancel request"
                                            Style="{StaticResource DangerButton}"
                                            HorizontalAlignment="Right"
                                            Tag="{Binding}"
                                            Visibility="{Binding CancelButtonVisible, Converter={StaticResource BoolToVis}}"
                                            Click="CancelRequestButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <controls:MenuPanel Grid.Row="0" Grid.RowSpan="6" x:Name="AppMenu"/>
    </Grid>
</Page>