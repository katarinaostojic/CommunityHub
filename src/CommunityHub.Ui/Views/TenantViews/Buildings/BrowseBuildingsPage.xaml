<Page x:Class="CommunityHub.Ui.Views.TenantViews.BrowseBuildingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Converters"
      xmlns:controls="clr-namespace:CommunityHub.Ui.Controls"
      mc:Ignorable="d">

    <Page.Resources>
        <converters:ImagePathConverter x:Key="ImageConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="☰  Menu"
                        Style="{StaticResource GhostWhiteButton}"
                        Margin="0,0,10,0"
                        Click="MenuButton_Click"/>

                <Grid Grid.Column="1" Margin="0,0,8,0">
                    <TextBox x:Name="SearchTextBox"
                         Padding="8,6" FontSize="13"
                         TextChanged="SearchTextBox_TextChanged"/>
                    <TextBlock Text="Search address..."
                           Foreground="Gray" FontSize="13"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="2" Content="Reset All"
                        Style="{StaticResource OutlineButton}"
                        Margin="0,0,8,0"
                        Click="ResetButton_Click"/>

                <Button Grid.Column="3" Content="Filter  ▼"
                        Style="{StaticResource OutlineButton}"
                        Margin="0,0,8,0"
                        Click="FilterButton_Click"/>

                <TextBlock Grid.Column="4" x:Name="UserNameTextBlock"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="15"
                           Margin="0,0,8,0"/>

                <TextBlock Grid.Column="5" Text="👤"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="17"/>
            </Grid>
        </Border>

        <!-- Success banner -->
        <Border x:Name="SuccessBanner" Grid.Row="1"
                Background="{StaticResource SuccessBrush}" Padding="12,8"
                Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="SuccessTextBlock"
                           Foreground="{StaticResource SuccessTextBrush}" FontSize="13"
                           VerticalAlignment="Center"/>
                <Button x:Name="ViewRequestsButton" Content="View Requests →"
                        HorizontalAlignment="Right"
                        Style="{StaticResource GhostButton}"
                        Foreground="{StaticResource SuccessTextBrush}"
                        FontWeight="Bold"
                        Visibility="Collapsed"
                        Click="ViewRequestsButton_Click"/>
            </Grid>
        </Border>

        <!-- Title row -->
        <Grid Grid.Row="2" Margin="16,12,16,8">
            <TextBlock Text="Browse Buildings"
                       Style="{StaticResource PageTitle}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Building list -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding CurrentPageBuildings}" Margin="16,0,16,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}"
                            Cursor="Hand"
                            Tag="{Binding}"
                            MouseLeftButtonDown="BuildingCard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Slika -->
                            <Border Grid.Column="0" Width="210"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource BackgroundLightBrush}"
                                    VerticalAlignment="Stretch">
                                <Image Source="{Binding ImagePaths, Converter={StaticResource ImageConverter}}"
                                       Stretch="UniformToFill"
                                       MaxHeight="160"/>
                            </Border>

                            <!-- Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,4">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}, {2}">
                                            <Binding Path="Street"/>
                                            <Binding Path="StreetNumber"/>
                                            <Binding Path="Neighborhood"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,4">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="📍 {0}, {1}">
                                            <Binding Path="CityName"/>
                                            <Binding Path="CountryName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,4"
                                           Text="{Binding NumberOfFloors, StringFormat='Number of floors: {0}'}"/>
                                <TextBlock Style="{StaticResource SecondaryText}"
                                           Text="{Binding TotalUnits, StringFormat='Total units: {0}'}"/>
                            </StackPanel>

                            <!-- Desna strana -->
                            <Grid Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="›" FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Button Content="Request Access"
                                        Style="{StaticResource OutlineButton}"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Right"
                                        Tag="{Binding}"
                                        Click="RequestAccessButton_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Pagination -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button Content="&lt;" Style="{StaticResource OutlineButton}"
                    Margin="0,0,4,0"
                    IsEnabled="{Binding HasPreviousPage}"
                    Click="PageButton_Click"
                    Tag="Previous"/>
            <TextBlock Text="{Binding PageLabelText}"
                       VerticalAlignment="Center" Margin="8,0" FontSize="13"/>
            <Button Content="&gt;" Style="{StaticResource OutlineButton}"
                    Margin="4,0,0,0"
                    IsEnabled="{Binding HasNextPage}"
                    Click="PageButton_Click"
                    Tag="Next"/>
        </StackPanel>

        <!-- Overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="5"
              x:Name="Overlay"
              Background="#66000000"
              Visibility="Collapsed"
              MouseLeftButtonDown="Overlay_MouseLeftButtonDown"/>

        <!-- Filter panel -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                x:Name="FilterPanel"
                Width="300"
                HorizontalAlignment="Left"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="FilterPanelTranslate" X="-300"/>
            </Border.RenderTransform>
            <StackPanel Margin="20">

                <Grid Margin="0,0,0,20">
                    <TextBlock Text="Filter" FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right"
                            Style="{StaticResource GhostButton}"
                            FontSize="16" Click="FilterButton_Click"/>
                </Grid>

                <TextBlock Text="Street Address:" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="FilterStreetTextBox"
                         Padding="8,6" FontSize="13" Margin="0,0,0,16"/>

                <TextBlock Text="Neighborhood:" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="FilterNeighborhoodTextBox"
                         Padding="8,6" FontSize="13" Margin="0,0,0,16"/>

                <TextBlock Text="City:" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="FilterCityTextBox"
                         Padding="8,6" FontSize="13" Margin="0,0,0,16"/>

                <TextBlock Text="Country:" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="FilterCountryTextBox"
                         Padding="8,6" FontSize="13" Margin="0,0,0,24"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Reset Filters"
                            Style="{StaticResource OutlineButton}"
                            Click="ResetButton_Click"/>
                    <Button Grid.Column="2" Content="Apply Filters"
                            Style="{StaticResource PrimaryButton}"
                            Click="ApplyFiltersButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <controls:MenuPanel Grid.Row="0" Grid.RowSpan="5" x:Name="AppMenu"/>
    </Grid>
</Page>