<Page x:Class="CommunityHub.Ui.Views.TenantViews.Buildings.ResidentsMeetingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:CommunityHub.Ui.Controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="{StaticResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="☰  Menu"
                        Style="{StaticResource GhostWhiteButton}"
                        Margin="0,0,10,0"
                        Click="MenuButton_Click"/>

                <TextBlock Grid.Column="2"
                           x:Name="UserNameTextBlock"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="15"
                           Margin="0,0,8,0"/>

                <TextBlock Grid.Column="3"
                           Text="👤"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="17"/>
            </Grid>
        </Border>

        <Border x:Name="SuccessBanner"
                Grid.Row="1"
                Background="{StaticResource SuccessBrush}"
                BorderBrush="{StaticResource SuccessTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="16,10,16,0"
                Visibility="Collapsed">
            <TextBlock x:Name="SuccessTextBlock"
                       Foreground="{StaticResource SuccessTextBrush}"
                       FontSize="13"/>
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="16,16,16,0">
            <TextBlock Text="Residents' Meetings"
                       Style="{StaticResource PageTitle}"
                       Margin="0,0,0,12"/>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Building:"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="1"
                               x:Name="BuildingInfoTextBlock"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Margin="16,12,16,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status:"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <Button Content="{Binding AllButtonLabel}"
                        Style="{StaticResource FilterChipButton}"
                        Margin="0,0,6,0"
                        Click="FilterAllButton_Click"/>

                <Button Content="{Binding ScheduledButtonLabel}"
                        Style="{StaticResource FilterChipButton}"
                        Margin="0,0,6,0"
                        Click="FilterScheduledButton_Click"/>

                <Button Content="{Binding ConfirmedButtonLabel}"
                        Style="{StaticResource FilterChipButton}"
                        Margin="0,0,6,0"
                        Click="FilterConfirmedButton_Click"/>

                <Button Content="{Binding CancelledButtonLabel}"
                        Style="{StaticResource FilterChipButton}"
                        Click="FilterCancelledButton_Click"/>
            </StackPanel>

            <TextBlock Text="{Binding ResultsCountText}"
                       Style="{StaticResource SecondaryText}"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto"
                      Margin="16,0,16,16">
            <ItemsControl ItemsSource="{Binding Meetings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        HorizontalAlignment="Right"
                                        Background="{StaticResource PrimarySoftBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12,5">
                                    <TextBlock Text="{Binding StatusDisplay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </Border>

                                <StackPanel Grid.Row="0"
                                            Margin="0,0,150,0">
                                    <TextBlock Text="{Binding DateDisplay}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>

                                    <TextBlock Text="{Binding TimeDisplay}"
                                               FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Margin="0,16,0,0">
                                    <TextBlock Text="{Binding TopicsCountDisplay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,6"/>

                                    <ItemsControl ItemsSource="{Binding Topics}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0">
                                                    <Run Text="• "/>
                                                    <Run Text="{Binding}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Border Grid.Row="2"
                                        Background="{StaticResource SurfaceSoftBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,10"
                                        Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding AttendanceActionText}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                                            <TextBlock Text="{Binding DeadlineDisplay}"
                                                       Style="{StaticResource SecondaryText}"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding AttendanceDisplay}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Right"/>

                                            <TextBlock Text="{Binding AttendancePercentageDisplay}"
                                                       Style="{StaticResource SecondaryText}"
                                                       FontSize="12"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="3"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,14,0,0">
                                    <Button Content="Confirm Attendance"
                                            Style="{StaticResource PrimaryButton}"
                                            MinWidth="150"
                                            Tag="{Binding}"
                                            Click="AttendButton_Click"
                                            Visibility="{Binding CanAttend, Converter={StaticResource BoolToVis}}"/>

                                    <Button Content="Cancel Attendance"
                                            Style="{StaticResource OutlineButton}"
                                            MinWidth="150"
                                            Tag="{Binding}"
                                            Click="CancelAttendanceButton_Click"
                                            Visibility="{Binding CanCancelAttendance, Converter={StaticResource BoolToVis}}"/>

                                    <Button Content="Suggest Topic"
                                            Style="{StaticResource OutlineButton}"
                                            MinWidth="130"
                                            Margin="8,0,0,0"
                                            Tag="{Binding}"
                                            Click="SuggestTopicButton_Click"
                                            Visibility="{Binding CanSuggestTopic, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <controls:MenuPanel Grid.Row="0"
                            Grid.RowSpan="5"
                            x:Name="AppMenu"/>
    </Grid>
</Page>