<Page x:Class="CommunityHub.Ui.Views.TenantViews.Buildings.ReportedProblemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:CommunityHub.Ui.Controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="{StaticResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0"
        Background="{StaticResource PrimaryBrush}"
        Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                Content="☰  Menu"
                Style="{StaticResource GhostWhiteButton}"
                Margin="0,0,10,0"
                Click="MenuButton_Click"/>

                <controls:NotificationBell Grid.Column="2"
                           x:Name="NotificationBell"
                           Margin="0,0,8,0"/>

                <TextBlock Grid.Column="3"
                   x:Name="UserNameTextBlock"
                   VerticalAlignment="Center"
                   Foreground="White"
                   FontSize="15"
                   Margin="0,0,8,0"/>

                <TextBlock Grid.Column="4"
                   Text="👤"
                   VerticalAlignment="Center"
                   Foreground="White"
                   FontSize="17"/>
            </Grid>
        </Border>

        <Border x:Name="SuccessBanner"
                Grid.Row="1"
                Background="{StaticResource SuccessBrush}"
                BorderBrush="{StaticResource SuccessTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="16,10,16,0"
                Visibility="Collapsed">
            <TextBlock x:Name="SuccessTextBlock"
                       Foreground="{StaticResource SuccessTextBrush}"
                       FontSize="13"/>
        </Border>

        <StackPanel Grid.Row="2" Margin="16,16,16,0">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Reported Problems"
                           Style="{StaticResource PageTitle}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                            Content="+ Report a Problem"
                            Style="{StaticResource OutlineButton}"
                            Click="ReportProblemButton_Click"/>
            </Grid>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Building:"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="1"
                               x:Name="BuildingInfoTextBlock"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="16,12,16,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status:"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <Button Content="{Binding AllButtonLabel}"
                        Style="{StaticResource FilterChipButton}"
                        Margin="0,0,6,0"
                        Click="FilterAllButton_Click"/>

                <Button Content="{Binding UnresolvedButtonLabel}"
                        Style="{StaticResource FilterChipButton}"
                        Margin="0,0,6,0"
                        Click="FilterUnresolvedButton_Click"/>

                <Button Content="{Binding PotentiallySolvedButtonLabel}"
                        Style="{StaticResource FilterChipButton}"
                        Margin="0,0,6,0"
                        Click="FilterPotentiallySolvedButton_Click"/>

                <Button Content="{Binding SolvedButtonLabel}"
                        Style="{StaticResource FilterChipButton}"
                        Click="FilterSolvedButton_Click"/>
            </StackPanel>

            <TextBlock Text="{Binding ResultsCountText}"
                       Style="{StaticResource SecondaryText}"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="4"
                      VerticalScrollBarVisibility="Auto"
                      Margin="16,0,16,16">
            <ItemsControl ItemsSource="{Binding Reports}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        HorizontalAlignment="Right"
                                        Background="{StaticResource PrimarySoftBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,5">
                                    <TextBlock Text="{Binding StatusDisplay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </Border>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding Description}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,160,0"/>

                                <Grid Grid.Row="1"
                                      Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Priority:"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                                        <Border Background="{StaticResource SurfaceSoftBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12,5"
                                                MinWidth="90"
                                                Margin="0,5,0,0">
                                            <TextBlock Text="{Binding PriorityDisplay}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Reported:"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                                        <TextBlock Text="{Binding ReportedDateDisplay}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="2"
                                        Background="{StaticResource SurfaceSoftBrush}"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,10"
                                        Margin="0,14,0,0"
                                        Visibility="{Binding CanConfirmResolved, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Administrator marked this as resolved"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                                            <TextBlock Text="Is this problem solved to your satisfaction?"
                                                       Style="{StaticResource SecondaryText}"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="✓ Confirm resolved"
                                                Style="{StaticResource OutlineButton}"
                                                VerticalAlignment="Center"
                                                Tag="{Binding}"
                                                Click="ConfirmResolvedButton_Click"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <controls:MenuPanel Grid.Row="0"
                            Grid.RowSpan="5"
                            x:Name="AppMenu"/>
    </Grid>
</Page>