<Page x:Class="CommunityHub.Ui.Views.TenantViews.Buildings.MyCommonRoomRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:CommunityHub.Ui.Controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="{StaticResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0"
        Background="{StaticResource PrimaryBrush}"
        Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                Content="☰  Menu"
                Style="{StaticResource GhostWhiteButton}"
                Margin="0,0,10,0"
                Click="MenuButton_Click"/>

                <controls:NotificationBell Grid.Column="2"
                           x:Name="NotificationBell"
                           Margin="0,0,8,0"/>

                <TextBlock Grid.Column="3"
                   x:Name="UserNameTextBlock"
                   VerticalAlignment="Center"
                   Foreground="White"
                   FontSize="15"
                   Margin="0,0,8,0"/>

                <TextBlock Grid.Column="4"
                   Text="👤"
                   VerticalAlignment="Center"
                   Foreground="White"
                   FontSize="17"/>
            </Grid>
        </Border>

        <!-- Success banner -->
        <Border x:Name="SuccessBanner"
                Grid.Row="1"
                Background="{StaticResource SuccessBrush}"
                BorderBrush="{StaticResource SuccessTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="16,10,16,0"
                Visibility="Collapsed">
            <TextBlock x:Name="SuccessTextBlock"
                       Foreground="{StaticResource SuccessTextBrush}"
                       FontSize="13"/>
        </Border>

        <!-- Tabs + building info -->
        <StackPanel Grid.Row="2" Margin="16,16,16,0">
            <TextBlock Grid.Row="0" x:Name="BuildingInfoTextBlock"
               Style="{StaticResource SecondaryText}"
               Margin="0,0,0,12"
               FontSize="16"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Common Rooms"
                Style="{StaticResource OutlineButton}"
                Margin="0,0,8,0"
                Click="CommonRoomsTab_Click"/>

                <Button Content="My Requests"
                Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </StackPanel>

        <!-- Filters -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="16,12,16,0">
            <TextBlock Text="Filters:"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <Button Content="{Binding AllButtonLabel}"
                    Style="{StaticResource FilterChipButton}"
                    Margin="0,0,6,0"
                    Click="FilterAllButton_Click"/>

            <Button Content="{Binding PendingButtonLabel}"
                    Style="{StaticResource FilterChipButton}"
                    Margin="0,0,6,0"
                    Click="FilterPendingButton_Click"/>

            <Button Content="{Binding DateChangeButtonLabel}"
                    Style="{StaticResource FilterChipButton}"
                    Margin="0,0,6,0"
                    Click="FilterDateChangeButton_Click"/>

            <Button Content="{Binding ApprovedButtonLabel}"
                    Style="{StaticResource FilterChipButton}"
                    Margin="0,0,6,0"
                    Click="FilterApprovedButton_Click"/>

            <Button Content="{Binding RejectedButtonLabel}"
                    Style="{StaticResource FilterChipButton}"
                    Click="FilterRejectedButton_Click"/>
        </StackPanel>

        <!-- Showing X results -->
        <TextBlock Grid.Row="4"
                   Text="{Binding ResultsCountText}"
                   Style="{StaticResource SecondaryText}"
                   Margin="16,8,16,8"/>

        <!-- Request list -->
        <ScrollViewer Grid.Row="5"
                      VerticalScrollBarVisibility="Auto"
                      Margin="16,0,16,16">
            <ItemsControl ItemsSource="{Binding Requests}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Status badge -->
                                <Border Grid.Row="0"
                                        HorizontalAlignment="Right"
                                        Background="{StaticResource PrimarySoftBrush}"
                                        BorderThickness="0"
                                        CornerRadius="8"
                                        Padding="9,4">
                                    <TextBlock Text="{Binding StatusDisplay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </Border>

                                <!-- Room name -->
                                <TextBlock Grid.Row="0"
                                           Text="{Binding CommonRoomName}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                
                                <!-- Approved date -->
                                <Border Grid.Row="2"
                                        Background="{StaticResource SuccessBrush}"
                                        BorderBrush="{StaticResource SuccessTextBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,7"
                                        Margin="0,0,0,8"
                                        Visibility="{Binding ApprovedDateVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ApprovedDateDisplay}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SuccessTextBrush}"/>
                                </Border>

                                <!-- Date change section -->
                                <Border Grid.Row="3"
                                        Background="{StaticResource WarningBrush}"
                                        BorderBrush="{StaticResource WarningTextBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,8"
                                        Visibility="{Binding CanAcceptDateChange, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="ADMINISTRATOR SUGGESTED NEW DATES"
                                                   Foreground="{StaticResource WarningTextBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4"/>

                                        <TextBlock Text="{Binding ProposedDateRangeDisplay}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,0,6"/>

                                        <TextBlock Text="Review and accept or cancel the request"
                                                   Style="{StaticResource SecondaryText}"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Bottom row: request info + actions -->
                                <Grid Grid.Row="4"
                                      Margin="0,30,0,0"
                                      VerticalAlignment="Bottom">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Rental type -->
                                    <StackPanel Grid.Column="0"
                                        VerticalAlignment="Bottom">
                                        <TextBlock Text="Rental type"
                                               Style="{StaticResource SecondaryText}"
                                               FontSize="12"/>

                                        <TextBlock Text="{Binding RentalTypeDisplay}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Requested dates -->
                                    <StackPanel Grid.Column="2"
                                        VerticalAlignment="Bottom">
                                        <TextBlock Text="Requested dates"
                                               Style="{StaticResource SecondaryText}"
                                               FontSize="12"/>

                                        <TextBlock Text="{Binding DateRange}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Accept button -->
                                    <Button Grid.Column="4"
                                                Content="Accept suggestion"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Bottom"
                                                Tag="{Binding}"
                                                Visibility="{Binding CanAcceptDateChange, Converter={StaticResource BoolToVis}}"
                                                Click="AcceptSuggestionButton_Click"/>

                                    <!-- Cancel button -->
                                    <Button Grid.Column="5"
                                                Content="Cancel request"
                                                Style="{StaticResource DangerButton}"
                                                VerticalAlignment="Bottom"
                                                Tag="{Binding}"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                                Click="CancelRequestButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <controls:MenuPanel Grid.Row="0"
                            Grid.RowSpan="6"
                            x:Name="AppMenu"/>
    </Grid>
</Page>
