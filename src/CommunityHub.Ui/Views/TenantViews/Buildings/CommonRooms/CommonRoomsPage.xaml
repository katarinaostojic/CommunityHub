<Page x:Class="CommunityHub.Ui.Views.TenantViews.Buildings.CommonRoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:CommunityHub.Ui.Controls"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="{StaticResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="☰  Menu"
                        Style="{StaticResource GhostWhiteButton}"
                        Margin="0,0,10,0"
                        Click="MenuButton_Click"/>
                <TextBlock Grid.Column="2" x:Name="UserNameTextBlock"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="15"
                           Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="👤"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="17"/>
            </Grid>
        </Border>

        <!-- Success banner -->
        <Border x:Name="SuccessBanner" Grid.Row="1"
                Background="{StaticResource SuccessBrush}"
                BorderBrush="{StaticResource SuccessTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="16,10,16,0"
                Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="SuccessTextBlock"
                           Foreground="{StaticResource SuccessTextBrush}" FontSize="13"
                           VerticalAlignment="Center"/>
                <Button x:Name="ViewRequestsButton" Content="View Requests →"
                        HorizontalAlignment="Right"
                        Style="{StaticResource GhostButton}"
                        Foreground="{StaticResource SuccessTextBrush}"
                        FontWeight="Bold"
                        Click="ViewRequestsButton_Click"/>
            </Grid>
        </Border>

        <!-- Building info + Tabs -->
        <StackPanel Grid.Row="2" Margin="16,16,16,0">
            <TextBlock Grid.Row="0" x:Name="BuildingInfoTextBlock"
                       Style="{StaticResource SecondaryText}"
                       Margin="0,0,0,12"
                       FontSize="16"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Common Rooms"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"/>
                <Button Content="My Requests"
                        Style="{StaticResource OutlineButton}"
                        Click="MyRequestsTab_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Room count -->
        <TextBlock Grid.Row="3"
                   Text="{Binding RoomCountText}"
                   Style="{StaticResource SecondaryText}"
                   Margin="16,12,16,8"/>

        <!-- Lista prostorija -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="16,0,16,16">
            <ItemsControl ItemsSource="{Binding Rooms}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Naziv -->
                                <TextBlock Grid.Row="0" Text="{Binding Name}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                <!-- Opis -->
                                <TextBlock Grid.Row="1" Text="{Binding Description}"
                                           Style="{StaticResource SecondaryText}"
                                           Margin="0,4,0,8"
                                           TextWrapping="Wrap"/>

                                <!-- Floor i rental type -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Background="{StaticResource PrimarySoftBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="9,4">
                                        <TextBlock Text="{Binding FloorDisplay}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>

                                    <Border Background="{StaticResource SurfaceSoftBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="9,4"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{Binding RentalTypeDisplay}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Akcije -->
                                <Grid Grid.Row="3">
                                    <Button Content="Request"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Right"
                                            Tag="{Binding}"
                                            Click="RequestButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <controls:MenuPanel Grid.Row="0" Grid.RowSpan="5" x:Name="AppMenu"/>
    </Grid>
</Page>