<Page x:Class="CommunityHub.Ui.Views.TenantViews.Buildings.CommonRoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:CommunityHub.Ui.Controls"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="☰  Menu"
                        Style="{StaticResource GhostWhiteButton}"
                        Margin="0,0,10,0"
                        Click="MenuButton_Click"/>
                <TextBlock Grid.Column="2" x:Name="UserNameTextBlock"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="15"
                           Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="👤"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="17"/>
            </Grid>
        </Border>

        <!-- Success banner -->
        <Border x:Name="SuccessBanner" Grid.Row="1"
                Background="{StaticResource SuccessBrush}" Padding="12,8"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SuccessTextBlock"
                           Foreground="{StaticResource SuccessTextBrush}" FontSize="13"/>
                <Button x:Name="ViewRequestsButton"
                        Content="View requests"
                        Style="{StaticResource GhostButton}"
                        Margin="12,0,0,0"
                        Click="ViewRequestsButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Building info + Tabs -->
        <StackPanel Grid.Row="2" Margin="16,16,16,0">
            <TextBlock x:Name="BuildingInfoTextBlock"
                       FontSize="16" FontWeight="Bold"
                       Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Common Rooms"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"/>
                <Button Content="My Requests"
                        Style="{StaticResource OutlineButton}"
                        Click="MyRequestsTab_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Room count -->
        <TextBlock Grid.Row="3"
                   Text="{Binding RoomCountText}"
                   Style="{StaticResource SecondaryText}"
                   Margin="16,12,16,8"/>

        <!-- Lista prostorija -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="16,0,16,16">
            <ItemsControl ItemsSource="{Binding Rooms}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Naziv -->
                                <TextBlock Grid.Row="0" Text="{Binding Name}"
                                           FontSize="15" FontWeight="Bold"/>

                                <!-- Opis -->
                                <TextBlock Grid.Row="1" Text="{Binding Description}"
                                           Style="{StaticResource SecondaryText}"
                                           Margin="0,4,0,8"
                                           TextWrapping="Wrap"/>

                                <!-- Floor i rental type -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Style="{StaticResource StatusBadge}">
                                        <TextBlock Text="{Binding FloorDisplay}" FontSize="12"/>
                                    </Border>
                                    <Border Style="{StaticResource StatusBadge}" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding RentalTypeDisplay}" FontSize="12"/>
                                    </Border>
                                </StackPanel>

                                <!-- Akcije -->
                                <Grid Grid.Row="3">
                                    <Button Content="Request"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Right"
                                            Tag="{Binding}"
                                            Click="RequestButton_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Request dialog overlay -->
        <Grid x:Name="RequestOverlay" Grid.Row="0" Grid.RowSpan="5"
              Background="#66000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="8"
                    Padding="32" MaxWidth="500"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Request rental" FontSize="18"
                               FontWeight="Bold" Margin="0,0,0,20"/>

                    <!-- Building info -->
                    <Border BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="16,12" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Building: " FontSize="13"
                                       Style="{StaticResource SecondaryText}"/>
                            <TextBlock x:Name="DialogBuildingInfo"
                                       FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Info o prostoriji -->
                    <Border BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="16,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ROOM"
                                       Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="FLOOR"
                                       Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="RENTAL TYPE"
                                       Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="DialogRoomName"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DialogFloor"
                                       FontSize="13"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="DialogRentalType"
                                       FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Date range -->
                    <TextBlock Text="DATE RANGE *" Style="{StaticResource SecondaryText}"
                               FontSize="11" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0" x:Name="DateFromPicker"
                                    DisplayDateStart="{x:Static sys:DateTime.Today}"/>
                        <TextBlock Grid.Column="1" Text=" - "
                                   VerticalAlignment="Center" Margin="8,0"/>
                        <DatePicker Grid.Column="2" x:Name="DateToPicker"
                                    DisplayDateStart="{x:Static sys:DateTime.Today}"/>
                    </Grid>
                    <TextBlock Text="{Binding DateError}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="13" Margin="0,0,0,12"
                               Visibility="{Binding HasDateError, Converter={StaticResource BoolToVis}}"
                               TextWrapping="Wrap"/>

                    <!-- What happens next -->
                    <Border BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="16,12" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="What happens next?"
                                       FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Style="{StaticResource SecondaryText}"
                                       Text="Your request will be sent to the building administrator. Status will be set to Pending. If your requested dates are not available, the administrator may suggest alternative dates."/>
                        </StackPanel>
                    </Border>

                    <!-- Dugmad -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource OutlineButton}"
                                Margin="0,0,8,0"
                                Click="DialogCancelButton_Click"/>
                        <Button Content="Send request"
                                Style="{StaticResource PrimaryButton}"
                                Click="DialogSendButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <controls:MenuPanel Grid.Row="0" Grid.RowSpan="5" x:Name="AppMenu"/>
    </Grid>
</Page>