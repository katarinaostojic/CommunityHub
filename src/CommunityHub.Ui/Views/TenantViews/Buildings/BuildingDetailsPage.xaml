<Page x:Class="CommunityHub.Ui.Views.TenantViews.BuildingDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:CommunityHub.Ui.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="☰  Menu"
                        Style="{StaticResource GhostWhiteButton}"
                        Margin="0,0,10,0"
                        Click="MenuButton_Click"/>
                <TextBlock Grid.Column="2" x:Name="UserNameTextBlock"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="15"
                           Margin="0,0,8,0"/>
                <TextBlock Grid.Column="3" Text="👤"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="17"/>
            </Grid>
        </Border>

        <!-- Header sa back dugmetom -->
        <Border Grid.Row="1" Background="{StaticResource PrimaryDarkBrush}" Padding="10,8">
            <Grid>
                <Button HorizontalAlignment="Left"
                        Content="← Back"
                        FontSize="16"
                        Style="{StaticResource GhostWhiteButton}"
                        VerticalAlignment="Center"
                        Click="BackButton_Click"/>
                <TextBlock Text="Building details"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <!-- Slider za slike -->
        <Grid Grid.Row="2" Background="{StaticResource BackgroundLightBrush}">
            <Image x:Name="BuildingImage" Stretch="UniformToFill"/>

            <!-- Baner kao overlay na vrhu slike -->
            <Border x:Name="SuccessBanner"
                    Background="{StaticResource SuccessBrush}" Padding="12,8"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="SuccessTextBlock"
                               Foreground="{StaticResource SuccessTextBrush}" FontSize="13"
                               VerticalAlignment="Center"/>
                    <Button x:Name="ViewRequestsButton" Content="View Requests →"
                            HorizontalAlignment="Right"
                            Margin="0,0,30,0"
                            Style="{StaticResource GhostButton}"
                            Foreground="{StaticResource SuccessTextBrush}"
                            FontWeight="Bold"
                            Visibility="Collapsed"
                            Click="ViewRequestsButton_Click"/>
                </Grid>
            </Border>

            <Button Content="❮" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Margin="10,0"
                    Width="36" Height="36"
                    Click="PrevImageButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="White" CornerRadius="18" Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="❯" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="10,0"
                    Width="36" Height="36"
                    Click="NextImageButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="White" CornerRadius="18" Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock Text="{Binding ImageCounterText}"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,10,10,0" Foreground="White"
                       Background="#88000000" Padding="6,3"/>

            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock x:Name="SwipeText" Text="← swipe to browse photos →"
                           Foreground="White" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding ImageDotColors}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="8" Height="8" Margin="3,0" Fill="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- Adresa -->
        <StackPanel Grid.Row="3" Margin="16,16,16,8">
            <TextBlock Text="{Binding BuildingDto.FullAddress}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding BuildingDto.Neighborhood}" FontSize="14" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding BuildingDto.Location}" Style="{StaticResource SecondaryText}"/>
        </StackPanel>

        <!-- Building Info label + kartice -->
        <StackPanel Grid.Row="4" Margin="16,8">
            <TextBlock Text="BUILDING INFO" Style="{StaticResource SectionTitle}"
                       Margin="0,0,0,8"/>
            <UniformGrid Rows="1">
                <Border Style="{StaticResource CardBorder}" Margin="4">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding BuildingDto.NumberOfFloors}" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Floors" Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="4">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding BuildingDto.TotalUnits}" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Total units" Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="4">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding BuildingDto.VacancyCount}" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Vacancies" Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="4">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PendingRequestsCount}" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Pending requests" Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- Request Access dugme -->
        <Border Grid.Row="5" Margin="16,8,16,16">
            <Button Content="Request Access →"
                Style="{StaticResource OutlineButton}"
                Padding="20,16"
                FontSize="15" FontWeight="Bold"
                HorizontalAlignment="Stretch"
                Click="RequestAccessButton_Click"/>
        </Border>

        <controls:MenuPanel Grid.Row="0" Grid.RowSpan="6" x:Name="AppMenu"/>
    </Grid>
</Page>