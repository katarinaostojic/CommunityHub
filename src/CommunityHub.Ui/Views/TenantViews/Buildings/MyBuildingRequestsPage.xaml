<Page x:Class="CommunityHub.Ui.Views.TenantViews.MyBuildingRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:CommunityHub.Ui.Controls"
      mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Background="{StaticResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0"
        Background="{StaticResource PrimaryBrush}"
        Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                Content="☰  Menu"
                Style="{StaticResource GhostWhiteButton}"
                Margin="0,0,10,0"
                Click="MenuButton_Click"/>

                <controls:NotificationBell Grid.Column="2"
                           x:Name="NotificationBell"
                           Margin="0,0,8,0"/>

                <TextBlock Grid.Column="3"
                   x:Name="UserNameTextBlock"
                   VerticalAlignment="Center"
                   Foreground="White"
                   FontSize="15"
                   Margin="0,0,8,0"/>

                <TextBlock Grid.Column="4"
                   Text="👤"
                   VerticalAlignment="Center"
                   Foreground="White"
                   FontSize="17"/>
            </Grid>
        </Border>

        <!-- Success banner -->
        <Border x:Name="SuccessBanner"
                Grid.Row="1"
                Background="{StaticResource SuccessBrush}"
                BorderBrush="{StaticResource SuccessTextBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="16,10,16,0"
                Visibility="Collapsed">
            <TextBlock x:Name="SuccessTextBlock"
                       Foreground="{StaticResource SuccessTextBrush}"
                       FontSize="13"/>
        </Border>

        <!-- Title and sort -->
        <Grid Grid.Row="2"
              Margin="16,12,16,8">
            <TextBlock Text="My Requests"
                       Style="{StaticResource PageTitle}"
                       VerticalAlignment="Center"/>

            <Button x:Name="SortButton"
                    Content="{Binding SortButtonLabel}"
                    Style="{StaticResource OutlineButton}"
                    HorizontalAlignment="Right"
                    Click="SortButton_Click"/>
        </Grid>

        <!-- Filters -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="16,0,16,8">
            <TextBlock Text="Filters:"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <Button x:Name="FilterAllButton"
                    Content="{Binding AllButtonLabel}"
                    Style="{StaticResource FilterChipButton}"
                    Margin="0,0,6,0"
                    Click="FilterAllButton_Click"/>

            <Button x:Name="FilterPendingButton"
                    Content="{Binding PendingButtonLabel}"
                    Style="{StaticResource FilterChipButton}"
                    Margin="0,0,6,0"
                    Click="FilterPendingButton_Click"/>

            <Button x:Name="FilterApprovedButton"
                    Content="{Binding ApprovedButtonLabel}"
                    Style="{StaticResource FilterChipButton}"
                    Margin="0,0,6,0"
                    Click="FilterApprovedButton_Click"/>

            <Button x:Name="FilterRejectedButton"
                    Content="{Binding RejectedButtonLabel}"
                    Style="{StaticResource FilterChipButton}"
                    Click="FilterRejectedButton_Click"/>
        </StackPanel>

        <!-- Showing X results -->
        <TextBlock Grid.Row="4"
                   Text="{Binding ResultsCountText}"
                   Style="{StaticResource SecondaryText}"
                   Margin="16,0,16,8"/>

        <!-- Request list -->
        <ScrollViewer Grid.Row="5"
                      VerticalScrollBarVisibility="Auto"
                      Margin="16,0,16,16">
            <ItemsControl ItemsSource="{Binding Requests}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left main info -->
                                <StackPanel Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,20,0">
                                    <TextBlock FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="{Binding BuildingAddress}"/>

                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Margin="0,8,0,0"
                                               Text="{Binding BuildingNeighborhood}"/>

                                    <TextBlock Style="{StaticResource SecondaryText}"
                                               Margin="0,2,0,0"
                                               Text="{Binding BuildingLocation}"/>
                                </StackPanel>

                                <!-- Status badge -->
                                <Border Grid.Row="0"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource PrimarySoftBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,7">
                                    <TextBlock Text="{Binding StatusDisplay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </Border>

                                <!-- Unit, date and action in the same row -->
                                <Grid Grid.Row="1"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{StaticResource SurfaceSoftBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,9"
                                            MinWidth="68">
                                        <StackPanel>
                                            <TextBlock Text="Unit"
                                                       Style="{StaticResource SecondaryText}"
                                                       FontSize="12"/>

                                            <TextBlock Text="{Binding UnitNumber}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Background="{StaticResource SurfaceSoftBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,9"
                                            MinWidth="150">
                                        <StackPanel>
                                            <TextBlock Text="Submission date"
                                                       Style="{StaticResource SecondaryText}"
                                                       FontSize="12"/>

                                            <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Button Grid.Column="4"
                                            Content="Cancel request"
                                            Style="{StaticResource DangerButton}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            MinWidth="150"
                                            Height="44"
                                            Tag="{Binding}"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                            Click="CancelRequestButton_Click"/>
                                </Grid>

                                <!-- Rejection reason -->
                                <Border Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Background="{StaticResource AccentSoftBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,7"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding RejectionReasonVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding RejectionReasonDisplay}"
                                               Foreground="{StaticResource SecondaryBrush}"
                                               FontStyle="Italic"
                                               FontSize="13"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <controls:MenuPanel Grid.Row="0"
                            Grid.RowSpan="6"
                            x:Name="AppMenu"/>
    </Grid>
</Page>