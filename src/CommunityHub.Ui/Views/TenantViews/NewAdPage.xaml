<Page x:Class="CommunityHub.Ui.Views.TenantViews.NewAdPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:CommunityHub.Ui.Controls"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="☰  Menu"
                        Style="{StaticResource GhostWhiteButton}"
                        Margin="0,0,10,0"
                        Click="MenuButton_Click"/>

                <TextBlock Grid.Column="2" x:Name="UserNameTextBlock"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="15"
                           Margin="0,0,8,0"/>

                <TextBlock Grid.Column="3" Text="👤"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="17"/>
            </Grid>
        </Border>

        <!-- Title row -->
        <Grid Grid.Row="1" Margin="16,12,16,8">
            <Button Content="← Go back"
                    Style="{StaticResource OutlineButton}"
                    HorizontalAlignment="Left"
                    Click="GoBackButton_Click"/>
            <TextBlock Text="New Advertisement"
                       Style="{StaticResource PageTitle}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Form -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16,0,16,0">
            <StackPanel>

                <!-- Building -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="16,12" Margin="0,10,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Building:" FontSize="16" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="BuildingSubtitle" FontSize="16"
                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Offering / Seeking toggle -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button x:Name="OfferingButton" Content="↑ Offering help"
                            Style="{StaticResource FilterChipButtonActive}"
                            Margin="0,0,20,0"
                            Padding="20,10,20,10"
                            Click="OfferingButton_Click"
                            FontSize="15"/>
                    <Button x:Name="SeekingButton" Content="↓ Seeking help"
                            Style="{StaticResource FilterChipButton}"
                            Padding="20,10,20,10"
                            Click="SeekingButton_Click"
                            FontSize="15"/>
                </StackPanel>

                <!-- Description -->
                <TextBlock Text="DESCRIPTION *" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <TextBox x:Name="DescriptionTextBox"
                         Padding="10,8" FontSize="13"
                         Height="95"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,15"/>

                <!-- Category -->
                <TextBlock Text="CATEGORY *" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <!-- Category -->
                <ComboBox x:Name="CategoryComboBox"
                      Width="475"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,20"
                      FontSize="16"
                      SelectionChanged="CategoryComboBox_SelectionChanged"/>

                <!-- Date range -->
                <TextBlock Text="DATE RANGE *" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker Grid.Column="0" x:Name="DateFromPicker" FontSize="16"
                                Padding="10, 5, 5, 5"/>
                    <TextBlock Grid.Column="1" Text=" – " FontSize="13"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <DatePicker Grid.Column="2" x:Name="DateToPicker" FontSize="16"
                                Padding="10, 5, 5, 5"/>
                </Grid>
                <!-- Validation error -->
                <TextBlock x:Name="ValidationErrorText"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="13" Margin="0,0,0,15"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"/>

                <!-- Slot info -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12,10" Margin="0,3,0,16">
                    <StackPanel>
                        <TextBlock Text="How time slots work"
                                   FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" FontSize="14"
                                   Text="For each day in the selected date range, the system will automatically create hourly time slots from 16:00 to 20:00. Other tenants will be able to book these slots."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Grid Grid.Row="3" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel  ✕"
                    Style="{StaticResource OutlineButton}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,8,0"
                    FontSize="18"
                    Click="GoBackButton_Click"/>
            <Button Grid.Column="1" Content="Post Ad  →"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Stretch"
                    Margin="8,0,0,0"
                    FontSize="18"
                    Click="PostAdButton_Click"/>
        </Grid>

        <controls:MenuPanel Grid.Row="0" Grid.RowSpan="4" x:Name="AppMenu"/>
    </Grid>
</Page>