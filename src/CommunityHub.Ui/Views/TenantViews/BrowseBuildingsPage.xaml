<Page x:Class="CommunityHub.Ui.Views.BrowseBuildingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:CommunityHub.Ui.Views"
      mc:Ignorable="d"
      Title="Browse Buildings">

    <Page.Resources>
        <local:FirstImagePathConverter x:Key="FirstImageConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="☰ Menu"
                        Padding="10,6" Margin="0,0,10,0"
                        FontSize="13" Foreground="White" Background="Transparent"/>

                <TextBox Grid.Column="1" x:Name="SearchTextBox"
                         Padding="8,6" FontSize="13" Margin="0,0,8,0"
                         TextChanged="SearchTextBox_TextChanged"/>

                <Button Grid.Column="2" Content="Reset All"
                        Click="ResetButton_Click"
                        Padding="10,6" Margin="0,0,8,0" FontSize="13"/>

                <Button Grid.Column="3" Content="▼ Filter"
                        Click="FilterButton_Click"
                        Padding="10,6" Margin="0,0,8,0" FontSize="13"/>

                <TextBlock Grid.Column="4" Text="Gorana"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="13"
                           Margin="0,0,8,0"/>

                <TextBlock Grid.Column="5" Text="👤"
                           VerticalAlignment="Center"
                           Foreground="White" FontSize="15"/>
            </Grid>
        </Border>

        <!-- Title row -->
        <Grid Grid.Row="1" Margin="16,12,16,8">
            <TextBlock Text="Browse Buildings"
                       FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button Content="📍 Near me"
                    HorizontalAlignment="Right"
                    Padding="12,6" FontSize="13"/>
        </Grid>

        <!-- Building list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16,0,16,0">
            <ItemsControl x:Name="BuildingsPanel">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1"
                                CornerRadius="6" Margin="0,0,0,10" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Slika -->
                                <Border Grid.Column="0" Width="170" Height="120"
                                        BorderBrush="Gray" BorderThickness="1"
                                        Margin="0,0,10,0" Background="LightGray">
                                    <Image Source="{Binding ImagePaths, Converter={StaticResource FirstImageConverter}}"
                                           Stretch="UniformToFill"/>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,4">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}, {2}">
                                                <Binding Path="Street"/>
                                                <Binding Path="StreetNumber"/>
                                                <Binding Path="Neighborhood"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock FontSize="13" Margin="0,0,0,4">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="📍 {0}, {1}">
                                                <Binding Path="City.Name"/>
                                                <Binding Path="City.Country.Name"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock FontSize="13" Margin="0,0,0,4"
                                               Text="{Binding NumberOfFloors, StringFormat='Number of floors: {0}'}"/>
                                    <TextBlock FontSize="13"
                                               Text="{Binding TotalUnits, StringFormat='Total units: {0}'}"/>
                                </StackPanel>

                                <!-- Desna strana -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                            HorizontalAlignment="Right" Margin="10,0,0,0">
                                    <Button Content="Request Access"
                                            Padding="12,6" FontSize="13"
                                            Tag="{Binding}"
                                            Click="RequestAccessButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Pagination -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button Content="&lt;" Click="PrevPageButton_Click"
                    Padding="10,6" Margin="0,0,4,0" FontSize="13"/>
            <TextBlock x:Name="PageLabel" Text="Page 1 of 1"
                       VerticalAlignment="Center" Margin="8,0" FontSize="13"/>
            <Button Content="&gt;" Click="NextPageButton_Click"
                    Padding="10,6" Margin="4,0,0,0" FontSize="13"/>
        </StackPanel>

        <!-- Overlay kada je filter otvoren -->
        <Grid Grid.Row="0" Grid.RowSpan="4"
              x:Name="Overlay"
              Background="#66000000"
              Visibility="Collapsed"
              MouseLeftButtonDown="Overlay_MouseLeftButtonDown"/>

        <!-- Filter panel -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                x:Name="FilterPanel"
                Width="300"
                HorizontalAlignment="Left"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,1,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="FilterPanelTranslate" X="-300"/>
            </Border.RenderTransform>
            <StackPanel Margin="20">

                <!-- Header -->
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="Filter" FontSize="18" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0"
                            FontSize="16" Click="FilterButton_Click"/>
                </Grid>

                <!-- Street Address -->
                <TextBlock Text="Street Address:" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="FilterStreetTextBox"
                         Padding="8,6" FontSize="13"
                         Margin="0,0,0,16"/>

                <!-- Neighborhood -->
                <TextBlock Text="Neighborhood:" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="FilterNeighborhoodTextBox"
                         Padding="8,6" FontSize="13"
                         Margin="0,0,0,16"/>

                <!-- City -->
                <TextBlock Text="City:" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="FilterCityTextBox"
                         Padding="8,6" FontSize="13"
                         Margin="0,0,0,16"/>

                <!-- Country -->
                <TextBlock Text="Country:" FontSize="13"
                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="FilterCountryTextBox"
                         Padding="8,6" FontSize="13"
                         Margin="0,0,0,24"/>

                <!-- Dugmad -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Reset Filters"
                            Padding="0,8" FontSize="13"
                            Click="ResetFiltersButton_Click"/>
                    <Button Grid.Column="2" Content="Apply Filters"
                            Padding="0,8" FontSize="13"
                            Background="#2C3E50" Foreground="White"
                            Click="ApplyFiltersButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>