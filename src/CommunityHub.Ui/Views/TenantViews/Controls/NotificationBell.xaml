<UserControl x:Class="CommunityHub.Ui.Controls.NotificationBell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="42"
             Height="34">

    <Grid>
        <Button x:Name="BellButton"
                Content="🔔"
                Width="34"
                Height="30"
                Padding="0"
                FontSize="17"
                Background="Transparent"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="Notifications"
                Click="BellButton_Click"/>

        <Border x:Name="BadgeBorder"
                Width="16"
                Height="16"
                CornerRadius="8"
                Background="#E53935"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,0,2,0"
                Visibility="Collapsed">
            <TextBlock x:Name="BadgeTextBlock"
                       Foreground="White"
                       FontSize="9"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>