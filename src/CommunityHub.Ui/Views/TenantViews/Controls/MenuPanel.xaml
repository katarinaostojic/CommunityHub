<UserControl x:Class="CommunityHub.Ui.Controls.MenuPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0DCE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D0DCE8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Menu Overlay -->
        <Grid x:Name="MenuOverlay"
              Background="#66000000"
              Visibility="Collapsed"
              MouseLeftButtonDown="MenuOverlay_MouseLeftButtonDown"/>

        <!-- Menu panel -->
        <Border x:Name="MenuPanelBorder"
            Width="300"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Background="White"
            BorderBrush="#CCCCCC"
            BorderThickness="0,0,1,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="MenuPanelTranslate" X="-300"/>
            </Border.RenderTransform>

            <StackPanel>
                <!-- Header bar -->
                <Border Background="#2C3E50" Padding="16,12">
                    <Grid>
                        <TextBlock Text="☰  Menu"
                                   Foreground="White" FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Button Content="✕"
                                HorizontalAlignment="Right"
                                Background="Transparent" BorderThickness="0"
                                Foreground="White" FontSize="16"
                                Click="CloseMenuButton_Click"/>
                    </Grid>
                </Border>

                <!-- Browse Buildings -->
                <Button Style="{StaticResource MenuButtonStyle}"
                        Background="#EAF0F6"
                        Click="BrowseBuildingsMenuItem_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏢" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Browse Buildings" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Separator Margin="0"/>

                <!-- My Buildings Toggle -->
                <ToggleButton x:Name="MyBuildingsToggle"
                              Style="{StaticResource MenuToggleButtonStyle}"
                              Background="#DDE8F0"
                              Checked="MyBuildingsToggle_Checked"
                              Unchecked="MyBuildingsToggle_Unchecked">
                    <Grid Width="240">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="🏠" Margin="-10,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="My Buildings" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="MyBuildingsArrow" Text="∨"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </ToggleButton>

                <!-- My Buildings lista -->
                <ScrollViewer x:Name="MyBuildingsScrollViewer"
                              MaxHeight="447"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="MyBuildingsMenuPanel" Margin="0,4,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,8">
                                    <Border Background="#F5F5F5" Margin="16,0,16,4"
                                            CornerRadius="4" Padding="12,8"
                                            Cursor="Hand"
                                            Tag="{Binding}"
                                            MouseLeftButtonDown="BuildingName_Click">
                                        <TextBlock FontSize="13" FontWeight="SemiBold">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1}">
                                                    <Binding Path="Building.Street"/>
                                                    <Binding Path="Building.StreetNumber"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                    <Button Content="→ Notice Board"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="32,8" FontSize="12"
                                            Background="Transparent" BorderThickness="0"
                                            Tag="{Binding}"
                                            Click="NoticeBoardMenuItem_Click"/>
                                    <Button Content="→ Common Areas"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="32,8" FontSize="12"
                                            Background="Transparent" BorderThickness="0"/>
                                    <Button Content="→ Residents' Meeting"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="32,8" FontSize="12"
                                            Background="Transparent" BorderThickness="0"/>
                                    <Button Content="→ Reported Problems"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="32,8" FontSize="12"
                                            Background="Transparent" BorderThickness="0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Separator Margin="0"/>

                <!-- My Requests -->
                <Button Style="{StaticResource MenuButtonStyle}"
                        Background="#D0E3EE"
                        Click="MyRequestsMenuItem_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="My Requests" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Separator Margin="0"/>

                <!-- Notifications -->
                <Button Style="{StaticResource MenuButtonStyle}"
                        Background="#C3DCEB">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔔" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Notifications" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Separator Margin="0"/>

                <!-- Log out -->
                <Button Style="{StaticResource MenuButtonStyle}"
                        Background="#B6D5E8"
                        Click="LogoutButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↩" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Log out" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>