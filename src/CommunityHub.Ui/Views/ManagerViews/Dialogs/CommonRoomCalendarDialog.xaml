<Window x:Class="CommunityHub.Ui.Views.ManagerViews.Dialogs.CommonRoomCalendarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Calendar"
        Width="500" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Naziv sobe -->
        <TextBlock Grid.Row="0" x:Name="RoomTitleText"
                   FontSize="16" FontWeight="Bold"
                   Foreground="#2C3E50" Margin="0,0,0,15"
                   HorizontalAlignment="Center"/>

        <!-- Navigacija mesec -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="←" Width="36" Height="36"
                    Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                    FontSize="16" Cursor="Hand" Click="PrevMonth_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <TextBlock Grid.Column="1" x:Name="MonthYearText"
                       FontSize="15" FontWeight="Bold"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="→" Width="36" Height="36"
                    Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                    FontSize="16" Cursor="Hand" Click="NextMonth_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Legenda -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,0,0,15">
            <Border Width="16" Height="16" Background="#27AE60" 
                    CornerRadius="4" Margin="0,0,6,0"/>
            <TextBlock Text="Free" FontSize="12" Foreground="#2C3E50" 
                       Margin="0,0,15,0" VerticalAlignment="Center"/>
            <Border Width="16" Height="16" Background="#E74C3C" 
                    CornerRadius="4" Margin="0,0,6,0"/>
            <TextBlock Text="Occupied" FontSize="12" Foreground="#2C3E50" 
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Dani u nedelji -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Mon" FontSize="11" 
                           Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Tue" FontSize="11" 
                           Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Wed" FontSize="11" 
                           Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="Thu" FontSize="11" 
                           Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Fri" FontSize="11" 
                           Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="Sat" FontSize="11" 
                           Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="Sun" FontSize="11" 
                           Foreground="#7F8C8D" HorizontalAlignment="Center"/>
            </Grid>

            <ItemsControl Grid.Row="1" x:Name="CalendarItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="2" CornerRadius="8"
                                Background="{Binding Color}">
                            <TextBlock Text="{Binding Day}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Padding="0,8"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Close dugme -->
        <Button Grid.Row="4" Content="Close"
                Height="40" Margin="0,15,0,0"
                Background="#2C3E50" Foreground="White"
                BorderThickness="0" FontSize="13"
                Cursor="Hand" Click="CloseButton_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>