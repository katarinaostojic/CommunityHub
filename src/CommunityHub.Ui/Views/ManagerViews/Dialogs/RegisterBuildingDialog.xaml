<Window x:Class="CommunityHub.Ui.Views.ManagerViews.Dialogs.RegisterBuildingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register Building" Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid>
        <!-- TABS -->
        <TabControl x:Name="MainTabControl">

            <!-- TAB 1 - Info -->
            <TabItem Header="Information about the building">
                <ScrollViewer>
                    <StackPanel Margin="40,20,40,20">

                        <!-- Street -->
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="* Street" 
                                       VerticalAlignment="Center" FontSize="14"/>
                            <TextBox Grid.Column="1" x:Name="StreetTextBox" 
                                     Height="35" FontSize="14"
                                     GotFocus="TextBox_GotFocus"/>
                        </Grid>

                        <!-- Number -->
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="* Number" 
                                       VerticalAlignment="Center" FontSize="14"/>
                            <TextBox Grid.Column="1" x:Name="NumberTextBox" 
                                     Height="35" FontSize="14"
                                     GotFocus="TextBox_GotFocus"/>
                        </Grid>

                        <!-- Settlement -->
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="* Settlement" 
                                       VerticalAlignment="Center" FontSize="14"/>
                            <TextBox Grid.Column="1" x:Name="SettlementTextBox" 
                                     Height="35" FontSize="14"
                                     GotFocus="TextBox_GotFocus"/>
                        </Grid>

                        <!-- Country -->
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="* Country" 
                                       VerticalAlignment="Center" FontSize="14"/>
                            <ComboBox Grid.Column="1" x:Name="CountryComboBox" 
                                      Height="35" FontSize="14"/>
                        </Grid>

                        <!-- City -->
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="* City" 
                                       VerticalAlignment="Center" FontSize="14"/>
                            <ComboBox Grid.Column="1" x:Name="CityComboBox" 
                                      Height="35" FontSize="14"/>
                        </Grid>

                        <!-- Floors -->
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="* Floors" 
                                       VerticalAlignment="Center" FontSize="14"/>
                            <TextBox Grid.Column="1" x:Name="FloorsTextBox" 
                                     Height="35" FontSize="14"
                                     GotFocus="TextBox_GotFocus"/>
                            <Button Grid.Column="2" Content="Confirm" 
                                    Height="35" Margin="10,0,0,0"
                                    Click="ConfirmFloors_Click"/>
                        </Grid>

                        <!-- Dinamicki spratovi -->
                        <StackPanel x:Name="FloorsStackPanel" Margin="0,10,0,10"/>

                        <!-- Dugmad -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Register" 
                                    Height="45" FontSize="14" Margin="0,0,10,0"
                                    Click="Register_Click"/>
                            <Button Grid.Column="1" Content="Cancel" 
                                    Height="45" FontSize="14" Margin="10,0,0,0"
                                    Click="Cancel_Click"/>
                        </Grid>

                        <TextBlock Text="* indicates a required field" 
                                   Foreground="Red" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2 - Images -->
            <TabItem Header="Add building images">
                <StackPanel Margin="40,20,40,20">

                    <!-- Upload zona -->
                    <Border Height="150" BorderBrush="#CCCCCC" 
                            BorderThickness="2" CornerRadius="8"
                            Background="#F5F5F5" Margin="0,0,0,20"
                            AllowDrop="True">
                        <StackPanel HorizontalAlignment="Center" 
                                    VerticalAlignment="Center">
                            <TextBlock Text="☁" FontSize="40" 
                                       HorizontalAlignment="Center"/>
                            <Button Content="Choose pictures to upload" 
                                    Background="Transparent"
                                    BorderThickness="0" FontSize="14"
                                    Click="ChooseImages_Click"/>
                            <TextBlock Text="or drag and drop them here" 
                                       HorizontalAlignment="Center"
                                       Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <!-- Preview slika -->
                    <ItemsControl x:Name="ImagesPreview">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Width="150" Height="120" 
                                       Margin="10" Stretch="UniformToFill"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Dugmad -->
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Register" 
                                Height="45" FontSize="14" Margin="0,0,10,0"
                                Click="Register_Click"/>
                        <Button Grid.Column="1" Content="Cancel" 
                                Height="45" FontSize="14" Margin="10,0,0,0"
                                Click="Cancel_Click"/>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>