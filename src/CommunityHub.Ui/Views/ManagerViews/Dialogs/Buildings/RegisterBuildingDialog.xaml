<Window x:Class="CommunityHub.Ui.Views.ManagerViews.Dialogs.RegisterBuildingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CommunityHub.Ui.Views.ManagerViews.Controls"
        Title="Register Building" Height="650" Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1A2332">
            <TextBlock Text="Register New Building"
                       FontSize="20" FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="30,0,0,0"/>
        </Border>

        <!-- TABS -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="20,10"/>
                    <Setter Property="Background" Value="#E8EDF2"/>
                    <Setter Property="Foreground" Value="#7F8C8D"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#2980B9"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1 - Info -->
            <TabItem Header="📋  Building Information">
                <ScrollViewer Background="White" Padding="40,20">
                    <StackPanel>

                        <!-- Street -->
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="* Street"
                                       VerticalAlignment="Center" FontSize="14"/>
                            <Border Grid.Column="1" Background="#F8F9FA" CornerRadius="8"
                                    BorderBrush="#DDE1E7" BorderThickness="1">
                                <TextBox x:Name="StreetTextBox"
                                         Height="38" FontSize="14"
                                         Background="Transparent"
                                         BorderThickness="0" Padding="10,0"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Number -->
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="* Number"
                                       VerticalAlignment="Center" FontSize="14"/>
                            <Border Grid.Column="1" Background="#F8F9FA" CornerRadius="8"
                                    BorderBrush="#DDE1E7" BorderThickness="1">
                                <TextBox x:Name="NumberTextBox"
                                         Height="38" FontSize="14"
                                         Background="Transparent"
                                         BorderThickness="0" Padding="10,0"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Settlement -->
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="* Settlement"
                                       VerticalAlignment="Center" FontSize="14"/>
                            <Border Grid.Column="1" Background="#F8F9FA" CornerRadius="8"
                                    BorderBrush="#DDE1E7" BorderThickness="1">
                                <TextBox x:Name="SettlementTextBox"
                                         Height="38" FontSize="14"
                                         Background="Transparent"
                                         BorderThickness="0" Padding="10,0"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Country -->
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="* Country"
                                       VerticalAlignment="Center" FontSize="14"/>
                            <Border Grid.Column="1" Background="#F8F9FA" CornerRadius="8"
                                    BorderBrush="#DDE1E7" BorderThickness="1">
                                <ComboBox x:Name="CountryComboBox"
                                          Height="38" FontSize="14"
                                          Background="Transparent"
                                          BorderThickness="0" Padding="10,0"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="CountryComboBox_SelectionChanged"/>
                            </Border>
                        </Grid>

                        <!-- City -->
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="* City"
                                       VerticalAlignment="Center" FontSize="14"/>
                            <Border Grid.Column="1" Background="#F8F9FA" CornerRadius="8"
                                    BorderBrush="#DDE1E7" BorderThickness="1">
                                <ComboBox x:Name="CityComboBox"
                                          Height="38" FontSize="14"
                                          Background="Transparent"
                                          BorderThickness="0" Padding="10,0"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="CityComboBox_SelectionChanged"/>
                            </Border>
                        </Grid>

                        <!-- Floors -->
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="* Number of Floors"
                                       VerticalAlignment="Center" FontSize="14"/>
                            <Border Grid.Column="1" Background="#F8F9FA" CornerRadius="8"
                                    BorderBrush="#DDE1E7" BorderThickness="1" Margin="0,0,10,0">
                                <TextBox x:Name="FloorsTextBox"
                                         Height="38" FontSize="14"
                                         Background="Transparent"
                                         BorderThickness="0" Padding="10,0"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="2" Content="Confirm"
                                    ToolTip="Generates a unit input field for each floor below"
                                    Height="38" FontSize="13"
                                    Background="#2980B9" Foreground="White"
                                    BorderThickness="0"
                                    Click="ConfirmFloors_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- Dinamicki spratovi -->
                        <StackPanel x:Name="FloorsStackPanel" Margin="0,10,0,10"/>

                        <!-- Dugmad -->
                        <Grid Margin="0,20,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Register"
                                    Height="45" FontSize="14" FontWeight="SemiBold"
                                    Margin="0,0,8,0" Foreground="White"
                                    Background="#27AE60" BorderThickness="0"
                                    Click="Register_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Grid.Column="1" Content="Cancel"
                                    Height="45" FontSize="14" FontWeight="SemiBold"
                                    Margin="8,0,0,0" Foreground="White"
                                    Background="#E74C3C" BorderThickness="0"
                                    Click="Cancel_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <TextBlock Text="* indicates a required field"
                                   Foreground="#E74C3C" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2 - Images -->
            <TabItem Header="🖼️  Building Images">
                <StackPanel Background="White" Margin="40,20,40,20">
                    <Border Height="160" BorderBrush="#DDE1E7"
                            BorderThickness="2" CornerRadius="12"
                            Background="#F8F9FA" Margin="0,0,0,20"
                            AllowDrop="True">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="☁️" FontSize="45"
                                       HorizontalAlignment="Center"/>
                            <Button Content="Choose pictures to upload"
                                    Background="Transparent"
                                    BorderThickness="0" FontSize="14"
                                    Foreground="#2980B9" FontWeight="SemiBold"
                                    Click="ChooseImages_Click"/>
                            <TextBlock Text="or drag and drop them here"
                                       HorizontalAlignment="Center"
                                       Foreground="#7F8C8D" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="ImagesPreview">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Margin="8" ClipToBounds="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" Opacity="0.15"/>
                                    </Border.Effect>
                                    <Image Source="{Binding}" Width="150" Height="110"
                                           Stretch="UniformToFill"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Register"
                                Height="45" FontSize="14" FontWeight="SemiBold"
                                Margin="0,0,8,0" Foreground="White"
                                Background="#27AE60" BorderThickness="0"
                                Click="Register_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="1" Content="Cancel"
                                Height="45" FontSize="14" FontWeight="SemiBold"
                                Margin="8,0,0,0" Foreground="White"
                                Background="#E74C3C" BorderThickness="0"
                                Click="Cancel_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>