<Window x:Class="CommunityHub.Ui.Views.ManagerViews.Dialogs.Buildings.ResidentMeetings.ScheduleMeetingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Title="Schedule Meeting" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White" CornerRadius="12" Padding="32,28,32,28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Opacity="0.2" ShadowDepth="4"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <TextBlock Text="Schedule New Resident Meeting"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#2C3E50"
                           VerticalAlignment="Center"/>
                <Button Content="✕" Width="32" Height="32"
                        FontSize="14" Foreground="#888"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" HorizontalAlignment="Right"
                        Click="CancelButton_Click"/>
            </Grid>

            <!-- Datum -->
            <TextBlock Text="Date *" FontSize="13" FontWeight="SemiBold"
                       Foreground="#2C3E50" Margin="0,0,0,6"/>
            <DatePicker x:Name="DatePicker"
                        FontSize="13" Height="38"
                        DisplayDateStart="{x:Static system:DateTime.Today}"/>
            <TextBlock x:Name="DateErrorText"
                       Foreground="#E74C3C" FontSize="11"
                       Margin="2,3,0,16" Visibility="Collapsed"/>

            <!-- Vreme -->
            <TextBlock Text="Time *" FontSize="13" FontWeight="SemiBold"
                       Foreground="#2C3E50" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="HourComboBox" Grid.Column="0"
                          FontSize="13" Height="38"/>
                <TextBlock Grid.Column="1" Text=":" FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="MinuteComboBox" Grid.Column="2"
                          FontSize="13" Height="38"/>
            </Grid>
            <TextBlock x:Name="TimeErrorText"
                       Foreground="#E74C3C" FontSize="11"
                       Margin="2,3,0,16" Visibility="Collapsed"/>

            <!-- Teme -->
            <TextBlock Text="Topics *" FontSize="13" FontWeight="SemiBold"
                       Foreground="#2C3E50" Margin="0,0,0,6"/>
            <TextBlock Text="Enter one topic per line"
                       FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,6"/>
            <Border Background="#F8F9FA" CornerRadius="8"
                    BorderBrush="#DDE1E7" BorderThickness="1">
                <TextBox x:Name="TopicsTextBox"
                         Height="120" Padding="10,8"
                         BorderThickness="0" Background="Transparent"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="13"/>
            </Border>
            <TextBlock x:Name="TopicsErrorText"
                       Foreground="#E74C3C" FontSize="11"
                       Margin="2,3,0,20" Visibility="Collapsed"/>

            <!-- Dugmad -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel"
                        Height="42" Margin="0,0,8,0"
                        FontSize="13" FontWeight="SemiBold"
                        Foreground="#2C3E50" Background="White"
                        BorderBrush="#E0E0E0" BorderThickness="1"
                        Cursor="Hand" Click="CancelButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="1" Content="Schedule"
                        Height="42" Margin="8,0,0,0"
                        FontSize="13" FontWeight="SemiBold"
                        Foreground="White" Background="#2980B9"
                        BorderThickness="0" Cursor="Hand"
                        Click="ScheduleButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="12,0">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2471a3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>