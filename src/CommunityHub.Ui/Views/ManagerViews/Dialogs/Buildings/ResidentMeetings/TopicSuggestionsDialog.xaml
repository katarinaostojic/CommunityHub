<Window x:Class="CommunityHub.Ui.Views.ManagerViews.Dialogs.Buildings.ResidentMeetings.TopicSuggestionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Topic Suggestions" Width="500" SizeToContent="Height"
        MaxHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" Padding="32,28,32,28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Opacity="0.2" ShadowDepth="4"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <TextBlock Text="List of topics suggested by tenants"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#2C3E50"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Content="✕" Width="32" Height="32"
                        FontSize="14" Foreground="#888"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" HorizontalAlignment="Right"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- Ako nema predloga -->
            <TextBlock Text="No topics have been suggested by tenants yet."
                       FontSize="13" Foreground="#7F8C8D"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSuggestions}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Lista predloga -->
            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Suggestions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EFEFEF" BorderThickness="0,0,0,1"
                                    Padding="8,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Topic}"
                                               FontSize="13" Foreground="#2C3E50"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <Button Grid.Column="1"
                                            Content="Add to topics"
                                            Height="30" Padding="10,0"
                                            FontSize="12" FontWeight="SemiBold"
                                            Foreground="White" Background="#27AE60"
                                            BorderThickness="0" Cursor="Hand"
                                            Tag="{Binding Topic}"
                                            Click="AddTopic_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Content="Close" Width="120" Height="38"
                    FontSize="13" FontWeight="SemiBold"
                    Foreground="White" Background="#2C3E50"
                    BorderThickness="0" HorizontalAlignment="Center"
                    Cursor="Hand" Margin="0,20,0,0"
                    Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1a252f"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>