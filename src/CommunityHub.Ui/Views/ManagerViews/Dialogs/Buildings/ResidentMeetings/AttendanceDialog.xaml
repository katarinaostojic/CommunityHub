<Window x:Class="CommunityHub.Ui.Views.ManagerViews.Dialogs.Buildings.ResidentMeetings.AttendanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attendance" Width="420" SizeToContent="Height"
        MaxHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="White" CornerRadius="12" Padding="32,28,32,28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Opacity="0.2" ShadowDepth="4"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <TextBlock Text="List of apartments that have confirmed attendance"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#2C3E50"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Content="✕" Width="32" Height="32"
                        FontSize="14" Foreground="#888"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" HorizontalAlignment="Right"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- Lista stanova -->
            <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AttendanceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EFEFEF" BorderThickness="0,0,0,1"
                                    Padding="8,10">
                                <TextBlock Text="{Binding}" FontSize="13"
                                           Foreground="#2C3E50"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Ako nema prisutnih -->
            <TextBlock x:Name="EmptyText"
                       Text="No apartments have confirmed attendance yet."
                       FontSize="13" Foreground="#7F8C8D"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,12"
                       Visibility="Collapsed"/>

            <Button Content="Close" Width="120" Height="38"
                    FontSize="13" FontWeight="SemiBold"
                    Foreground="White" Background="#2C3E50"
                    BorderThickness="0" HorizontalAlignment="Center"
                    Cursor="Hand" Margin="0,20,0,0"
                    Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1a252f"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>