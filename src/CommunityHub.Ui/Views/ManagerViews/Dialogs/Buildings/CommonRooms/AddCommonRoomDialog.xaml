<Window x:Class="CommunityHub.Ui.Views.ManagerViews.Dialogs.AddCommonRoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Common Room"
        Width="480" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F6F9">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <TextBlock Grid.Row="0" Text="Add Common Room"
                   FontSize="20" FontWeight="Bold"
                   Foreground="#2C3E50" Margin="0,0,0,25"/>

        <!-- FORMA -->
        <StackPanel Grid.Row="1">

            <!-- Name -->
            <TextBlock Text="Name *" FontSize="13" Foreground="#2C3E50" 
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Background="White" CornerRadius="8" 
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <TextBox x:Name="NameTextBox" Height="38" Padding="12,0"
                         BorderThickness="0" Background="Transparent"
                         VerticalContentAlignment="Center" FontSize="13"/>
            </Border>
            <TextBlock x:Name="NameErrorText"
                       Foreground="#E74C3C" FontSize="11"
                       Margin="2,3,0,15" Visibility="Collapsed"/>

            <!-- Description -->
            <TextBlock Text="Description *" FontSize="13" Foreground="#2C3E50"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Background="White" CornerRadius="8"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <TextBox x:Name="DescriptionTextBox" Height="70" Padding="12,8"
                         BorderThickness="0" Background="Transparent"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" FontSize="13"/>
            </Border>
            <TextBlock x:Name="DescriptionErrorText"
                       Foreground="#E74C3C" FontSize="11"
                       Margin="2,3,0,15" Visibility="Collapsed"/>

            <!-- Floor -->
            <TextBlock Text="Floor *" FontSize="13" Foreground="#2C3E50"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Background="White" CornerRadius="8"
                       BorderBrush="#E0E0E0" BorderThickness="1">
                <ComboBox x:Name="FloorComboBox" Height="38" Padding="8,0"
                          BorderThickness="0" Background="Transparent"
                          VerticalContentAlignment="Center" FontSize="13"/>
            </Border>
            <TextBlock x:Name="FloorErrorText"
                       Foreground="#E74C3C" FontSize="11"
                       Margin="2,3,0,15" Visibility="Collapsed"/>

            <!-- Rental Type -->
            <TextBlock Text="Rental Type *" FontSize="13" Foreground="#2C3E50"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Background="White" CornerRadius="8"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <ComboBox x:Name="RentalTypeComboBox" Height="38" Padding="8,0"
                          BorderThickness="0" Background="Transparent"
                          VerticalContentAlignment="Center" FontSize="13">
                    <ComboBoxItem Content="Per Day"/>
                    <ComboBoxItem Content="Multi Day"/>
                </ComboBox>
            </Border>
            <TextBlock x:Name="RentalTypeErrorText"
                       Foreground="#E74C3C" FontSize="11"
                       Margin="2,3,0,0" Visibility="Collapsed"/>

        </StackPanel>

        <!-- DUGMAD -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Cancel"
                    Height="42" Margin="0,0,8,0"
                    Background="White" Foreground="#2C3E50"
                    BorderBrush="#E0E0E0" BorderThickness="1"
                    FontSize="13" Cursor="Hand"
                    Click="CancelButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Grid.Column="1" Content="Add"
                    Height="42" Margin="8,0,0,0"
                    Background="#2980B9" Foreground="White"
                    BorderThickness="0"
                    FontSize="13" FontWeight="SemiBold"
                    Cursor="Hand" Click="AddButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>