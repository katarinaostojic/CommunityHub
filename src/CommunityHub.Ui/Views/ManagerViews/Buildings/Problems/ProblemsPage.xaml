<Page x:Class="CommunityHub.Ui.Views.ManagerViews.Buildings.Problems.ProblemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Converters"
      Title="Problems"
      Background="#F4F6F9">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>

        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,14"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="DataCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            <TextBlock Text="Reported problems"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#2C3E50"
                       VerticalAlignment="Center"
                       Margin="30,0,0,0"/>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1" Margin="24,16,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Building picker -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Choose your building for which you want to see reported problems"
                           VerticalAlignment="Center"
                           FontSize="13" Foreground="#555" Margin="0,0,12,0"/>
                <ComboBox x:Name="BuildingComboBox"
                          Width="320" FontSize="13"
                          ItemsSource="{Binding Buildings}"
                          SelectionChanged="BuildingComboBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding FullAddress, Mode=OneWay}"/>
                                <Run Text=", "/>
                                <Run Text="{Binding CityName, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Building preview -->
            <Border Grid.Row="1" Margin="0,0,0,16"
                    x:Name="BuildingPreview"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Border Width="200" Height="130" CornerRadius="10" ClipToBounds="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Opacity="0.15" ShadowDepth="2"/>
                        </Border.Effect>
                        <Image Source="{Binding SelectedBuilding.ImagePaths, 
                                       Converter={StaticResource ImagePathConverter}}"
                               Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedBuilding.FullAddress}"
                                   FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="{Binding SelectedBuilding.CityName}"
                                   FontSize="14" Foreground="#7F8C8D" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Table -->
            <Border Grid.Row="2" Background="White" CornerRadius="10"
                    BorderBrush="#DEDEDE" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.08" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table header -->
                    <Border Grid.Row="0" Background="#2C3E50" CornerRadius="10,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tenant" Style="{StaticResource HeaderCell}"/>
                            <TextBlock Grid.Column="1" Text="Description" Style="{StaticResource HeaderCell}"/>
                            <TextBlock Grid.Column="2" Text="Priority" Style="{StaticResource HeaderCell}"/>
                            <TextBlock Grid.Column="3" Text="Date reported" Style="{StaticResource HeaderCell}"/>
                            <TextBlock Grid.Column="4" Text="Status" Style="{StaticResource HeaderCell}"/>
                            <TextBlock Grid.Column="5" Text="Actions" Style="{StaticResource HeaderCell}"/>
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Problems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RowBorder"
                                            BorderBrush="#EFEFEF" BorderThickness="0,0,0,1"
                                            Background="White" MinHeight="54">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Style="{StaticResource DataCell}"
                                                       Text="{Binding TenantFullName}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource DataCell}"
                                                       Text="{Binding Description}"
                                                       TextAlignment="Left"/>

                                            <!-- Priority badge -->
                                            <Border Grid.Column="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    CornerRadius="12" Padding="10,4"
                                                    Background="{Binding PriorityBackground}">
                                                <TextBlock Text="{Binding PriorityDisplay}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding PriorityForeground}"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"/>
                                            </Border>

                                            <TextBlock Grid.Column="3" Style="{StaticResource DataCell}"
                                                       Text="{Binding ReportedAt, StringFormat=dd.MM.yyyy.}"/>

                                            <!-- Status badge -->
                                            <Border Grid.Column="4"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    CornerRadius="12" Padding="10,4"
                                                    Background="{Binding StatusBackground}">
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusForeground}"/>
                                            </Border>

                                            <!-- Action button -->
                                            <StackPanel Grid.Column="5"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0">
                                                <Button Content="Mark as resolved"
                                                        Style="{StaticResource ActionButton}"
                                                        Foreground="White" Background="#27AE60"
                                                        Padding="12,0"
                                                        Tag="{Binding Id}"
                                                        Visibility="{Binding CanMarkResolved, Converter={StaticResource BoolToVis}}"
                                                        Click="MarkAsResolved_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding AlternateRow}" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#FAFAFA"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>