<Page x:Class="CommunityHub.Ui.Views.ManagerViews.AccessRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Access Requests"
      Background="#F4F6F9">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="FilterButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#E8EDF2"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,14"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="HeaderSortButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D5166"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            <TextBlock Text="Requests for accessing the buildings"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#2C3E50"
                       VerticalAlignment="Center"
                       Margin="30,0,0,0"/>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1" Margin="24,16,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filter bar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,0,0,12">
                <Button x:Name="BtnAll" Style="{StaticResource FilterButton}"
                        Content="{Binding AllButtonLabel}" Margin="0,0,6,0" Click="FilterAll_Click"/>
                <Button x:Name="BtnPending" Style="{StaticResource FilterButton}"
                        Content="{Binding PendingButtonLabel}" Margin="0,0,6,0" Click="FilterPending_Click"/>
                <Button x:Name="BtnApproved" Style="{StaticResource FilterButton}"
                        Content="{Binding ApprovedButtonLabel}" Margin="0,0,6,0" Click="FilterApproved_Click"/>
                <Button x:Name="BtnRejected" Style="{StaticResource FilterButton}"
                        Content="{Binding RejectedButtonLabel}" Click="FilterRejected_Click"/>
            </StackPanel>

            <!-- Table -->
            <Border Grid.Row="1" Background="White" CornerRadius="10"
                    BorderBrush="#DEDEDE" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.08" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table header -->
                    <Border Grid.Row="0" Background="#2C3E50" CornerRadius="10,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tenant" Style="{StaticResource HeaderCell}"/>
                            <TextBlock Grid.Column="1" Text="Building address" Style="{StaticResource HeaderCell}"/>
                            <TextBlock Grid.Column="2" Text="Settlement" Style="{StaticResource HeaderCell}"/>
                            <TextBlock Grid.Column="3" Text="Location" Style="{StaticResource HeaderCell}"/>
                            <TextBlock Grid.Column="4" Text="Flat No." Style="{StaticResource HeaderCell}"/>
                            <Button Grid.Column="5" x:Name="SortDateButton"
                                    Style="{StaticResource HeaderSortButton}"
                                    Click="SortDateButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Date of creation" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SortArrow" Text=" ↓" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="6" Text="Status" Style="{StaticResource HeaderCell}"/>
                            <TextBlock Grid.Column="7" Text="Actions" Style="{StaticResource HeaderCell}"/>
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RowViewModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RowBorder"
                                            BorderBrush="#EFEFEF" BorderThickness="0,0,0,1"
                                            Background="White" MinHeight="54">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="200"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Style="{StaticResource DataCell}"
                                                       Text="{Binding TenantFullName}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource DataCell}"
                                                       Text="{Binding BuildingFullAddress}"/>
                                            <TextBlock Grid.Column="2" Style="{StaticResource DataCell}"
                                                       Text="{Binding BuildingNeighborhood}"/>
                                            <TextBlock Grid.Column="3" Style="{StaticResource DataCell}"
                                                       Text="{Binding BuildingLocation}"/>
                                            <TextBlock Grid.Column="4" Style="{StaticResource DataCell}"
                                                       Text="{Binding UnitNumber}"/>
                                            <TextBlock Grid.Column="5" Style="{StaticResource DataCell}"
                                                       Text="{Binding CreatedAt, StringFormat=dd-MM-yyyy}"/>

                                            <!-- Status badge -->
                                            <Border Grid.Column="6"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    CornerRadius="12" Padding="10,4"
                                                    Background="{Binding StatusBackground}">
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusForeground}"/>
                                            </Border>

                                            <!-- Action buttons -->
                                            <StackPanel Grid.Column="7" Orientation="Horizontal"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Margin="8,0">
                                                <Button Content="Accept"
                                                        Style="{StaticResource ActionButton}"
                                                        Foreground="White" Background="#27AE60"
                                                        Margin="0,0,6,0"
                                                        Tag="{Binding Id}"
                                                        Visibility="{Binding PendingVisible, Converter={StaticResource BoolToVis}}"
                                                        Click="AcceptButton_Click"/>
                                                <Button Content="Reject"
                                                        Style="{StaticResource ActionButton}"
                                                        Foreground="White" Background="#E74C3C"
                                                        Tag="{Binding Id}"
                                                        Visibility="{Binding PendingVisible, Converter={StaticResource BoolToVis}}"
                                                        Click="RejectButton_Click"/>
                                                <Button Content="Explanation"
                                                        Width="110" Height="32"
                                                        FontSize="12"
                                                        Foreground="#2C3E50" Background="White"
                                                        BorderBrush="#CCCCCC" BorderThickness="1"
                                                        Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Visibility="{Binding ExplanationVisible, Converter={StaticResource BoolToVis}}"
                                                        Click="ExplanationButton_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6"
                                                                    Padding="8,0">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding AlternateRow}" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#FAFAFA"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>