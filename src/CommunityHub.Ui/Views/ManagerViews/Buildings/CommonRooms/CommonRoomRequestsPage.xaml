<Page x:Class="CommunityHub.Ui.Views.ManagerViews.CommonRoomRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Common Room Requests"
      Background="#F4F6F9">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            <Grid Margin="20,0">
                <Button Content="← Back" HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="80" Height="34"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#2980B9" FontSize="13" FontWeight="SemiBold"
                        Cursor="Hand" Click="BackButton_Click"/>
                <TextBlock Text="{Binding RoomTitle}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#2C3E50"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- SADRZAJ -->
        <ScrollViewer Grid.Row="1" Margin="25">
            <ItemsControl ItemsSource="{Binding Requests}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="10"
                                Margin="0,0,0,12" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.1" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>

                                <!-- Info o zahtevu -->
                                <TextBlock Text="{Binding TenantFullName}"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="#2C3E50"/>
                                <TextBlock Text="{Binding DateRangeDisplay}"
                                           FontSize="13" Foreground="#7F8C8D"
                                           Margin="0,4,0,0"/>
                                

                                <!-- Status bedz -->
                                <Border CornerRadius="6" Margin="0,8,0,12"
                                        Background="{Binding StatusBadgeColor}"
                                        Padding="10,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusDisplay}"
                                               Foreground="White" FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <!-- Akcije za Pending -->
                                <StackPanel Tag="{Binding Id}">
                                    <!-- PerDay akcije -->
                                    <Button Content="Show free days"
                                            Width="150" Height="34"
                                            HorizontalAlignment="Left"
                                            Background="#2980B9" Foreground="White"
                                            BorderThickness="0" FontSize="12"
                                            Cursor="Hand"
                                            Tag="{Binding Id}"
                                            Visibility="{Binding ShowPerDayActions, Converter={StaticResource BoolToVis}}"
                                            Click="ShowFreeDays_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <!-- MultiDay akcije -->
                                    <Button Content="Show alternatives"
                                            Width="160" Height="34"
                                            HorizontalAlignment="Left"
                                            Background="#E67E22" Foreground="White"
                                            BorderThickness="0" FontSize="12"
                                            Cursor="Hand"
                                            Tag="{Binding Id}"
                                            Visibility="{Binding ShowMultiDayActions, Converter={StaticResource BoolToVis}}"
                                            Click="ShowAlternatives_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>