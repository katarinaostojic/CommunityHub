<Page x:Class="CommunityHub.Ui.Views.ManagerViews.BuildingDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Converters"
      Title="Building Details"
      Background="#F4F6F9">

    <Page.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
        <converters:SingleImagePathConverter x:Key="SingleImagePathConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            <Grid Margin="20,0">
                <Button Content="← Back" HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="80" Height="34"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#2980B9" FontSize="13" FontWeight="SemiBold"
                        Cursor="Hand" Click="BackButton_Click"/>
                <TextBlock Text="{Binding Building.FullAddress}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#2C3E50"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- TABOVI -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="20,0">
                <Button x:Name="TabBuildingInfo" Content="Building Information"
                        Height="50" Background="Transparent"
                        BorderThickness="0,0,0,3" BorderBrush="#2980B9"
                        Foreground="#2980B9" FontSize="13" FontWeight="SemiBold"
                        Padding="15,0" Cursor="Hand"
                        Click="TabBuildingInfo_Click"/>
                <Button x:Name="TabCommonRoom" Content="Common Room"
                        Height="50" Background="Transparent" BorderThickness="0"
                        Foreground="#7F8C8D" FontSize="13"
                        Padding="15,0" Cursor="Hand"
                        Click="TabCommonRoom_Click"/>
            </StackPanel>
        </Border>

        <!-- SADRZAJ -->
        <ScrollViewer Grid.Row="2" Margin="25">
            <Grid>

                <!-- Building Information panel -->
                <StackPanel x:Name="PanelBuildingInfo">

                    <TextBlock Text="Building Details" FontSize="16" FontWeight="Bold"
                               Foreground="#2C3E50" Margin="0,0,0,15"/>

                    <!-- Slike -->
                    <ItemsControl ItemsSource="{Binding Building.ImagePaths}"
                                  Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="180" Height="120" Margin="0,0,10,10"
                                        CornerRadius="8" ClipToBounds="True">
                                    <Image Source="{Binding Converter={StaticResource SingleImagePathConverter}}"
                                           Stretch="UniformToFill"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock FontSize="14" Foreground="#2C3E50" Margin="0,0,0,8"
                               Text="{Binding Building.FullAddress, StringFormat='Street: {0}'}"/>
                    <TextBlock FontSize="14" Foreground="#2C3E50" Margin="0,0,0,8"
                               Text="{Binding Building.Neighborhood, StringFormat='Neighborhood: {0}'}"/>
                    <TextBlock FontSize="14" Foreground="#2C3E50" Margin="0,0,0,8"
                               Text="{Binding Building.Location, StringFormat='City: {0}'}"/>
                    <TextBlock FontSize="14" Foreground="#2C3E50" Margin="0,0,0,8"
                               Text="{Binding Building.NumberOfFloors, StringFormat='Floors: {0}'}"/>
                    <TextBlock FontSize="14" Foreground="#2C3E50" Margin="0,0,0,25"
                               Text="{Binding Building.TotalUnits, StringFormat='Total units: {0}'}"/>

                    <!-- Membership lista -->
                    <TextBlock Text="Tenants with Membership" FontSize="16"
                               FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                    <DataGrid ItemsSource="{Binding Memberships}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="White"
                              BorderBrush="#E0E0E0"
                              RowBackground="White"
                              AlternatingRowBackground="#F9F9F9"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0F0F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tenant" Width="*"
                                Binding="{Binding TenantFullName}"/>
                            <DataGridTextColumn Header="Floor" Width="100"
                                Binding="{Binding FloorNumber}"/>
                            <DataGridTextColumn Header="Unit" Width="100"
                                Binding="{Binding UnitNumber}"/>
                            <DataGridTextColumn Header="Member since" Width="150"
                                Binding="{Binding ApprovedAt, StringFormat=dd.MM.yyyy.}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- Common Room panel -->
                <StackPanel x:Name="PanelCommonRoom" Visibility="Collapsed">
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Common Rooms" FontSize="16" FontWeight="Bold"
                                   Foreground="#2C3E50" VerticalAlignment="Center"/>
                        <Button Content="+ Add Common Room"
                                HorizontalAlignment="Right"
                                Width="180" Height="36"
                                Background="#2980B9" Foreground="White"
                                BorderThickness="0" FontSize="13" FontWeight="SemiBold"
                                Cursor="Hand" Click="AddCommonRoom_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding CommonRooms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="10"
                                        Margin="0,0,0,12" Padding="20">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" Opacity="0.1" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontSize="15"
                                                       FontWeight="Bold" Foreground="#2C3E50"/>
                                            <TextBlock Text="{Binding Description}" FontSize="13"
                                                       Foreground="#7F8C8D" Margin="0,4,0,0"/>
                                            <TextBlock FontSize="13" Foreground="#7F8C8D" Margin="0,4,0,0"
                                                       Text="{Binding FloorNumber, StringFormat='Floor: {0}'}"/>
                                            <TextBlock FontSize="13" Foreground="#7F8C8D" Margin="0,4,0,0"
                                                       Text="{Binding RentalTypeDisplay}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Requests"
                                                Width="100" Height="34"
                                                Background="#F0F0F0" Foreground="#2C3E50"
                                                BorderThickness="0" FontSize="12"
                                                VerticalAlignment="Center"
                                                Cursor="Hand" Tag="{Binding Id}"
                                                Click="ViewRequests_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Grid.Column="2" Content="📅"
                                                Width="40" Height="34"
                                                Background="#8E44AD" Foreground="White"
                                                BorderThickness="0" FontSize="12"
                                                VerticalAlignment="Center"
                                                Cursor="Hand" Tag="{Binding Id}"
                                                Margin="0,0,5,0"
                                                Click="ViewCalendar_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>