<Page x:Class="CommunityHub.Ui.Views.ManagerViews.AccessRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Access Requests"
      Background="#F4F6F9">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="HeaderCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,14"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="HeaderSortButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D5166"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            <TextBlock Text="Requests for accessing the buildings"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#2C3E50"
                       VerticalAlignment="Center"
                       Margin="30,0,0,0"/>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1" Margin="24,16,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filter bar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,0,0,12">
                <TextBlock Text="Filter by status:" VerticalAlignment="Center"
                           FontSize="13" Foreground="#555" Margin="0,0,8,0"/>
                <ComboBox x:Name="StatusFilterCombo" Width="160" FontSize="13"
                          SelectionChanged="StatusFilterCombo_SelectionChanged">
                    <ComboBoxItem Content="All" IsSelected="True" Tag=""/>
                    <ComboBoxItem Content="Pending" Tag="pending approval"/>
                    <ComboBoxItem Content="Approved" Tag="approved"/>
                    <ComboBoxItem Content="Rejected" Tag="rejected"/>
                </ComboBox>
            </StackPanel>

            <!-- Table -->
            <Border Grid.Row="1" Background="White" CornerRadius="10"
                    BorderBrush="#DEDEDE" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.08" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table header -->
                    <Border Grid.Row="0" Background="#2C3E50" CornerRadius="10,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tenant" Style="{StaticResource HeaderCell}"/>
                            <TextBlock Grid.Column="1" Text="Building address" Style="{StaticResource HeaderCell}"/>
                            <TextBlock Grid.Column="2" Text="Settlement" Style="{StaticResource HeaderCell}"/>
                            <TextBlock Grid.Column="3" Text="Location" Style="{StaticResource HeaderCell}"/>
                            <TextBlock Grid.Column="4" Text="Flat No." Style="{StaticResource HeaderCell}"/>
                            <Button Grid.Column="5" x:Name="SortDateButton"
                                    Style="{StaticResource HeaderSortButton}"
                                    Click="SortDateButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Date of creation" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SortArrow" Text=" ↓" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Grid.Column="6" Text="Status" Style="{StaticResource HeaderCell}"/>
                            <TextBlock Grid.Column="7" Text="Actions" Style="{StaticResource HeaderCell}"/>
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="RequestsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RowBorder"
                                            BorderBrush="#EFEFEF" BorderThickness="0,0,0,1"
                                            Background="White" MinHeight="54">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="200"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Style="{StaticResource DataCell}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="User.Name"/>
                                                        <Binding Path="User.Surname"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <TextBlock Grid.Column="1" Style="{StaticResource DataCell}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1}">
                                                        <Binding Path="Building.Street"/>
                                                        <Binding Path="Building.StreetNumber"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <TextBlock Grid.Column="2" Style="{StaticResource DataCell}"
                                                       Text="{Binding Building.Neighborhood}"/>

                                            <TextBlock Grid.Column="3" Style="{StaticResource DataCell}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}, {1}">
                                                        <Binding Path="Building.City.Name"/>
                                                        <Binding Path="Building.City.Country.Name"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <TextBlock Grid.Column="4" Style="{StaticResource DataCell}"
                                                       Text="{Binding UnitNumber}"/>

                                            <TextBlock Grid.Column="5" Style="{StaticResource DataCell}"
                                                       Text="{Binding CreatedAt, StringFormat=dd-MM-yyyy}"/>

                                            <!-- Status badge -->
                                            <Border Grid.Column="6"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    CornerRadius="12" Padding="10,4"
                                                    Background="{Binding StatusBackground}">
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{Binding StatusForeground}"/>
                                            </Border>

                                            <!-- Action buttons -->
                                            <StackPanel Grid.Column="7" Orientation="Horizontal"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Margin="8,0">
                                                <Button Content="Accept"
                                                        Style="{StaticResource ActionButton}"
                                                        Foreground="White" Background="#27AE60"
                                                        Margin="0,0,6,0"
                                                        Tag="{Binding}"
                                                        Visibility="{Binding PendingVisible, Converter={StaticResource BoolToVis}}"
                                                        Click="AcceptButton_Click"/>
                                                <Button Content="Reject"
                                                        Style="{StaticResource ActionButton}"
                                                        Foreground="White" Background="#E74C3C"
                                                        Tag="{Binding}"
                                                        Visibility="{Binding PendingVisible, Converter={StaticResource BoolToVis}}"
                                                        Click="RejectButton_Click"/>
                                                <Button Content="Explanation"
                                                        Width="110" Height="32"
                                                        FontSize="12"
                                                        Foreground="#2C3E50" Background="White"
                                                        BorderBrush="#CCCCCC" BorderThickness="1"
                                                        Cursor="Hand"
                                                        Tag="{Binding}"
                                                        Visibility="{Binding ExplanationVisible, Converter={StaticResource BoolToVis}}"
                                                        Click="ExplanationButton_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6"
                                                                    Padding="8,0">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding AlternateRow}" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#FAFAFA"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Opacity="0.1" ShadowDepth="-2"/>
            </Border.Effect>
            <Button Content="← Back to Buildings"
                    Width="180" Height="40"
                    FontSize="13" FontWeight="SemiBold"
                    Foreground="#2C3E50" Background="White"
                    BorderBrush="#CCCCCC" BorderThickness="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,24,0"
                    Cursor="Hand"
                    Click="BackButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
    </Grid>
</Page>