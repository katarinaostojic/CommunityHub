<Window x:Class="CommunityHub.Ui.Views.ManagerViews.Controls.ManagerOnboardingWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to BuildingHub"
        Height="480" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="White">

    <Border BorderBrush="#DDE3EA" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- SADRZAJ KORAKA -->
            <Grid Grid.Row="0" Margin="50,40,50,20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="StepIconText"
                               FontSize="56"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    <TextBlock x:Name="StepTitleText"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#1A2332"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,14"/>
                    <TextBlock x:Name="StepDescriptionText"
                               FontSize="14" Foreground="#5F6B76"
                               TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="420"/>
                </StackPanel>
            </Grid>

            <!-- INDIKATORI KORAKA (tackice) -->
            <StackPanel x:Name="DotsPanel" Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20"/>

            <!-- DUGMICI -->
            <Grid Grid.Row="2" Margin="30,0,30,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="SkipButton" Content="Skip tour"
                        HorizontalAlignment="Left"
                        Height="38" Width="100"
                        Background="Transparent" Foreground="#7F8C8D"
                        BorderThickness="0" FontSize="13"
                        Cursor="Hand" Click="SkipButton_Click"/>

                <Button Grid.Column="1" x:Name="BackButton" Content="Back"
                        Height="38" Width="90" Margin="0,0,10,0"
                        Background="#F0F0F0" Foreground="#2C3E50"
                        BorderThickness="0" FontSize="13" FontWeight="SemiBold"
                        Cursor="Hand" Click="BackButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" x:Name="NextButton" Content="Next"
                        Height="38" Width="100"
                        Background="#2980B9" Foreground="White"
                        BorderThickness="0" FontSize="13" FontWeight="SemiBold"
                        Cursor="Hand" Click="NextButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>