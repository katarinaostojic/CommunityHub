<Window x:Class="CommunityHub.Ui.Views.ManagerViews.ManagerMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Building Manager" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#2D2D2D">
            <DockPanel>
                <!-- Profile dugme gore -->
                <Button DockPanel.Dock="Top" Height="80" Background="Transparent" 
                        BorderThickness="0" Foreground="White" FontSize="14"
                        Margin="10,20,10,10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="👤" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Profile" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Nav dugmad -->
                <StackPanel DockPanel.Dock="Top" Margin="0,20,0,0">
                    <Button Content="🏢  Buildings" Height="50" Background="Transparent"
                            BorderThickness="0" Foreground="White" FontSize="14"
                            HorizontalContentAlignment="Left" Padding="20,0,0,0"
                            Click="BuildingsButton_Click"/>
                    <Button Content="📋  Access Requests" Height="50" Background="Transparent"
                            BorderThickness="0" Foreground="White" FontSize="14"
                            HorizontalContentAlignment="Left" Padding="20,0,0,0"/>
                    <Button Content="📢  Noticeboard" Height="50" Background="Transparent"
                            BorderThickness="0" Foreground="White" FontSize="14"
                            HorizontalContentAlignment="Left" Padding="20,0,0,0"/>
                    <Button Content="👥  Tenants Assembly" Height="50" Background="Transparent"
                            BorderThickness="0" Foreground="White" FontSize="14"
                            HorizontalContentAlignment="Left" Padding="20,0,0,0"/>
                    <Button Content="⚠️  Problems" Height="50" Background="Transparent"
                            BorderThickness="0" Foreground="White" FontSize="14"
                            HorizontalContentAlignment="Left" Padding="20,0,0,0"/>
                </StackPanel>

                <!-- Help i Logout dole -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" 
                            Margin="10,0,10,20">
                    <Button Content="❓ HELP" Height="50" Width="80" Background="Transparent"
                            BorderThickness="0" Foreground="White" FontSize="12"/>
                    <Button Content="🚪 LOGOUT" Height="50" Width="100" Background="Transparent"
                            BorderThickness="0" Foreground="White" FontSize="12"
                            Click="LogoutButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Frame Grid.Column="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>