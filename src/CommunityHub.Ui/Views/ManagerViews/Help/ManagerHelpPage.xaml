<Page x:Class="CommunityHub.Ui.Views.ManagerViews.ManagerHelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Help"
      Background="#F4F6F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            <Grid Margin="30,0">
                <TextBlock Text="Help &amp; Support"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#2C3E50"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- SADRZAJ -->
        <ScrollViewer Grid.Row="1" Margin="30,25">
            <StackPanel MaxWidth="780">

                <TextBlock Text="Find answers about how to use the Manager Portal."
                           FontSize="14" Foreground="#7F8C8D"
                           Margin="0,0,0,16"/>

                <!-- PRETRAGA -->
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#DDE1E7" BorderThickness="1"
                        Margin="0,0,0,24">
                    <TextBox x:Name="SearchTextBox"
                             Height="42" FontSize="14"
                             Background="Transparent"
                             BorderThickness="0" Padding="14,0"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchTextBox_TextChanged"/>
                </Border>

                <!-- TOPIK LISTA -->
                <ItemsControl x:Name="TopicsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Margin="0,0,0,10"
                                      Background="White"
                                      BorderBrush="#DDE1E7" BorderThickness="1">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Margin="6,8">
                                        <TextBlock Text="{Binding Icon}" FontSize="18"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding Title}" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#2C3E50"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="13" Foreground="#5F6B76"
                                           TextWrapping="Wrap"
                                           Margin="40,0,16,16"/>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="NoResultsText"
                           Text="No help topics match your search."
                           FontSize="13" Foreground="#7F8C8D"
                           FontStyle="Italic"
                           Visibility="Collapsed"
                           Margin="0,10,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>