<Page x:Class="CommunityHub.Ui.Views.ManagerViews.MyBuildingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="My Buildings">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- BUILDINGS GRID -->
        <ScrollViewer Grid.Row="0" Margin="20">
            <StackPanel>
                <TextBlock Text="My registered buildings" FontSize="20" 
                           FontWeight="Bold" HorizontalAlignment="Center" 
                           Margin="0,10,0,20"/>
                <ItemsControl x:Name="BuildingsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="250" Height="220" Margin="15" 
                                    BorderBrush="#CCCCCC" BorderThickness="1"
                                    CornerRadius="8" Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Opacity="0.2"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Image Height="140" Stretch="UniformToFill"/>
                                    <TextBlock Text="{Binding Street}" 
                                               FontWeight="SemiBold"
                                               Margin="10,5,10,0"/>
                                    <TextBlock Text="{Binding City.Name}" 
                                               Foreground="Gray"
                                               Margin="10,2,10,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- REGISTER BUTTON -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <Button Content="Register new building" 
                    Width="220" Height="45"
                    FontSize="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="RegisterBuilding_Click"/>
        </Border>
    </Grid>
</Page>