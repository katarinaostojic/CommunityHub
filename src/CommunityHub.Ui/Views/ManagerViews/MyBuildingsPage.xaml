<Page x:Class="CommunityHub.Ui.Views.ManagerViews.MyBuildingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:CommunityHub.Ui.Converters"
      Title="My Buildings"
      Background="#F4F6F9">

    <Page.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>
            <TextBlock Text="My Registered Buildings" 
                       FontSize="22" FontWeight="Bold"
                       Foreground="#2C3E50"
                       VerticalAlignment="Center"
                       Margin="30,0,0,0"/>
        </Border>

        <!-- BUILDINGS GRID -->
        <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BuildingsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="280" Height="225" Margin="12"
                                Background="White"
                                CornerRadius="12"
                                Cursor="Hand"
                                MouseLeftButtonUp="BuildingCard_Click">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Opacity="0.15" ShadowDepth="3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Slika -->
                                <Border Grid.Row="0" CornerRadius="12,12,0,0" 
                                        Background="#E8EDF2" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="🏢" FontSize="50"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <Image Stretch="UniformToFill"
                                               Source="{Binding Images, Converter={StaticResource ImagePathConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Row="1" Margin="15,10,15,10">
                                    <TextBlock FontSize="14" FontWeight="Bold"
                                            Foreground="#2C3E50" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Street"/>
                                                <Binding Path="StreetNumber"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}, {1}">
                                                <Binding Path="City.Name"/>
                                                <Binding Path="City.Country.Name"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" Opacity="0.1" ShadowDepth="-2"/>
            </Border.Effect>
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <Button x:Name="PrevButton" Content="←" Width="36" Height="36"
                    FontSize="16" Foreground="#2C3E50" Background="White"
                    BorderBrush="#CCCCCC" BorderThickness="1"
                    Cursor="Hand" Margin="0,0,8,0"
                    Click="PrevButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <TextBlock x:Name="PageIndicator" FontSize="13"
                       Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <Button x:Name="NextButton" Content="→" Width="36" Height="36"
                    FontSize="16" Foreground="#2C3E50" Background="White"
                    BorderBrush="#CCCCCC" BorderThickness="1"
                    Cursor="Hand" Margin="8,0,0,0"
                    Click="NextButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <Button Content="+ Register New Building"
                Width="240" Height="45"
                FontSize="14" FontWeight="SemiBold"
                Foreground="White" Background="#2980B9"
                BorderThickness="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="RegisterBuilding_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>