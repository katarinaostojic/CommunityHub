<Window x:Class="CommunityHub.Ui.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KvartApp" Height="600" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="KvartApp" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

        <UniformGrid Grid.Row="1" Columns="2" Rows="5">
            <Button Content="My Districts" Click="MyDistrictsButton_Click"
                    Margin="5" FontSize="14"/>
            <Button Content="Requests" Click="RequestsButton_Click"
                    Margin="5" FontSize="14"/>
            <Button Content="Meetings" Margin="5" FontSize="14"/>
            <Button Content="Forums" Margin="5" FontSize="14"/>
            <Button Content="Budget" Margin="5" FontSize="14"/>
            <Button Content="City Objects" Margin="5" FontSize="14"/>
            <Button Content="Citizen Statistics" Margin="5" FontSize="14"/>
            <Button Content="Reviews" Margin="5" FontSize="14"/>
            <Button Content="City Gifts" Margin="5" FontSize="14"/>
            <Button Content="Log Out" Click="LogoutButton_Click"
                    Margin="5" FontSize="14"/>
        </UniformGrid>
    </Grid>
</Window>