<Window x:Class="CommunityHub.Ui.Views.CitizenViews.CityObjectsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        Title="City Objects"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundLightBrush}">

    <Grid Background="{DynamicResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="174"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Shared NavBar: back/forward strelice + language + theme toggle -->
        <views:CitizenNavBar x:Name="NavBar" Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="24,14,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding ResultsText}"
                           FontSize="28" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <Button Grid.Column="1"
                        Content="{DynamicResource CityObjects_ViewStatistics}"
                        Click="ViewStatisticsButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="52" Padding="20,0"
                        Background="#0D47A1"
                        Foreground="White" BorderThickness="0"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CityObjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,16"
                                    Padding="18" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Slika i ime -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border Width="130" Height="100"
                                                Background="{DynamicResource SurfaceSoftBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="8">
                                            <TextBlock Text="🏛️" FontSize="48"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" Margin="20,0,20,0"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource CityObjects_Votes}"
                                                       FontSize="20" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding VoteCount}" FontSize="20"
                                                       FontWeight="Bold" Margin="8,0,0,0"
                                                       Foreground="#0D47A1"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource CityObjects_LastVisit}"
                                                       FontSize="20" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding LastVisit}" FontSize="20"
                                                       FontWeight="Bold" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Vote dugme -->
                                    <Button Grid.Column="2"
                                            Content="{Binding VoteButtonText}"
                                            Tag="{Binding}"
                                            Click="VoteButton_Click"
                                            FontSize="20" FontWeight="Bold"
                                            Width="160" Height="52"
                                            Background="#0D47A1"
                                            Foreground="White"
                                            BorderThickness="0"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <views:CitizenMenuView x:Name="CitizenMenu"
                               Grid.RowSpan="2"
                               Visibility="Collapsed"
                               Panel.ZIndex="100"/>
    </Grid>
</Window>