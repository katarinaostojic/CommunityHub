<Window x:Class="CommunityHub.Ui.Views.CitizenViews.MyRequestsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        Title="My Requests"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundLightBrush}">

    <Grid Background="{DynamicResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="174"/>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Shared NavBar: back/forward strelice + language + theme toggle -->
        <views:CitizenNavBar x:Name="NavBar" Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="16,16,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="StatusFilterComboBox" Grid.Column="0"
                      Height="52" FontSize="20" FontWeight="Bold"
                      VerticalContentAlignment="Center"
                      BorderBrush="{DynamicResource BorderBrush}"
                      SelectionChanged="Filters_Changed">
                <ComboBoxItem Content="{DynamicResource Requests_All}" IsSelected="True"/>
                <ComboBoxItem Content="{DynamicResource Requests_Pending}"/>
                <ComboBoxItem Content="{DynamicResource Requests_Approved}"/>
                <ComboBoxItem Content="{DynamicResource Requests_Rejected}"/>
            </ComboBox>

            <Button x:Name="SortButton" Grid.Column="2"
                    Content="{Binding SortButtonLabel}"
                    FontSize="20" FontWeight="Bold" Height="52"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" Click="SortButton_Click"/>

            <Button x:Name="ResetButton" Grid.Column="3"
                    Content="{DynamicResource Requests_Reset}"
                    FontSize="20" FontWeight="Bold"
                    Height="52" Width="190" HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Click="ResetButton_Click" Margin="34,0,0,0"/>
        </Grid>

        <Grid Grid.Row="4" Margin="20,8,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding ResultsText}" Grid.Row="0"
                       FontSize="28" FontWeight="Bold" Margin="0,0,0,12"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Requests}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,16"
                                    Padding="18" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="380"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="190"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding NeighborhoodName}"
                                                   FontSize="24" FontWeight="Bold"
                                                   HorizontalAlignment="Left"
                                                   Width="340"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,0,0,8"/>

                                        <Border Width="340" Height="210"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                Background="{DynamicResource SurfaceSoftBrush}">
                                            <Image Stretch="Fill">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Source" Value="/Images/neighborhoods/liman.jpg"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeighborhoodName}" Value="Dorcol">
                                                                <Setter Property="Source" Value="/Images/neighborhoods/dorcol.jpg"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NeighborhoodName}" Value="Liman">
                                                                <Setter Property="Source" Value="/Images/neighborhoods/liman.jpg"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NeighborhoodName}" Value="Liman 3">
                                                                <Setter Property="Source" Value="/Images/neighborhoods/liman.jpg"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NeighborhoodName}" Value="Podbara">
                                                                <Setter Property="Source" Value="/Images/neighborhoods/podbara.jpg"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,8,20,10"
                                                VerticalAlignment="Top">

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                                            <TextBlock Text="{Binding CreatedAtFormatted}"
                                                       FontSize="22" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                            <Border CornerRadius="12"
                                                    Background="{Binding StatusBrush}"
                                                    Padding="14,4"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           FontSize="20" FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding RejectionVisibility}">
                                            <TextBlock Text="&#xE8C9;" FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{DynamicResource DangerBrush}"/>
                                            <TextBlock Text="{Binding RejectionReason}"
                                                       FontSize="22" FontWeight="Bold"
                                                       Width="380" TextWrapping="Wrap"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom"
                                                HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource Requests_Delete}"
                                                Width="170" Height="60"
                                                FontSize="20" FontWeight="Bold"
                                                Background="{DynamicResource DangerBrush}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Visibility="{Binding DeleteVisibility}"
                                                Click="DeleteRequestButton_Click"
                                                Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <views:CitizenMenuView x:Name="CitizenMenu"
                               Grid.RowSpan="5"
                               Visibility="Collapsed"
                               Panel.ZIndex="100"/>
    </Grid>
</Window>