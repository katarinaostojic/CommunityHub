<Window x:Class="CommunityHub.Ui.Views.CitizenViews.MyRequestsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        Title="My Requests"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#ECECEF">

    <Window.Resources>
        <Style x:Key="SmallCalendarStyle" TargetType="{x:Type Calendar}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="250"/>
        </Style>

        <Style x:Key="SmallDatePickerTextBoxStyle" TargetType="{x:Type DatePickerTextBox}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4,6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SmallDatePickerStyle" TargetType="{x:Type DatePicker}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DatePicker}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="White"
                                    BorderBrush="#444"
                                    BorderThickness="1.5">
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Style="{StaticResource SmallDatePickerTextBoxStyle}"/>
                            </Border>

                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Width="44"
                                    Height="38"
                                    Background="White"
                                    BorderBrush="#444"
                                    BorderThickness="1.5"
                                    Focusable="False">
                                <TextBlock Text="▦"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   StaysOpen="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="White"
                                        BorderBrush="#444"
                                        BorderThickness="1.5"
                                        Padding="6">
                                    <Calendar Style="{StaticResource SmallCalendarStyle}"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#ECECEF">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="78"/>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- WEB TOP -->
        <Border Grid.Row="0" Background="#D8D8D8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1">
            <Border Width="130"
                    Height="28"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="14,0,0,0"
                    Background="#F4F4F4"
                    BorderBrush="#A0A0A0"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock Text="A Web Page"
                           FontSize="18"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Border>
        </Border>

        <!-- ADDRESS BAR -->
        <Grid Grid.Row="1" Background="#ECECEC">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0">
                <TextBlock Text="←" FontSize="24" FontWeight="Bold" Margin="0,0,18,0"/>
                <TextBlock Text="→" FontSize="24" FontWeight="Bold" Margin="0,0,18,0"/>
                <TextBlock Text="⟳" FontSize="24" FontWeight="Bold"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Margin="10,6,18,6"
                    Background="White"
                    BorderBrush="#2F2F2F"
                    BorderThickness="2"
                    CornerRadius="18">
                <TextBlock Text="https://"
                           FontSize="20"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
            </Border>
        </Grid>

        <!-- HEADER -->
        <Border Grid.Row="2" Background="#F4F4F4" BorderBrush="#4A4A4A" BorderThickness="0,2,0,2">
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="BurgerButton"
                        Content="☰"
                        Click="BurgerButton_Click"
                        FontSize="32"
                        FontWeight="Bold"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="60"
                        Height="60"
                        VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="My requests"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="👤"
                               FontSize="26"
                               Margin="0,0,8,0"/>
                    <TextBlock x:Name="LoggedInUserTextBlock"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTERS -->
        <Grid Grid.Row="3" Margin="16,16,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="184"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="StatusFilterComboBox"
                      Grid.Column="0"
                      Height="38"
                      Width="220"
                      FontSize="18"
                      FontWeight="Bold"
                      VerticalContentAlignment="Center"
                      SelectionChanged="Filters_Changed">
                <ComboBoxItem Content="All" IsSelected="True"/>
                <ComboBoxItem Content="Pending approval"/>
                <ComboBoxItem Content="Approved"/>
                <ComboBoxItem Content="Rejected"/>
            </ComboBox>

            <DatePicker x:Name="RequestDatePicker"
                        Grid.Column="2"
                        Width="184"
                        SelectedDateChanged="Filters_Changed"
                        Style="{StaticResource SmallDatePickerStyle}"
                        VerticalAlignment="Center"/>

            <Button x:Name="ResetButton"
                    Grid.Column="5"
                    Content="Reset"
                    FontSize="18"
                    FontWeight="Bold"
                    Height="48"
                    Width="150"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#F8F8F8"
                    BorderBrush="#444"
                    BorderThickness="2"
                    Click="ResetButton_Click"/>
        </Grid>

        <!-- CONTENT -->
        <Grid Grid.Row="4" Margin="20,8,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="ResultsTextBlock"
                       Grid.Row="0"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,12"/>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RequestsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#4F4F4F"
                                    BorderThickness="2"
                                    Background="#F9F9F9"
                                    Margin="0,0,0,14"
                                    Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="380"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT IMAGE -->
                                    <StackPanel Grid.Column="0">
                                        <Border Width="340"
                                                Height="210"
                                                BorderBrush="#2F2F2F"
                                                BorderThickness="2"
                                                Background="White">
                                            <Image Stretch="Fill">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Source" Value="/images/neighborhoods/liman.jpg"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeighborhoodName}" Value="Dorcol">
                                                                <Setter Property="Source" Value="/images/neighborhoods/dorcol.jpg"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NeighborhoodName}" Value="Liman">
                                                                <Setter Property="Source" Value="/images/neighborhoods/liman.jpg"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NeighborhoodName}" Value="Liman 3">
                                                                <Setter Property="Source" Value="/images/neighborhoods/liman.jpg"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NeighborhoodName}" Value="Podbara">
                                                                <Setter Property="Source" Value="/images/neighborhoods/podbara.jpg"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Border>

                                        <TextBlock Text="{Binding NeighborhoodName}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <!-- MIDDLE INFO -->
                                    <StackPanel Grid.Column="1"
                                                Margin="10,30,20,10"
                                                VerticalAlignment="Top">

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,34">
                                            <TextBlock Text="Request Date:"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Width="220"/>
                                            <TextBlock Text="{Binding CreatedAtFormatted}"
                                                       FontSize="22"
                                                       FontWeight="Bold"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                            <TextBlock Text="Status:"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Width="220"/>
                                            <Ellipse Width="26"
                                                     Height="26"
                                                     Fill="{Binding StatusBrush}"
                                                     Stroke="Black"
                                                     StrokeThickness="1.5"
                                                     Margin="0,2,12,0"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="22"
                                                       FontWeight="Bold"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding RejectionVisibility}">
                                            <TextBlock Text="Reason:"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Width="220"/>
                                            <TextBlock Text="{Binding RejectionReason}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Width="420"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- RIGHT BUTTON -->
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Right">
                                        <Button Content="Delete"
                                                Width="150"
                                                Height="52"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Background="White"
                                                BorderBrush="#3A3A3A"
                                                BorderThickness="2"
                                                Visibility="{Binding DeleteVisibility}"
                                                Click="DeleteRequestButton_Click"
                                                Tag="{Binding Id}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <views:CitizenMenuView x:Name="CitizenMenu"
                               Grid.RowSpan="5"
                               Visibility="Collapsed"
                               Panel.ZIndex="100"/>
    </Grid>
</Window>