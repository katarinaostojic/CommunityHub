<Window x:Class="CommunityHub.Ui.Views.CitizenViews.MyRequestsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        Title="My Requests"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundLightBrush}">

    <Grid Background="{StaticResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="78"/>
            <RowDefinition Height="82"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#BBDEFB"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Border Width="130" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="14,0,0,0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <TextBlock Text="A Web Page" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>
        </Border>

        <Grid Grid.Row="1" Background="#E3F2FD">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="←" FontSize="24" FontWeight="Bold" Margin="0,0,18,0"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="→" FontSize="24" FontWeight="Bold" Margin="0,0,18,0"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="⟳" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="10,6,18,6" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" CornerRadius="18">
                <TextBlock Text="https://" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BurgerButton"
                        Content="☰" Click="BurgerButton_Click"
                        FontSize="32" FontWeight="Bold"
                        Background="Transparent" BorderThickness="0"
                        Width="60" Height="60" VerticalAlignment="Center"
                        Foreground="#0D47A1"/>

                <TextBlock Grid.Column="1" Text="My Requests"
                           FontSize="28" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="ProfileButton_Click"
                            Background="Transparent"
                            BorderThickness="0" Padding="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="32" Margin="0,0,6,0"/>
                            <TextBlock x:Name="LoggedInUserTextBlock" FontSize="22"
                                       FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="16,16,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="StatusFilterComboBox" Grid.Column="0"
                      Height="52" FontSize="20" FontWeight="Bold"
                      VerticalContentAlignment="Center"
                      BorderBrush="{StaticResource BorderBrush}"
                      SelectionChanged="Filters_Changed">
                <ComboBoxItem Content="All" IsSelected="True"/>
                <ComboBoxItem Content="Pending approval"/>
                <ComboBoxItem Content="Approved"/>
                <ComboBoxItem Content="Rejected"/>
            </ComboBox>

            <Button x:Name="SortButton" Grid.Column="2"
                    Content="{Binding SortButtonLabel}"
                    FontSize="20" FontWeight="Bold" Height="52"
                    Background="{StaticResource SurfaceBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Click="SortButton_Click"/>

            <Button x:Name="ResetButton" Grid.Column="4"
                    Content="↺ Reset" FontSize="20" FontWeight="Bold"
                    Height="52" Width="190" HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Click="ResetButton_Click"/>
        </Grid>

        <Grid Grid.Row="4" Margin="20,8,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding ResultsText}" Grid.Row="0"
                       FontSize="28" FontWeight="Bold" Margin="0,0,0,12"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Requests}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Background="{StaticResource SurfaceBrush}" Margin="0,0,0,16"
                                    Padding="18" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="380"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="190"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding NeighborhoodName}"
                                                   FontSize="24" FontWeight="Bold"
                                                   HorizontalAlignment="Left"
                                                   Width="340"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="0,0,0,8"/>

                                        <Border Width="340" Height="210"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                Background="#E3F2FD">
                                            <Image Stretch="Fill">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Source" Value="/images/neighborhoods/liman.jpg"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeighborhoodName}" Value="Dorcol">
                                                                <Setter Property="Source" Value="/images/neighborhoods/dorcol.jpg"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NeighborhoodName}" Value="Liman">
                                                                <Setter Property="Source" Value="/images/neighborhoods/liman.jpg"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NeighborhoodName}" Value="Liman 3">
                                                                <Setter Property="Source" Value="/images/neighborhoods/liman.jpg"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NeighborhoodName}" Value="Podbara">
                                                                <Setter Property="Source" Value="/images/neighborhoods/podbara.jpg"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,8,20,10"
                                                VerticalAlignment="Top">

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                            <TextBlock Text="📅" FontSize="26"
                                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CreatedAtFormatted}"
                                                       FontSize="22" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                            <Border CornerRadius="12"
                                                    Background="{Binding StatusBrush}"
                                                    Padding="14,4"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           FontSize="20" FontWeight="Bold"
                                                           Foreground="White"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding RejectionVisibility}">
                                            <TextBlock Text="❌" FontSize="26"
                                                       Margin="0,0,10,0" VerticalAlignment="Top"/>
                                            <TextBlock Text="{Binding RejectionReason}"
                                                       FontSize="22" FontWeight="Bold"
                                                       Width="380" TextWrapping="Wrap"
                                                       VerticalAlignment="Top"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom"
                                                HorizontalAlignment="Right">
                                        <Button Content="🗑 Delete"
                                                Width="170" Height="60"
                                                FontSize="20" FontWeight="Bold"
                                                Background="{StaticResource DangerBrush}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Visibility="{Binding DeleteVisibility}"
                                                Click="DeleteRequestButton_Click"
                                                Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <views:CitizenMenuView x:Name="CitizenMenu"
                               Grid.RowSpan="5"
                               Visibility="Collapsed"
                               Panel.ZIndex="100"/>
    </Grid>
</Window>