<Window x:Class="CommunityHub.Ui.Views.CitizenViews.MeetingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        Title="Neighborhood Meetings"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundLightBrush}">

    <Grid Background="{DynamicResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="174"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Shared NavBar: back/forward strelice + language + theme toggle -->
        <views:CitizenNavBar x:Name="NavBar" Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="24,14,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding ResultsText}"
                       FontSize="28" FontWeight="Bold"
                       Margin="0,0,0,14" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Meetings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,16"
                                    Padding="18" CornerRadius="12">
                                <StackPanel>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Theme}"
                                                   FontSize="24" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                                        <Border Grid.Column="1"
                                                CornerRadius="12"
                                                Background="{Binding StatusBrush}"
                                                Padding="14,4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusDisplay}"
                                                       FontSize="16" FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                                        <TextBlock Text="{Binding MeetingTime}" FontSize="18" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding DateRangeVisibility}"
                                                Margin="0,0,0,8">
                                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                                        <TextBlock Text="{Binding DateRangeStart}" FontSize="18" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text=" — " FontSize="18" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding DateRangeEnd}" FontSize="18" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding ScheduledDateVisibility}"
                                                Margin="0,0,0,8">
                                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                                        <TextBlock Text="{Binding ScheduledDate}" FontSize="18" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding VotedDateVisibility}"
                                                Margin="0,0,0,12">
                                        <TextBlock Text="✔" FontSize="18" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource SuccessTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CitizenVotedDate}" FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource Meetings_Vote}"
                                                Tag="{Binding}"
                                                Click="VoteButton_Click"
                                                FontSize="20" FontWeight="Bold"
                                                Height="52" Padding="20,0"
                                                Background="#0D47A1"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Margin="0,0,8,0"
                                                Visibility="{Binding VoteVisibility}"/>

                                        <Button Content="{DynamicResource Meetings_ChangeVote}"
                                                Tag="{Binding}"
                                                Click="ChangeVoteButton_Click"
                                                FontSize="18" FontWeight="Bold"
                                                Height="52" Padding="20,0"
                                                Background="#F9A825"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Visibility="{Binding ChangeVoteVisibility}"/>
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <views:CitizenMenuView x:Name="CitizenMenu"
                               Grid.RowSpan="2"
                               Visibility="Collapsed"
                               Panel.ZIndex="100"/>
    </Grid>
</Window>