<Window x:Class="CommunityHub.Ui.Views.CitizenViews.MeetingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        Title="Neighborhood Meetings"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#ECECEF">

    <Grid Background="#ECECEF">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#D8D8D8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1">
            <Border Width="130" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="14,0,0,0" Background="#F4F4F4" BorderBrush="#A0A0A0"
                    BorderThickness="1" CornerRadius="8">
                <TextBlock Text="A Web Page" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Border>

        <Grid Grid.Row="1" Background="#ECECEC">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="←" FontSize="24" FontWeight="Bold" Margin="0,0,18,0"/>
                <TextBlock Text="→" FontSize="24" FontWeight="Bold" Margin="0,0,18,0"/>
                <TextBlock Text="⟳" FontSize="24" FontWeight="Bold"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="10,6,18,6" Background="White"
                    BorderBrush="#2F2F2F" BorderThickness="2" CornerRadius="18">
                <TextBlock Text="https://" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#F4F4F4" BorderBrush="#4A4A4A" BorderThickness="0,2,0,2">
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="☰" Click="BurgerButton_Click"
                        FontSize="32" FontWeight="Bold" Background="Transparent"
                        BorderThickness="0" Width="60" Height="60" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="Neighborhood Meetings"
                           FontSize="28" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="ProfileButton_Click"
                            Background="Transparent"
                            BorderThickness="0" Padding="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="32" Margin="0,0,6,0"/>
                            <TextBlock x:Name="LoggedInUserTextBlock" FontSize="22"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="24,14,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding ResultsText}"
                       FontSize="28" FontWeight="Bold"
                       Margin="0,0,0,14" VerticalAlignment="Center"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Meetings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#4F4F4F" BorderThickness="2"
                                    Background="#F9F9F9" Margin="0,0,0,16"
                                    Padding="18" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- LEFT -->
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="{Binding Theme}"
                                                   FontSize="24" FontWeight="Bold"
                                                   Margin="0,0,0,12"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="🕐 Time: " FontSize="18" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding MeetingTime}" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>

                                        <!-- Date range for in preparation -->
                                        <StackPanel Visibility="{Binding DateRangeVisibility}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="📅 Date range: " FontSize="18" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding DateRangeStart}" FontSize="18" FontWeight="Bold"/>
                                                <TextBlock Text=" - " FontSize="18" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding DateRangeEnd}" FontSize="18" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Scheduled date -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding ScheduledDateVisibility}"
                                                    Margin="0,0,0,8">
                                            <TextBlock Text="📅 Scheduled date: " FontSize="18" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding ScheduledDate}" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>

                                        <!-- Voted date -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding VotedDateVisibility}"
                                                    Margin="0,0,0,8">
                                            <TextBlock Text="✔ Your vote: " FontSize="18"
                                                       FontWeight="Bold" Foreground="#27AE60"/>
                                            <TextBlock Text="{Binding CitizenVotedDate}" FontSize="18"
                                                       FontWeight="Bold" Foreground="#27AE60"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- MIDDLE -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡ Status: " FontSize="18" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- RIGHT -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <Button Content="Vote"
                                                Tag="{Binding}"
                                                Click="VoteButton_Click"
                                                FontSize="20" FontWeight="Bold"
                                                Width="140" Height="52"
                                                Background="#2C3E50"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Margin="0,0,0,8"
                                                Visibility="{Binding VoteVisibility}"/>

                                        <Button Content="Change Vote"
                                                Tag="{Binding}"
                                                Click="ChangeVoteButton_Click"
                                                FontSize="18" FontWeight="Bold"
                                                Width="140" Height="52"
                                                Background="#E67E22"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Visibility="{Binding ChangeVoteVisibility}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <views:CitizenMenuView x:Name="CitizenMenu"
                               Grid.RowSpan="4"
                               Visibility="Collapsed"
                               Panel.ZIndex="100"/>
    </Grid>
</Window>