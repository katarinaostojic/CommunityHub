<Window x:Class="CommunityHub.Ui.Views.CitizenViews.EventsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        Title="Neighborhood Events"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundLightBrush}">

    <Grid Background="{DynamicResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="174"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:CitizenNavBar x:Name="NavBar" Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="24,14,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar: naslov + dugmad, auto-size da stanu i na engleskom -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding ResultsText}"
                           FontSize="24" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <Button Grid.Column="1"
                        Content="{DynamicResource Events_ViewCitizens}"
                        Click="ViewCitizensButton_Click"
                        FontSize="16" FontWeight="Bold"
                        Height="46" Padding="14,0"
                        Background="#0D47A1"
                        Foreground="White" BorderThickness="0"/>

                <Button Grid.Column="3"
                        Content="{DynamicResource Events_ViewMeetings}"
                        Click="ViewMeetingsButton_Click"
                        FontSize="16" FontWeight="Bold"
                        Height="46" Padding="14,0"
                        Background="#0D47A1"
                        Foreground="White" BorderThickness="0"/>

                <Button Grid.Column="5"
                        Content="{DynamicResource Events_CoordinatorReviews}"
                        Click="CoordinatorReviewsButton_Click"
                        FontSize="16" FontWeight="Bold"
                        Height="46" Padding="14,0"
                        Background="#0D47A1"
                        Foreground="White" BorderThickness="0"/>

                <Button Grid.Column="7"
                        Content="{DynamicResource Events_CreateEvent}"
                        Click="CreateEventButton_Click"
                        FontSize="16" FontWeight="Bold"
                        Height="46" Padding="14,0"
                        Background="#F9A825"
                        Foreground="White" BorderThickness="0"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Events}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,16"
                                    Padding="18" CornerRadius="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Border Background="#F9A825" CornerRadius="4" Padding="8,4"
                                                    Margin="0,0,10,0" Visibility="{Binding OrganizerVisibility}">
                                                <TextBlock Text="{DynamicResource Events_Organizer}"
                                                           FontSize="14" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="12"
                                                Background="{Binding StatusColor}" Padding="14,4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusDisplay}"
                                                       FontSize="16" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding Description}" FontSize="18" TextWrapping="Wrap"
                                               Margin="0,0,0,12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                                            <TextBlock Text="{Binding EventDate}" FontSize="18" FontWeight="Bold"
                                                       VerticalAlignment="Center" Margin="0,0,20,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                                            <TextBlock Text="{Binding StartTime}" FontSize="18" FontWeight="Bold"
                                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="·" FontSize="18" FontWeight="Bold"
                                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding DurationMinutes}" FontSize="18" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text=" min" FontSize="18" FontWeight="Bold"
                                                       VerticalAlignment="Center" Margin="0,0,20,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                                            <TextBlock Text="{Binding VolunteerCount}" FontSize="18" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="/" FontSize="18" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding MinVolunteers}" FontSize="18" FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{DynamicResource Events_Join}"
                                                Tag="{Binding}" Click="JoinButton_Click"
                                                FontSize="20" FontWeight="Bold"
                                                Width="140" Height="50"
                                                Background="#0D47A1" Foreground="White" BorderThickness="0"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding JoinVisibility}"/>
                                    </Grid>

                                    <Border Margin="0,12,0,0" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,1,0,0" Padding="0,12,0,0"
                                            Visibility="{Binding AttendanceVisibility}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Events_MarkAttendance}"
                                                       FontSize="18" FontWeight="Bold" Margin="0,0,0,8"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding AttendanceItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                            <TextBlock Text="{Binding CitizenFullName}"
                                                                       FontSize="18" FontWeight="Bold"
                                                                       Width="200" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding AttendanceDisplay}"
                                                                       FontSize="16" Width="150"
                                                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                                                       Foreground="{Binding AttendanceColor}"/>
                                                            <Button Content="{DynamicResource Events_Attended}"
                                                                    Tag="{Binding}" FontSize="16" FontWeight="Bold"
                                                                    Height="36" Padding="10,0" Background="#1A5C2A"
                                                                    Foreground="White" BorderThickness="0"
                                                                    Margin="0,0,8,0" Click="MarkAttendedButton_Click"/>
                                                            <Button Content="{DynamicResource Events_Absent}"
                                                                    Tag="{Binding}" FontSize="16" FontWeight="Bold"
                                                                    Height="36" Padding="10,0" Background="#B54A4A"
                                                                    Foreground="White" BorderThickness="0"
                                                                    Click="MarkAbsentButton_Click"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <views:CitizenMenuView x:Name="CitizenMenu"
                               Grid.RowSpan="2"
                               Visibility="Collapsed"
                               Panel.ZIndex="100"/>
    </Grid>
</Window>
