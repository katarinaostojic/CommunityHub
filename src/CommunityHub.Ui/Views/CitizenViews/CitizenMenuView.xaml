<UserControl x:Class="CommunityHub.Ui.Views.CitizenViews.CitizenMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1280">

    <Grid Background="#66000000">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Menu"
                           FontSize="34"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#2E2E2E"/>

                <StackPanel Grid.Row="2" VerticalAlignment="Top">
                    <Button Content="● Neighborhoods"
                            Tag="Neighborhoods"
                            Click="MenuItem_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="#2E2E2E"
                            Padding="0"
                            Margin="0,0,0,28"/>

                    <Button Content="● My Requests"
                            Tag="MyRequests"
                            Click="MenuItem_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="#2E2E2E"
                            Padding="0"
                            Margin="0,0,0,28"/>

                    <Button Content="● Events"
                            Tag="Events"
                            Click="MenuItem_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="#2E2E2E"
                            Padding="0"
                            Margin="0,0,0,28"/>

                    <Button Content="● Citizens"
                            Tag="Citizens"
                            Click="MenuItem_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="#2E2E2E"
                            Padding="0"
                            Margin="0,0,0,28"/>

                    <Button Content="● Meetings"
                            Tag="Meetings"
                            Click="MenuItem_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="#2E2E2E"
                            Padding="0"
                            Margin="0,0,0,28"/>

                    <Button Content="● City Objects"
                            Tag="CityObjects"
                            Click="MenuItem_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="#2E2E2E"
                            Padding="0"
                            Margin="0,0,0,28"/>

                    <Button Content="● Budget"
                            Tag="Budget"
                            Click="MenuItem_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="#2E2E2E"
                            Padding="0"
                            Margin="0,0,0,28"/>
                </StackPanel>

                <StackPanel Grid.Row="3"
                            Margin="0,20,0,10"
                            HorizontalAlignment="Center">
                    <Button Width="90"
                            Height="90"
                            FontSize="42"
                            FontWeight="Bold"
                            Content="↪"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="Logout_Click"/>
                    <TextBlock Text="Logout"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Foreground="#2E2E2E"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="Transparent"
                MouseLeftButtonDown="Overlay_MouseLeftButtonDown"/>
    </Grid>
</UserControl>