<UserControl x:Class="CommunityHub.Ui.Views.CitizenViews.CitizenMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1280">

    <Grid Background="#66000000">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Menu"
                           FontSize="34"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#0D47A1"/>

                <StackPanel Grid.Row="2" VerticalAlignment="Top">
                    <Button Tag="Neighborhoods" Click="MenuItem_Click"
                            Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            FontSize="22" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Padding="0" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏘️" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Menu_Neighborhoods}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="MyRequests" Click="MenuItem_Click"
                            Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            FontSize="22" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Padding="0" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Menu_MyRequests}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="Events" Click="MenuItem_Click"
                            Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            FontSize="22" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Padding="0" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎪" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Menu_Events}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="Citizens" Click="MenuItem_Click"
                            Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            FontSize="22" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Padding="0" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Menu_Citizens}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="Meetings" Click="MenuItem_Click"
                            Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            FontSize="22" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Padding="0" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🤝" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Menu_Meetings}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="CityObjects" Click="MenuItem_Click"
                            Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            FontSize="22" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Padding="0" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏛️" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Menu_CityObjects}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Tag="Budget" Click="MenuItem_Click"
                            Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Left"
                            FontSize="22" FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Padding="0" Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Menu_Budget}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3"
                            Margin="0,20,0,10"
                            HorizontalAlignment="Center">
                    <Button Width="90" Height="90"
                            FontSize="42" FontWeight="Bold"
                            Content="↪"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#0D47A1"
                            Click="Logout_Click"/>
                    <TextBlock Text="{DynamicResource Menu_Logout}"
                               FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="Transparent"
                MouseLeftButtonDown="Overlay_MouseLeftButtonDown"/>
    </Grid>
</UserControl>