<Window x:Class="CommunityHub.Ui.Views.CitizenViews.MyProfilePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        Title="My Profile"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundLightBrush}">

    <Grid Background="{DynamicResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="174"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Shared NavBar — već ima language + theme toggle ugrađen -->
        <views:CitizenNavBar x:Name="NavBar" Grid.Row="0"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30,40,30" DataContext="{Binding TrustRecord}">

                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="80" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{DynamicResource IconForegroundBrush}"/>

                <TextBlock x:Name="UsernameText"
                           FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="30" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Profile_MemberSince}" FontSize="22"
                                       FontWeight="Bold" Width="300"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding JoinedAt}" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Profile_EventsOrganized}" FontSize="22"
                                       FontWeight="Bold" Width="300"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding EventsOrganized}" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Profile_EventsVolunteered}" FontSize="22"
                                       FontWeight="Bold" Width="300"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding EventsVolunteered}" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="{DynamicResource Profile_Neighborhood}" FontSize="22"
                                       FontWeight="Bold" Width="300"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="NeighborhoodNameText" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Profile_TrustLevel}" FontSize="22"
                                       FontWeight="Bold" Width="300" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border CornerRadius="12" Background="{Binding LevelBrush}"
                                    Padding="14,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LevelDisplay}" FontSize="20" FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="30" Margin="0,0,0,20">
                    <StackPanel HorizontalAlignment="Center">
                        <Canvas x:Name="PieCanvas" Width="220" Height="220"
                                HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="{DynamicResource Profile_OrganizedVsVolunteered}"
                                   FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Rectangle Width="20" Height="20" Fill="#0D47A1"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Profile_Organized}" FontSize="18" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,20,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Rectangle Width="20" Height="20" Fill="#BBDEFB"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Profile_Volunteered}" FontSize="18" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <views:CitizenMenuView x:Name="CitizenMenu"
                               Grid.RowSpan="2"
                               Visibility="Collapsed"
                               Panel.ZIndex="100"/>
    </Grid>
</Window>
