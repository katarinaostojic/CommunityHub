<Window x:Class="CommunityHub.Ui.Views.CitizenViews.BudgetPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        Title="Budget"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundLightBrush}">

    <Grid Background="{DynamicResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="174"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Shared NavBar -->
        <views:CitizenNavBar x:Name="NavBar"
                             Grid.Row="0"/>

        <!-- Sadržaj -->
        <Grid Grid.Row="1" Margin="24,14,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Total budget i dugmad -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Budget_TotalBudget}"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding TotalBudgetDisplay}"
                               FontSize="26" FontWeight="Bold"
                               Margin="8,0,0,0" Foreground="#0D47A1"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{DynamicResource Budget_SpendingHistory}"
                        Click="SpendingHistoryButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="52" Padding="20,0"
                        Background="#0D47A1"
                        Foreground="White" BorderThickness="0"/>

                <Button Grid.Column="3"
                        Content="{DynamicResource Budget_Donate}"
                        Click="DonateButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="52" Padding="20,0"
                        Background="#F9A825"
                        Foreground="White" BorderThickness="0"/>
            </Grid>

            <TextBlock Grid.Row="1" Text="{DynamicResource Budget_ByCategory}"
                       FontSize="22" FontWeight="Bold"
                       Margin="0,0,0,14"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CategoryBudgets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,12"
                                    Padding="20,14" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CategoryName}"
                                               FontSize="22" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               FontSize="22" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="#0D47A1">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:0.##} RSD">
                                                <Binding Path="Budget"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Meni overlay sa hover efektom na pozadini -->
        <views:CitizenMenuView x:Name="CitizenMenu"
                               Grid.RowSpan="2"
                               Visibility="Collapsed"
                               Panel.ZIndex="100"/>
    </Grid>
</Window>
