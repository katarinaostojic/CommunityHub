<Window x:Class="CommunityHub.Ui.Views.CitizenViews.CoordinatorReviewsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        Title="Coordinator Reviews"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundLightBrush}">

    <Grid Background="{DynamicResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="174"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:CitizenNavBar x:Name="NavBar" Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="24,14,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Reviews_Coordinator}" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding CoordinatorName}" FontSize="24" FontWeight="Bold"
                               Margin="8,0,0,0" Foreground="#0D47A1"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="{DynamicResource Reviews_RateButton}"
                        Click="RateCoordinatorButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="52" Padding="20,0"
                        Background="#F9A825"
                        Foreground="White" BorderThickness="0"/>
            </Grid>

            <TextBlock Grid.Row="1" Text="{Binding ResultsText}"
                       FontSize="22" FontWeight="Bold"
                       Margin="0,0,0,14"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Reviews}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,16"
                                    Padding="18" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="&#xE77B;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="50"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource IconForegroundBrush}"/>
                                        <TextBlock Text="{Binding CitizenFullName}"
                                                   FontSize="16" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="20,0,20,0"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{DynamicResource Reviews_Rating}"
                                                       FontSize="20" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding RatingStars}" FontSize="20"
                                                       Margin="8,0,0,0" Foreground="#F9A825"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                                    Visibility="{Binding CommentVisibility}">
                                            <TextBlock Text="{DynamicResource Reviews_Comment}"
                                                       FontSize="18" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Comment}" FontSize="18"
                                                       TextWrapping="Wrap" Width="400"
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{DynamicResource Reviews_Reports}"
                                                       FontSize="18" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding ReportCount}" FontSize="18"
                                                       Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding CreatedAt}" FontSize="16"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button Content="{DynamicResource Reviews_ReportButton}"
                                                Tag="{Binding}"
                                                Click="ReportButton_Click"
                                                FontSize="18" FontWeight="Bold"
                                                Height="46" Padding="16,0"
                                                Background="{DynamicResource DangerBrush}"
                                                Foreground="White" BorderThickness="0"
                                                Visibility="{Binding ReportVisibility}"/>
                                        <TextBlock Text="{DynamicResource Reviews_Reported}"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding ReportedVisibility}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <views:CitizenMenuView x:Name="CitizenMenu"
                               Grid.RowSpan="2"
                               Visibility="Collapsed"
                               Panel.ZIndex="100"/>
    </Grid>
</Window>
