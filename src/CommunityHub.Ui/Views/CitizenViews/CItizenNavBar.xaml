<UserControl x:Class="CommunityHub.Ui.Views.CitizenViews.CitizenNavBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="174" d:DesignWidth="1280">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="78"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Tab bar simulacija -->
        <Border Grid.Row="0" Background="{DynamicResource PrimarySoftBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Border Width="130" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="14,0,0,0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <TextBlock Text="CommunityHub" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>
        </Border>

        <!-- Row 1: Browser nav bar sa FUNKCIONALNIM strelicama -->
        <Grid Grid.Row="1" Background="{DynamicResource SurfaceSoftBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="14,0,0,0">

                <!-- Nazad dugme -->
                <Button x:Name="BackButton"
                        Width="36" Height="36"
                        Margin="0,0,6,0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Nazad"
                        Click="BackButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.3"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="←" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource IconForegroundBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Napred dugme -->
                <Button x:Name="ForwardButton"
                        Width="36" Height="36"
                        Margin="0,0,6,0"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Napred"
                        Click="ForwardButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.3"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="→" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource IconForegroundBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Reload -->
                <Button Width="32" Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Osveži"
                        Click="ReloadButton_Click">
                    <TextBlock Text="⟳" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>

            <!-- URL bar -->
            <Border Grid.Column="1" Margin="10,6,18,6"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="2" CornerRadius="18">
                <TextBlock x:Name="UrlTextBlock"
                           Text="communityhub://home"
                           FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
        </Grid>

        <!-- Row 2: App nav bar sa burger, jezikom, temom, naslovom, profilom -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1">
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Burger meni -->
                <Button Grid.Column="0" Content="☰"
                        Click="BurgerButton_Click"
                        FontSize="32" FontWeight="Bold"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="60" Height="60"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource PrimaryBrush}"/>

                <!-- Language toggle LEVO od naslova -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <Image Source="/Images/flags/SrFlag.png"
                           Width="28" Height="20" Margin="0,0,5,0"/>
                    <ToggleButton x:Name="LanguageToggleButton"
                                  Width="52" Height="26"
                                  Click="LanguageToggle_Click">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="track" CornerRadius="13"
                                        Background="#B0BEC5" Width="52" Height="26">
                                    <Border x:Name="thumb" Width="22" Height="22"
                                            CornerRadius="11" Background="White"
                                            HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="track" Property="Background" Value="#0D47A1"/>
                                        <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <Image Source="/Images/flags/EnFlag.png"
                           Width="28" Height="20" Margin="5,0,0,0"/>
                </StackPanel>

                <!-- Naslov stranice — binduje se iz code-behind -->
                <TextBlock x:Name="PageTitleTextBlock"
                           Grid.Column="2"
                           Text=""
                           FontSize="26" FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- Theme toggle DESNO -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="☀️" FontSize="18" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                    <ToggleButton x:Name="ThemeToggleButton"
                                  Width="52" Height="26"
                                  Click="ThemeToggle_Click">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="track" CornerRadius="13"
                                        Background="#B0BEC5" Width="52" Height="26">
                                    <Border x:Name="thumb" Width="22" Height="22"
                                            CornerRadius="11" Background="White"
                                            HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="track" Property="Background" Value="#263238"/>
                                        <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <TextBlock Text="🌙" FontSize="18" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                </StackPanel>

                <!-- Profil dugme KRAJNJE DESNO -->
                <Button Grid.Column="4"
                        Background="Transparent"
                        BorderThickness="0" Padding="0"
                        Click="ProfileButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" FontSize="28" Margin="0,0,6,0" Foreground="{DynamicResource IconForegroundBrush}"/>
                        <TextBlock x:Name="LoggedInUserTextBlock"
                                   FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
