<Window x:Class="CommunityHub.Ui.Views.CitizenViews.NeighborhoodCitizensPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        Title="Neighborhood Citizens"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#ECECEF">

    <Grid Background="#ECECEF">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#D8D8D8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1">
            <Border Width="130" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="14,0,0,0" Background="#F4F4F4" BorderBrush="#A0A0A0"
                    BorderThickness="1" CornerRadius="8">
                <TextBlock Text="A Web Page" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Border>

        <Grid Grid.Row="1" Background="#ECECEC">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="←" FontSize="24" FontWeight="Bold" Margin="0,0,18,0"/>
                <TextBlock Text="→" FontSize="24" FontWeight="Bold" Margin="0,0,18,0"/>
                <TextBlock Text="⟳" FontSize="24" FontWeight="Bold"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="10,6,18,6" Background="White"
                    BorderBrush="#2F2F2F" BorderThickness="2" CornerRadius="18">
                <TextBlock Text="https://" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#F4F4F4" BorderBrush="#4A4A4A" BorderThickness="0,2,0,2">
            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="☰" Click="BurgerButton_Click"
                        FontSize="32" FontWeight="Bold" Background="Transparent"
                        BorderThickness="0" Width="60" Height="60" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="{Binding ResultsText}"
                           FontSize="28" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="ProfileButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="32" Margin="0,0,6,0"/>
                            <TextBlock x:Name="LoggedInUserTextBlock" FontSize="22"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" Margin="24,14,24,14" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Citizens}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#4F4F4F" BorderThickness="2"
                                Background="#F9F9F9" Margin="0,0,0,16"
                                Padding="18" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="👤" FontSize="60"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CitizenFullName}"
                                               FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="⭐ Trust level:" FontSize="20"
                                                   FontWeight="Bold" Width="220"/>
                                        <Ellipse Width="20" Height="20" Margin="0,2,10,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding LevelColor}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding LevelDisplay}" FontSize="20"
                                                   FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="📌 Events organized:" FontSize="20"
                                                   FontWeight="Bold" Width="220"/>
                                        <TextBlock Text="{Binding EventsOrganized}" FontSize="20"
                                                   FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🤝 Events volunteered:" FontSize="20"
                                                   FontWeight="Bold" Width="220"/>
                                        <TextBlock Text="{Binding EventsVolunteered}" FontSize="20"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <views:CitizenMenuView x:Name="CitizenMenu"
                               Grid.RowSpan="4"
                               Visibility="Collapsed"
                               Panel.ZIndex="100"/>
    </Grid>
</Window>