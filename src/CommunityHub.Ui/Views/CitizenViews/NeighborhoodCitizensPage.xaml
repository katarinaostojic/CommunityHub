<Window x:Class="CommunityHub.Ui.Views.CitizenViews.NeighborhoodCitizensPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        Title="Neighborhood Citizens"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundLightBrush}">

    <Grid Background="{DynamicResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="174"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Shared NavBar: back/forward strelice + language + theme toggle -->
        <views:CitizenNavBar x:Name="NavBar" Grid.Row="0"/>

        <ScrollViewer Grid.Row="1" Margin="24,14,24,14" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Citizens}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,16"
                                Padding="18" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="60"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                                    <TextBlock Text="{Binding CitizenFullName}"
                                               FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource Citizens_TrustLevel}" FontSize="20"
                                                   FontWeight="Bold" Width="220"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border CornerRadius="12"
                                                Background="{Binding LevelBrush}"
                                                Padding="14,4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LevelDisplay}"
                                                       FontSize="18" FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                   Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                                        <TextBlock Text="{DynamicResource Citizens_Organized}" FontSize="18"
                                                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding EventsOrganized}" FontSize="20"
                                                   FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                   Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                                        <TextBlock Text="{DynamicResource Citizens_Volunteered}" FontSize="18"
                                                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding EventsVolunteered}" FontSize="20"
                                                   FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                   Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                                        <TextBlock Text="{Binding JoinedAt}" FontSize="20"
                                                   FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <views:CitizenMenuView x:Name="CitizenMenu"
                               Grid.RowSpan="2"
                               Visibility="Collapsed"
                               Panel.ZIndex="100"/>
    </Grid>
</Window>