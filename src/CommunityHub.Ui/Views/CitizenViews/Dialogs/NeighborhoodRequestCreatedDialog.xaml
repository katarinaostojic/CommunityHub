<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.NeighborhoodRequestCreatedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Request Created"
        Height="560"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F4F4"
        WindowStyle="SingleBorderWindow">

    <Border Background="White" BorderBrush="Black" BorderThickness="1.5" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="180"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="110"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Background="White" LastChildFill="False">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Request Created"
                               FontSize="28"
                               FontWeight="Bold"/>
                </StackPanel>

                <Button x:Name="CloseButton"
                        Content="✕"
                        Width="45"
                        Height="45"
                        FontSize="24"
                        FontWeight="Bold"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        DockPanel.Dock="Right"
                        Margin="0,4,10,4"/>
            </DockPanel>

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="Your address does not match this neighborhood."
                           FontSize="24"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,18"/>
                <TextBlock Text="Your request has been sent and is waiting for approval."
                           FontSize="24"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="24,10,24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Neighborhood:"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="NeighborhoodNameText"
                           Grid.Row="0" Grid.Column="1"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Citizen:"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="CitizenNameText"
                           Grid.Row="1" Grid.Column="1"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Status:"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="StatusText"
                           Grid.Row="2" Grid.Column="1"
                           Text="Pending approval"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="3" Margin="24,10,24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="GoToDashboardButton"
                        Grid.Column="0"
                        Content="Go to Dashboard"
                        FontSize="20"
                        FontWeight="Bold"
                        Height="56"
                        Width="220"
                        HorizontalAlignment="Left"
                        Background="White"
                        BorderBrush="#3A3A3A"
                        BorderThickness="2"/>

                <Button x:Name="ViewMyRequestsButton"
                        Grid.Column="2"
                        Content="View My Requests"
                        FontSize="20"
                        FontWeight="Bold"
                        Height="56"
                        Width="220"
                        HorizontalAlignment="Right"
                        Background="White"
                        BorderBrush="#3A3A3A"
                        BorderThickness="2"/>
            </Grid>
        </Grid>
    </Border>
</Window>