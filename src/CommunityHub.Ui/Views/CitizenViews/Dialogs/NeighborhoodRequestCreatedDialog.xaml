<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.NeighborhoodRequestCreatedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Request Created"
        Height="560"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundLightBrush}"
        WindowStyle="SingleBorderWindow">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1.5" Margin="10" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="140"/>
                <RowDefinition Height="190"/>
                <RowDefinition Height="95"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Background="{DynamicResource SurfaceBrush}" LastChildFill="False">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Request Created"
                               FontSize="30" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text=" ⓘ"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="CloseButton"
                        Content="✕" Width="45" Height="45"
                        FontSize="24" FontWeight="Bold"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Cursor="Hand" DockPanel.Dock="Right"
                        Margin="0,4,10,4"/>
            </DockPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Your request has been successfully submitted."
                           FontSize="24" FontWeight="Bold"
                           TextWrapping="Wrap" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,16"/>
                <TextBlock Text="A coordinator will review your request shortly."
                           FontSize="24" FontWeight="Bold"
                           TextWrapping="Wrap" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="24,0,24,0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="48"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                           Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text=" Neighborhood:" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock x:Name="NeighborhoodNameText"
                           Grid.Row="0" Grid.Column="1"
                           FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                           Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text=" Citizen:" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock x:Name="CitizenNameText"
                           Grid.Row="1" Grid.Column="1"
                           FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                           Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text=" Created on:" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock x:Name="CreatedOnText"
                           Grid.Row="2" Grid.Column="1"
                           FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                           Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text=" Status:" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <Border Grid.Row="3" Grid.Column="1"
                        CornerRadius="12"
                        Background="#F9A825"
                        Padding="14,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               FontSize="20" FontWeight="Bold"
                               Foreground="White"/>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="24,0,24,16" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="GoToDashboardButton"
                        Grid.Column="0"
                        Content="{DynamicResource Button_Dashboard}"
                        FontSize="22" FontWeight="Bold"
                        Height="60" Width="230"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>

                <Button x:Name="ViewMyRequestsButton"
                        Grid.Column="2"
                        Content="{DynamicResource Button_ViewRequests}"
                        FontSize="22" FontWeight="Bold"
                        Height="60" Width="230"
                        HorizontalAlignment="Right"
                        Background="#0D47A1"
                        Foreground="White" BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>