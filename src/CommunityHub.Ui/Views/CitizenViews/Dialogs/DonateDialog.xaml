<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.DonateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Donate"
        Height="560"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundLightBrush}">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1.5" Margin="10" CornerRadius="12">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource Donate_Title}"
                       FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <Grid Grid.Row="1" Margin="0,20,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <!-- prostor za grešku iznosa -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <!-- prostor za grešku kategorije -->
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <!-- prostor za grešku datuma -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Iznos -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{DynamicResource Donate_Amount}"
                           FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         x:Name="AmountTextBox"
                         FontSize="20" FontWeight="Bold"
                         Padding="10,8" Height="50"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextChanged="AmountTextBox_TextChanged"/>

                <!-- Live greška za iznos -->
                <TextBlock Grid.Row="1" Grid.Column="1"
                           x:Name="AmountErrorText"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#E53935"
                           VerticalAlignment="Top"
                           Visibility="Collapsed"/>

                <!-- Kategorija -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="{DynamicResource Donate_Category}"
                           FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ComboBox Grid.Row="3" Grid.Column="1"
                          x:Name="CategoryComboBox"
                          FontSize="20" FontWeight="Bold"
                          Height="50"
                          BorderBrush="{DynamicResource BorderBrush}"
                          SelectionChanged="CategoryComboBox_SelectionChanged"/>

                <!-- Live greška za kategoriju -->
                <TextBlock Grid.Row="4" Grid.Column="1"
                           x:Name="CategoryErrorText"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#E53935"
                           VerticalAlignment="Top"
                           Visibility="Collapsed"/>

                <!-- Datum -->
                <TextBlock Grid.Row="6" Grid.Column="0"
                           Text="{DynamicResource Donate_Date}"
                           FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <DatePicker Grid.Row="6" Grid.Column="1"
                            x:Name="DonationDatePicker"
                            FontSize="20" FontWeight="Bold"
                            Height="50"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            SelectedDateChanged="DonationDatePicker_SelectedDateChanged"/>

                <!-- Live greška za datum -->
                <TextBlock Grid.Row="7" Grid.Column="1"
                           x:Name="DateErrorText"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="#E53935"
                           VerticalAlignment="Top"
                           Visibility="Collapsed"/>
            </Grid>

            <Grid Grid.Row="2" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{DynamicResource Button_Cancel}"
                        Click="CancelButton_Click"
                        FontSize="22" FontWeight="Bold"
                        Height="58" Margin="0,0,10,0"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>

                <Button Grid.Column="1" x:Name="DonateButton"
                        Content="{DynamicResource Donate_Button}"
                        Click="DonateButton_Click"
                        FontSize="22" FontWeight="Bold"
                        Height="58" Margin="10,0,0,0"
                        Background="#0D47A1"
                        Foreground="White" BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
