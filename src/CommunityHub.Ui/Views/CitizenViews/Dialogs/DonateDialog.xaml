<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.DonateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Donate"
        Height="500"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundLightBrush}">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1.5" Margin="10" CornerRadius="12">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource Donate_Title}"
                       FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <Grid Grid.Row="1" Margin="0,20,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Amount -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{DynamicResource Donate_Amount}"
                           FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         x:Name="AmountTextBox"
                         FontSize="20" FontWeight="Bold"
                         Padding="10,8" Height="50"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- Category -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{DynamicResource Donate_Category}"
                           FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ComboBox Grid.Row="2" Grid.Column="1"
                          x:Name="CategoryComboBox"
                          FontSize="20" FontWeight="Bold"
                          Height="50"
                          BorderBrush="{DynamicResource BorderBrush}"/>

                <!-- Date -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="📅 Datum:"
                           FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <DatePicker Grid.Row="4" Grid.Column="1"
                            x:Name="DonationDatePicker"
                            FontSize="20" FontWeight="Bold"
                            Height="50"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Grid>

            <Grid Grid.Row="2" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{DynamicResource Button_Cancel}"
                        Click="CancelButton_Click"
                        FontSize="22" FontWeight="Bold"
                        Height="58" Margin="0,0,10,0"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>

                <Button Grid.Column="1" Content="{DynamicResource Donate_Button}"
                        Click="DonateButton_Click"
                        FontSize="22" FontWeight="Bold"
                        Height="58" Margin="10,0,0,0"
                        Background="#0D47A1"
                        Foreground="White" BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>