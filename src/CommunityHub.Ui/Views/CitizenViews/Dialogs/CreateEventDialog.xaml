<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.CreateEventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Event"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F4F4">

    <Border Background="White" BorderBrush="Black" BorderThickness="1.5" Margin="10">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <TextBlock Grid.Row="0" Text="Create Event"
                       FontSize="30" FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <!-- CONTENT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Title:" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TitleTextBox" FontSize="18" FontWeight="Bold"
                             Padding="8,6" Margin="0,0,0,16"/>

                    <TextBlock Text="Description:" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBox x:Name="DescriptionTextBox" FontSize="18" FontWeight="Bold"
                             Padding="8,6" Height="100" TextWrapping="Wrap"
                             AcceptsReturn="True" Margin="0,0,0,16"/>

                    <TextBlock Text="Date:" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                    <DatePicker x:Name="EventDatePicker" FontSize="18" FontWeight="Bold"
                                Height="40" Margin="0,0,0,16"/>

                    <TextBlock Text="Start Time (HH:mm):" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBox x:Name="StartTimeTextBox" FontSize="18" FontWeight="Bold"
                             Padding="8,6" Margin="0,0,0,16"/>

                    <TextBlock Text="Duration (minutes):" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBox x:Name="DurationTextBox" FontSize="18" FontWeight="Bold"
                             Padding="8,6" Margin="0,0,0,16"/>

                    <TextBlock Text="Minimum Volunteers:" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBox x:Name="MinVolunteersTextBox" FontSize="18" FontWeight="Bold"
                             Padding="8,6" Margin="0,0,0,16"/>

                    <TextBlock Text="Things to Bring:" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

                    <ItemsControl x:Name="ItemsListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="●" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}" FontSize="18" FontWeight="Bold"
                                               Width="400" VerticalAlignment="Center"/>
                                    <Button Content="✕ Remove" Tag="{Binding}"
                                            Click="RemoveItemButton_Click"
                                            FontSize="16" Background="Transparent"
                                            BorderThickness="0" Foreground="Red"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="+ Add Item" Click="AddItemButton_Click"
                            FontSize="18" FontWeight="Bold"
                            Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- BUTTONS -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancel"
                        Click="CancelButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="52" Background="White"
                        BorderBrush="#3A3A3A" BorderThickness="2"/>

                <Button Grid.Column="2" Content="Create"
                        Click="CreateButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="52" Background="#2C3E50"
                        Foreground="White" BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>