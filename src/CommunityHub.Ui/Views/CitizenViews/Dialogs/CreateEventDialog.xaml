<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.CreateEventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Event"
        Height="760"
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundLightBrush}">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1.5" Margin="10" CornerRadius="12">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource Events_CreateEvent}"
                       FontSize="30" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="{DynamicResource Event_Title}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="TitleTextBox" FontSize="17" FontWeight="Bold"
                             Padding="8,6" Margin="0,0,0,2"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextChanged="TitleTextBox_TextChanged"/>
                    <TextBlock x:Name="TitleError" FontSize="12" Foreground="#E53935"
                               Margin="0,0,0,10" Visibility="Collapsed"/>

                    <TextBlock Text="{DynamicResource Event_Description}" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBox x:Name="DescriptionTextBox" FontSize="17" FontWeight="Bold"
                             Padding="8,6" Height="80" TextWrapping="Wrap"
                             AcceptsReturn="True" Margin="0,0,0,2"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextChanged="DescriptionTextBox_TextChanged"/>
                    <TextBlock x:Name="DescriptionError" FontSize="12" Foreground="#E53935"
                               Margin="0,0,0,10" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource IconForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource Event_Date}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <DatePicker x:Name="EventDatePicker" FontSize="17" FontWeight="Bold"
                                Height="40" Margin="0,0,0,2"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                SelectedDateChanged="EventDatePicker_SelectedDateChanged"/>
                    <TextBlock x:Name="DateError" FontSize="12" Foreground="#E53935"
                               Margin="0,0,0,10" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource IconForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource Event_StartTime}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBox x:Name="StartTimeTextBox" FontSize="17" FontWeight="Bold"
                             Padding="8,6" Margin="0,0,0,2"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextChanged="StartTimeTextBox_TextChanged"/>
                    <TextBlock x:Name="TimeError" FontSize="12" Foreground="#E53935"
                               Margin="0,0,0,10" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource IconForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource Event_Duration}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBox x:Name="DurationTextBox" FontSize="17" FontWeight="Bold"
                             Padding="8,6" Margin="0,0,0,2"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             PreviewTextInput="NumberOnly_PreviewTextInput"
                             TextChanged="DurationTextBox_TextChanged"/>
                    <TextBlock x:Name="DurationError" FontSize="12" Foreground="#E53935"
                               Margin="0,0,0,10" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource IconForegroundBrush}"/>
                        <TextBlock Text="{DynamicResource Event_MinVolunteers}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <TextBox x:Name="MinVolunteersTextBox" FontSize="17" FontWeight="Bold"
                             Padding="8,6" Margin="0,0,0,2"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             PreviewTextInput="NumberOnly_PreviewTextInput"
                             TextChanged="MinVolunteersTextBox_TextChanged"/>
                    <TextBlock x:Name="MinVolunteersError" FontSize="12" Foreground="#E53935"
                               Margin="0,0,0,10" Visibility="Collapsed"/>

                    <TextBlock Text="{DynamicResource Event_ThingsToBring}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <ItemsControl x:Name="ItemsListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="●" FontSize="18" Margin="0,0,10,0"
                                               VerticalAlignment="Center" Foreground="#F9A825"/>
                                    <TextBlock Text="{Binding}" FontSize="18" FontWeight="Bold"
                                               Width="400" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Button Content="{DynamicResource Event_RemoveItem}" Tag="{Binding}"
                                            Click="RemoveItemButton_Click"
                                            FontSize="16" Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource DangerBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="ItemsError" FontSize="12" Foreground="#E53935"
                               Margin="0,0,0,4" Visibility="Collapsed"/>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewItemTextBox"
                                 Grid.Column="0"
                                 FontSize="17" FontWeight="Bold"
                                 Padding="8,6" Height="38"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 KeyDown="NewItemTextBox_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock x:Name="PlaceholderText"
                                                                       Text="{DynamicResource Event_AddItemPlaceholder}"
                                                                       FontSize="16" FontStyle="Italic"
                                                                       Foreground="Gray" Margin="10,6,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="2"
                                Content="{DynamicResource Event_AddItemButton}"
                                Click="AddItemButton_Click"
                                FontSize="17" FontWeight="Bold"
                                Background="#F9A825" Foreground="White"
                                BorderThickness="0" Height="38"
                                Padding="16,0"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{DynamicResource Button_Cancel}"
                        Click="CancelButton_Click"
                        FontSize="20" FontWeight="Bold" Height="52"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                <Button Grid.Column="2" x:Name="CreateButton"
                        Content="{DynamicResource Button_Create}"
                        Click="CreateButton_Click"
                        FontSize="20" FontWeight="Bold" Height="52"
                        Background="#0D47A1" Foreground="White" BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
