<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.RateCoordinatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rate Coordinator"
        Height="500"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundLightBrush}">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1.5" Margin="10" CornerRadius="12">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource Reviews_RateButton}"
                       FontSize="28" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <TextBlock Text="{DynamicResource Reviews_Rating}" FontSize="20" FontWeight="Bold"
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Radio1" Content="1" GroupName="Rating"
                                 FontSize="22" FontWeight="Bold" Margin="0,0,20,0"
                                 Checked="Rating_Checked"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <RadioButton x:Name="Radio2" Content="2" GroupName="Rating"
                                 FontSize="22" FontWeight="Bold" Margin="0,0,20,0"
                                 Checked="Rating_Checked"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <RadioButton x:Name="Radio3" Content="3" GroupName="Rating"
                                 FontSize="22" FontWeight="Bold" Margin="0,0,20,0"
                                 Checked="Rating_Checked"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <RadioButton x:Name="Radio4" Content="4" GroupName="Rating"
                                 FontSize="22" FontWeight="Bold" Margin="0,0,20,0"
                                 Checked="Rating_Checked"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <RadioButton x:Name="Radio5" Content="5" GroupName="Rating"
                                 FontSize="22" FontWeight="Bold"
                                 Checked="Rating_Checked"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock x:Name="RatingErrorText"
                           FontSize="13" Foreground="{DynamicResource DangerBrush}"
                           Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,6">
                <TextBlock Text="{DynamicResource Reviews_Comment}" FontSize="20" FontWeight="Bold"
                           Margin="0,0,0,6"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="CommentRequiredText"
                           FontSize="13" Foreground="{DynamicResource DangerBrush}"
                           Margin="0,0,0,4" Visibility="Collapsed"/>
            </StackPanel>

            <TextBox Grid.Row="3"
                     x:Name="CommentTextBox"
                     FontSize="18"
                     Padding="10,8"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     BorderBrush="{DynamicResource BorderBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="CommentTextBox_TextChanged"/>

            <TextBlock Grid.Row="4"
                       x:Name="CommentErrorText"
                       FontSize="13" Foreground="{DynamicResource DangerBrush}"
                       Margin="0,4,0,0" Visibility="Collapsed"/>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{DynamicResource Button_Cancel}"
                        Click="CancelButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="52"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>

                <Button Grid.Column="2" x:Name="SubmitButton"
                        Content="{DynamicResource Reviews_SubmitButton}"
                        Click="SubmitButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="52"
                        Background="#0D47A1"
                        Foreground="White" BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
