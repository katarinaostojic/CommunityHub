<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.JoinEventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Join Event"
        Height="560"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F4F4">

    <Border Background="White" BorderBrush="Black" BorderThickness="1.5" Margin="10">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <TextBlock Grid.Row="0" Text="Join Event"
                       FontSize="30" FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <!-- CONTENT -->
            <StackPanel Grid.Row="1">
                <TextBlock x:Name="EventNameText"
                           FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="📅 Date: " FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="EventDateText" FontSize="20" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="🕐 Time: " FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="EventTimeText" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text=" | Duration: " FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="EventDurationText" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="min" FontSize="20" FontWeight="Bold"/>
                </StackPanel>

                <TextBlock Text="🎒 Items to bring:"
                           FontSize="20" FontWeight="Bold"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Select items you can bring (optional)"
                           FontSize="16" Foreground="#666666"
                           Margin="0,0,0,10"/>

                <ItemsControl x:Name="ItemsListControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox x:Name="ItemCheckBox"
                                          IsEnabled="{Binding IsAvailable}"
                                          Tag="{Binding ItemId}"
                                          FontSize="18" FontWeight="Bold"
                                          VerticalContentAlignment="Center"
                                          Margin="0,0,16,0"/>
                                <TextBlock Text="{Binding ItemName}"
                                           FontSize="18" FontWeight="Bold"
                                           Width="300"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusDisplay}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{Binding StatusColor}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- BUTTONS -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancel"
                        Click="CancelButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="52" Background="White"
                        BorderBrush="#3A3A3A" BorderThickness="2"/>

                <Button Grid.Column="2" Content="Join"
                        Click="JoinButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="52" Background="#2C3E50"
                        Foreground="White" BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>