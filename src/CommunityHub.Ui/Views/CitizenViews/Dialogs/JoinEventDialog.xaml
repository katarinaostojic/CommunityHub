<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.JoinEventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Join Event"
        Height="560"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundLightBrush}">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1.5" Margin="10" CornerRadius="12">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Join Event"
                       FontSize="30" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <StackPanel Grid.Row="1">
                <TextBlock x:Name="EventNameText"
                           FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                    <TextBlock Text="Date: " FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="EventDateText" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,20,0"/>
                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                    <TextBlock Text="Time: " FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="EventTimeText" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,20,0"/>
                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                    <TextBlock Text="Duration: " FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="EventDurationText" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text=" min" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                    <TextBlock Text="Items to bring:" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <TextBlock Text="Select items you can bring (optional)"
                           FontSize="16"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,10"/>

                <ItemsControl x:Name="ItemsListControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox x:Name="ItemCheckBox"
                                          IsEnabled="{Binding IsAvailable}"
                                          Tag="{Binding ItemId}"
                                          FontSize="18" FontWeight="Bold"
                                          VerticalContentAlignment="Center"
                                          Margin="0,0,16,0"/>
                                <TextBlock Text="{Binding ItemName}"
                                           FontSize="18" FontWeight="Bold"
                                           Width="300" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border CornerRadius="8"
                                        Background="{Binding StatusBackground}"
                                        Padding="10,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusDisplay}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{DynamicResource Button_Cancel}"
                        Click="CancelButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="52"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>

                <Button Grid.Column="2" Content="{DynamicResource Button_Join}"
                        Click="JoinButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="52"
                        Background="#0D47A1"
                        Foreground="White" BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>