<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.SpendingHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spending History"
        Height="620"
        Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundLightBrush}">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1.5" Margin="10" CornerRadius="12">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource Spending_Title}"
                       FontSize="28" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ExpensesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,16"
                                    Padding="20" CornerRadius="12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource Spending_Amount}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Width="160"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="20" FontWeight="Bold"
                                                   Foreground="#0D47A1">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:0.##} €">
                                                    <Binding Path="Amount"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="{DynamicResource Spending_Description}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Width="160"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="20" FontWeight="Bold"
                                                   TextWrapping="Wrap" Width="480"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Spending_Date}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Width="160"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding CreatedAt}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Row="2" Content="{DynamicResource Button_Back}"
                    Click="BackButton_Click"
                    FontSize="20" FontWeight="Bold"
                    Height="52" Padding="20,0"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"/>
        </Grid>
    </Border>
</Window>