<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.NeighborhoodAccessRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Request Access"
        Height="620"
        Width="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundLightBrush}"
        WindowStyle="SingleBorderWindow">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1.5" Margin="10" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="120"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Background="{StaticResource SurfaceBrush}" LastChildFill="False">
                <TextBlock Text="Request Access"
                           FontSize="30" FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Button x:Name="CloseButton"
                        Content="✕" Width="45" Height="45"
                        FontSize="24" FontWeight="Bold"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Cursor="Hand" DockPanel.Dock="Right"
                        Margin="0,4,10,4"/>
            </DockPanel>

            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="NeighborhoodNameText"
                               FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Left"
                               Width="320"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="18,0,0,8"/>

                    <Border Width="320" Height="220"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        Background="#E3F2FD"
        CornerRadius="8"
        HorizontalAlignment="Center">
                        <Image x:Name="NeighborhoodImage" Stretch="Fill"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,44,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="🏘️" FontSize="30"
                                   VerticalAlignment="Top" Margin="0,0,10,0"/>
                        <TextBlock x:Name="AddressText"
                                   FontSize="24" FontWeight="Bold"
                                   TextWrapping="Wrap" Width="480"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="🌍" FontSize="30"
                                   VerticalAlignment="Top" Margin="0,0,10,0"/>
                        <TextBlock x:Name="LocationText"
                                   FontSize="24" FontWeight="Bold"
                                   TextWrapping="Wrap" Width="480"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="📝" FontSize="30"
                                   VerticalAlignment="Top" Margin="0,0,10,0"/>
                        <TextBlock x:Name="DescriptionText"
                                   FontSize="22" FontWeight="Bold"
                                   TextWrapping="Wrap" Width="480"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Checking your address..."
                           FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,20"/>
                <ProgressBar Width="220" Height="18"
             IsIndeterminate="True"
             Foreground="#F9A825"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>