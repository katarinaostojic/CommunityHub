<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.AddItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Item"
        Height="380"
        Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundLightBrush}">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1.5" Margin="10" CornerRadius="12">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Add Item +"
                       FontSize="30" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Item Name:"
                           FontSize="22" FontWeight="Bold"
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="ItemNameTextBox"
                         FontSize="20" FontWeight="Bold"
                         Padding="10,8" Height="50"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>

            <Grid Grid.Row="2" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{DynamicResource Button_Cancel}"
                        Click="CancelButton_Click"
                        FontSize="22" FontWeight="Bold"
                        Height="58"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>

                <Button Grid.Column="2" Content="{DynamicResource Button_Add}"
                        Click="AddButton_Click"
                        FontSize="22" FontWeight="Bold"
                        Height="58"
                        Background="#0D47A1"
                        Foreground="White" BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>