<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.AddItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Item"
        Height="280"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F4F4">

    <Border Background="White" BorderBrush="Black" BorderThickness="1.5" Margin="10">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Add Item +"
                       FontSize="26" FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Item Name:" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox x:Name="ItemNameTextBox"
                         FontSize="18" FontWeight="Bold"
                         Padding="8,6"/>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancel"
                        Click="CancelButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="52" Background="White"
                        BorderBrush="#3A3A3A" BorderThickness="2"/>

                <Button Grid.Column="2" Content="Add"
                        Click="AddButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="52" Background="#2C3E50"
                        Foreground="White" BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>