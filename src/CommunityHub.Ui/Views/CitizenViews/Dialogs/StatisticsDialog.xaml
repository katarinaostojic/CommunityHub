<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.StatisticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statistics"
        Height="620"
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundLightBrush}">

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1.5" Margin="10" CornerRadius="12">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource Statistics_Title}"
                       FontSize="28" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <!-- Monthly/Yearly toggle -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="MonthlyRadio"
                             Content="{DynamicResource Statistics_Monthly}"
                             GroupName="Period"
                             FontSize="20" FontWeight="Bold"
                             IsChecked="True"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Margin="0,0,40,0"
                             Checked="PeriodRadio_Checked"/>
                <RadioButton x:Name="YearlyRadio"
                             Content="{DynamicResource Statistics_Yearly}"
                             GroupName="Period"
                             FontSize="20" FontWeight="Bold"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Checked="PeriodRadio_Checked"/>
            </StackPanel>

            <!-- Total -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Statistics_Total}"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="TotalReservationsText"
                           FontSize="22" FontWeight="Bold"
                           Margin="8,0,0,0"
                           Foreground="#0D47A1"/>
            </StackPanel>

            <!-- Lista objekata -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="StatisticsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource SurfaceBrush}"
                                    Margin="0,0,16,16" Padding="16" CornerRadius="12"
                                    Width="240">
                                <StackPanel>
                                    <Border Width="180" Height="120"
                                            Background="{DynamicResource SurfaceSoftBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="8"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,10">
                                        <TextBlock Text="🏛️" FontSize="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="{Binding CityObjectName}"
                                               FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                Margin="0,0,0,12">
                                        <TextBlock Text="{DynamicResource Statistics_Visits}"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding VisitCount}"
                                                   FontSize="18" FontWeight="Bold"
                                                   Margin="6,0,0,0"
                                                   Foreground="#0D47A1"/>
                                    </StackPanel>

                                    <Button Content="{DynamicResource Statistics_ViewHistory}"
                                            Tag="{Binding}"
                                            Click="ViewHistoryButton_Click"
                                            FontSize="16" FontWeight="Bold"
                                            Height="40" Padding="12,0"
                                            Background="#0D47A1"
                                            Foreground="White" BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Grid.Row="4" Content="{DynamicResource Button_Back}"
                    Click="BackButton_Click"
                    FontSize="20" FontWeight="Bold"
                    Height="52" Padding="20,0"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"/>
        </Grid>
    </Border>
</Window>