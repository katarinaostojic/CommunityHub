<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.VoteDateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vote"
        Height="560"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundLightBrush}">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1.5" Margin="10" CornerRadius="12">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Vote for Meeting Date"
                       FontSize="28" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <StackPanel Grid.Row="1" Margin="0,10,0,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="🕐" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MeetingTimeText" FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>

                <TextBlock Text="📅 Select a date:" FontSize="20" FontWeight="Bold"
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DatesListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding}"
                                             GroupName="DateGroup"
                                             FontSize="20" FontWeight="Bold"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Margin="20,6,0,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{DynamicResource Button_Cancel}"
                        Click="CancelButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="58"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>

                <Button Grid.Column="2" Content="{DynamicResource Button_Vote}"
                        Click="VoteButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="58"
                        Background="#0D47A1"
                        Foreground="White" BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>