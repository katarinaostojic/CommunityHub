<Window x:Class="CommunityHub.Ui.Views.CitizenViews.Dialogs.VoteDateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vote"
        Height="560"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F4F4">

    <Border Background="White" BorderBrush="Black" BorderThickness="1.5" Margin="10">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Vote for Meeting Date"
                       FontSize="28" FontWeight="Bold"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="1" Margin="0,10,0,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="ⓘ Meeting info:" FontSize="20"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,8">
                    <TextBlock Text="🕐 Time: " FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="MeetingTimeText" FontSize="20" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="📅 Select one date:" FontSize="20" FontWeight="Bold"/>
                </StackPanel>

                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DatesListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Content="{Binding}"
                                             GroupName="DateGroup"
                                             FontSize="20" FontWeight="Bold"
                                             Margin="20,6,0,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Cancel"
                        Click="CancelButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="58" Background="White"
                        BorderBrush="#3A3A3A" BorderThickness="2"/>

                <Button Grid.Column="2" Content="Vote"
                        Click="VoteButton_Click"
                        FontSize="20" FontWeight="Bold"
                        Height="58" Background="#2C3E50"
                        Foreground="White" BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>