<Window x:Class="CommunityHub.Ui.Views.CitizenViews.BrowseNeighborhoodPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:CommunityHub.Ui.Converters"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        xmlns:views="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        mc:Ignorable="d"
        Title="Browse Neighborhoods"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundLightBrush}">

    <Window.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundLightBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="174"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Shared NavBar sa back/forward, language, theme -->
        <views:CitizenNavBar x:Name="NavBar" Grid.Row="0"/>

        <!-- Page-specifična traka: search + reset + filter (ostaje odvojena jer ima search box) -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,8,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Height="46" VerticalAlignment="Center"
                        Margin="0,0,16,0" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⌕" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#F9A825"/>
                        <TextBox Grid.Column="1" x:Name="SearchTextBox" BorderThickness="0"
                                 Background="Transparent" FontSize="18" FontWeight="Bold"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextChanged="SearchTextBox_TextChanged"/>
                    </Grid>
                </Border>

                <Button Grid.Column="1" Content="{DynamicResource Browse_Reset}"
                        Click="ResetButton_Click"
                        FontSize="18" FontWeight="Bold"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="2" Height="46"/>

                <Button Grid.Column="3" Content="{DynamicResource Browse_Filter}"
                        Click="FilterButton_Click"
                        FontSize="18" FontWeight="Bold"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="2" Height="46"/>
            </Grid>
        </Border>

        <!-- Sadržaj -->
        <Grid Grid.Row="2" Margin="24,14,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding ResultsTitleText}"
                       FontSize="32" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,14" VerticalAlignment="Center"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredNeighborhoods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,16"
                                    Padding="18" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="330"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                   FontSize="26" FontWeight="Bold"
                                                   HorizontalAlignment="Left" Width="300"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,0,0,8"/>
                                        <Border Width="300" Height="200"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                Background="{DynamicResource SurfaceSoftBrush}">
                                            <Image Stretch="Fill">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Source" Value="/Images/neighborhoods/liman.jpg"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Name, Mode=OneWay}" Value="Dorcol">
                                                                <Setter Property="Source" Value="/Images/neighborhoods/dorcol.jpg"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name, Mode=OneWay}" Value="Liman">
                                                                <Setter Property="Source" Value="/Images/neighborhoods/liman.jpg"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name, Mode=OneWay}" Value="Podbara">
                                                                <Setter Property="Source" Value="/Images/neighborhoods/podbara.jpg"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="24,4,20,4">
                                        <StackPanel Margin="0,0,0,18">
                                            <TextBlock Text="{DynamicResource Browse_Streets}" FontSize="22"
                                                       FontWeight="Bold" Margin="0,0,0,8"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <ItemsControl ItemsSource="{Binding Streets, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="20" FontWeight="Bold"
                                                                   Margin="12,0,0,6"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                                            <Run Text="{Binding StreetName, Mode=OneWay}"/>
                                                            <Run Text=" "/>
                                                            <Run Text="{Binding StartNumber, Mode=OneWay}"/>
                                                            <Run Text=" - "/>
                                                            <Run Text="{Binding EndNumber, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource IconForegroundBrush}"/>
                                            <TextBlock FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                                <Run Text="{Binding CityName, Mode=OneWay}"/>
                                                <Run Text=", "/>
                                                <Run Text="{Binding CountryName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{DynamicResource IconForegroundBrush}"/>
                                            <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                       FontSize="20" FontWeight="Bold"
                                                       Width="440" TextWrapping="Wrap" VerticalAlignment="Top"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="{DynamicResource Browse_RequestAccess}"
                                            Tag="{Binding Mode=OneWay}"
                                            Click="RequestAccessButton_Click"
                                            FontSize="20" FontWeight="Bold"
                                            Width="180" Height="70"
                                            VerticalAlignment="Center" HorizontalAlignment="Right"
                                            Background="#0D47A1" Foreground="White" BorderThickness="0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Filter overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              x:Name="Overlay"
              Background="#66000000"
              Visibility="Collapsed"
              MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
              Panel.ZIndex="20"/>

        <Border Grid.Row="0" Grid.RowSpan="3"
                Width="320" HorizontalAlignment="Left"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0" Panel.ZIndex="21">
            <Border.RenderTransform>
                <TranslateTransform x:Name="FilterPanelTranslate" X="-320"/>
            </Border.RenderTransform>
            <StackPanel Margin="22">
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="{DynamicResource Browse_FilterTitle}" FontSize="26" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button Content="✕" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0"
                            FontSize="20" FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            Click="FilterButton_Click"/>
                </Grid>
                <TextBlock Text="{DynamicResource Browse_NeighborhoodName}" FontSize="18" FontWeight="Bold"
                           Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="FilterNameTextBox" Padding="8,8" FontSize="18" FontWeight="Bold"
                         Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}"/>
                <TextBlock Text="{DynamicResource Browse_Address}" FontSize="18" FontWeight="Bold"
                           Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="FilterAddressTextBox" Padding="8,8" FontSize="18" FontWeight="Bold"
                         Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}"/>
                <TextBlock Text="{DynamicResource Browse_City}" FontSize="18" FontWeight="Bold"
                           Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="FilterCityTextBox" Padding="8,8" FontSize="18" FontWeight="Bold"
                         Margin="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}"/>
                <TextBlock Text="{DynamicResource Browse_Country}" FontSize="18" FontWeight="Bold"
                           Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBox x:Name="FilterCountryTextBox" Padding="8,8" FontSize="18" FontWeight="Bold"
                         Margin="0,0,0,24" BorderBrush="{DynamicResource BorderBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{DynamicResource Browse_ResetFilters}"
                            Padding="0,12" FontSize="16" FontWeight="Bold"
                            Background="{DynamicResource SurfaceBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Click="ResetFiltersButton_Click"/>
                    <Button Grid.Column="2" Content="{DynamicResource Browse_ApplyFilters}"
                            Padding="0,12" FontSize="16" FontWeight="Bold"
                            Background="#0D47A1" Foreground="White" BorderThickness="0"
                            Click="ApplyFiltersButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <local:CitizenMenuView x:Name="CitizenMenu"
                               Grid.Row="0" Grid.RowSpan="3"
                               Visibility="Collapsed"
                               Panel.ZIndex="100"/>
    </Grid>
</Window>
