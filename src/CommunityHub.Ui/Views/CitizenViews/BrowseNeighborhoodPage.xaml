<Window x:Class="CommunityHub.Ui.Views.CitizenViews.BrowseNeighborhoodPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        mc:Ignorable="d"
        Title="Browse Neighborhoods" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5F6FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="SearchTextBox"
                         Padding="8,6"
                         FontSize="13"
                         Margin="0,0,8,0"
                         TextChanged="SearchTextBox_TextChanged"/>

                <Button Grid.Column="1"
                        Content="Reset All"
                        Click="ResetButton_Click"
                        Padding="10,6"
                        Margin="0,0,8,0"
                        FontSize="13"/>

                <Button Grid.Column="2"
                        Content="▼ Filter"
                        Click="FilterButton_Click"
                        Padding="10,6"
                        Margin="0,0,8,0"
                        FontSize="13"/>

                <TextBlock Grid.Column="3"
                           Text="👤 Građanin"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="13"/>
            </Grid>
        </Border>

        <!-- Title row -->
        <Grid Grid.Row="1" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Browse Neighborhoods"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="My Requests"
                    Click="MyRequestsButton_Click"
                    Padding="12,6"
                    FontSize="13"/>
        </Grid>

        <!-- Neighborhood list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16,0,16,0">
            <ItemsControl x:Name="NeighborhoodsPanel">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#D0D0D0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,10"
                                Padding="12"
                                Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Info -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6"/>

                                    <TextBlock FontSize="13" Margin="0,0,0,4"
                                               Text="{Binding City.Name, StringFormat=City: {0}}"/>

                                    <TextBlock FontSize="13"
                                               Margin="0,0,0,4"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap"/>

                                    <TextBlock FontSize="13"
                                               Text="{Binding Budget, StringFormat=Budget: {0}}"/>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0">
                                    <Button Content="Request Access"
                                            Padding="12,6"
                                            FontSize="13"
                                            Tag="{Binding}"
                                            Click="RequestAccessButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Pagination -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,10">
            <Button Content="&lt;"
                    Click="PrevPageButton_Click"
                    Padding="10,6"
                    Margin="0,0,4,0"
                    FontSize="13"/>

            <TextBlock x:Name="PageLabel"
                       Text="Page 1 of 1"
                       VerticalAlignment="Center"
                       Margin="8,0"
                       FontSize="13"/>

            <Button Content="&gt;"
                    Click="NextPageButton_Click"
                    Padding="10,6"
                    Margin="4,0,0,0"
                    FontSize="13"/>
        </StackPanel>

        <!-- Overlay -->
        <Grid Grid.Row="0"
              Grid.RowSpan="4"
              x:Name="Overlay"
              Background="#66000000"
              Visibility="Collapsed"
              MouseLeftButtonDown="Overlay_MouseLeftButtonDown"/>

        <!-- Filter panel -->
        <Border Grid.Row="0"
                Grid.RowSpan="4"
                Width="300"
                HorizontalAlignment="Left"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,1,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="FilterPanelTranslate" X="-300"/>
            </Border.RenderTransform>

            <StackPanel Margin="20">
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="Filter"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="16"
                            Click="FilterButton_Click"/>
                </Grid>

                <TextBlock Text="Neighborhood Name:"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="FilterNameTextBox"
                         Padding="8,6"
                         FontSize="13"
                         Margin="0,0,0,16"/>

                <TextBlock Text="City:"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="FilterCityTextBox"
                         Padding="8,6"
                         FontSize="13"
                         Margin="0,0,0,24"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Reset Filters"
                            Padding="0,8"
                            FontSize="13"
                            Click="ResetFiltersButton_Click"/>

                    <Button Grid.Column="2"
                            Content="Apply Filters"
                            Padding="0,8"
                            FontSize="13"
                            Background="#2C3E50"
                            Foreground="White"
                            Click="ApplyFiltersButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>