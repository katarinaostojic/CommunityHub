<Window x:Class="CommunityHub.Ui.Views.CitizenViews.BrowseNeighborhoodPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:CommunityHub.Ui.Converters"
        xmlns:local="clr-namespace:CommunityHub.Ui.Views.CitizenViews"
        mc:Ignorable="d"
        Title="Browse Neighborhoods"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#ECECEF">

    <Window.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>

    <Grid Background="#ECECEF">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#D8D8D8" BorderBrush="#8A8A8A" BorderThickness="0,0,0,1">
            <Border Width="130" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="14,0,0,0" Background="#F4F4F4" BorderBrush="#A0A0A0"
                    BorderThickness="1" CornerRadius="8">
                <TextBlock Text="A Web Page" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Border>

        <Grid Grid.Row="1" Background="#ECECEC">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <TextBlock Text="←" FontSize="24" FontWeight="Bold" Margin="0,0,18,0"/>
                <TextBlock Text="→" FontSize="24" FontWeight="Bold" Margin="0,0,18,0"/>
                <TextBlock Text="⟳" FontSize="24" FontWeight="Bold"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="10,6,18,6" Background="White"
                    BorderBrush="#2F2F2F" BorderThickness="2" CornerRadius="18">
                <TextBlock Text="https://" FontSize="20" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#F4F4F4" BorderBrush="#4A4A4A" BorderThickness="0,2,0,2">
            <Grid Margin="18,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="520"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="☰" Click="BurgerButton_Click"
                        FontSize="36" FontWeight="Bold" Background="Transparent"
                        BorderThickness="0" Width="70" Height="70"
                        VerticalAlignment="Center" HorizontalAlignment="Left"/>

                <Border Grid.Column="1" Height="46" VerticalAlignment="Center"
                        Margin="22,0,28,0" Background="White"
                        BorderBrush="#2F2F2F" BorderThickness="2" CornerRadius="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⌕" FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="SearchTextBox" BorderThickness="0"
                                 Background="Transparent" FontSize="18" FontWeight="Bold"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchTextBox_TextChanged"/>
                    </Grid>
                </Border>

                <Button Grid.Column="2" Content="Reset" Click="ResetButton_Click"
                        FontSize="20" FontWeight="Bold" Background="White"
                        BorderBrush="#3A3A3A" BorderThickness="2" Height="54" Margin="0,0,26,0"/>

                <Button Grid.Column="3" Content="Filter" Click="FilterButton_Click"
                        FontSize="20" FontWeight="Bold" Background="White"
                        BorderBrush="#3A3A3A" BorderThickness="2" Height="54" Margin="0,0,24,0"/>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="ProfileButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="32" Margin="0,0,6,0"/>
                            <TextBlock x:Name="LoggedInUserTextBlock" FontSize="22"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="24,14,24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding ResultsTitleText}"
                       FontSize="32" FontWeight="Bold"
                       Margin="0,0,0,14" VerticalAlignment="Center"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredNeighborhoods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#4F4F4F" BorderThickness="2"
                                    Background="#F9F9F9" Margin="0,0,0,16"
                                    Padding="18" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="330"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <Border Width="300" Height="200"
                                                BorderBrush="#2F2F2F" BorderThickness="2"
                                                Background="White">
                                            <Image Stretch="Fill">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Source" Value="/images/neighborhoods/liman.jpg"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Name, Mode=OneWay}" Value="Dorcol">
                                                                <Setter Property="Source" Value="/images/neighborhoods/dorcol.jpg"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name, Mode=OneWay}" Value="Liman">
                                                                <Setter Property="Source" Value="/images/neighborhoods/liman.jpg"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Name, Mode=OneWay}" Value="Podbara">
                                                                <Setter Property="Source" Value="/images/neighborhoods/podbara.jpg"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Border>

                                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                   FontSize="26" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,12,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="24,4,20,4">
                                        <StackPanel Margin="0,0,0,18">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="🏘️" FontSize="28"
                                                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Streets:" FontSize="22"
                                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Streets, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="20" FontWeight="Bold"
                                                                   Margin="38,0,0,6">
                                                            <Run Text="{Binding StreetName, Mode=OneWay}"/>
                                                            <Run Text=" "/>
                                                            <Run Text="{Binding StartNumber, Mode=OneWay}"/>
                                                            <Run Text=" - "/>
                                                            <Run Text="{Binding EndNumber, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                            <TextBlock Text="🌍" FontSize="28"
                                                       Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Location:" FontSize="22"
                                                       FontWeight="Bold" Margin="0,0,10,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock FontSize="22" FontWeight="Bold"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding CityName, Mode=OneWay}"/>
                                                <Run Text=", "/>
                                                <Run Text="{Binding CountryName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📝" FontSize="28"
                                                       Margin="0,0,10,0" VerticalAlignment="Top"/>
                                            <TextBlock Text="Description:" FontSize="22"
                                                       FontWeight="Bold" Margin="0,0,10,0"
                                                       VerticalAlignment="Top"/>
                                            <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                       FontSize="20" FontWeight="Bold"
                                                       Width="440" TextWrapping="Wrap"
                                                       VerticalAlignment="Top"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="Request Access"
                                            Tag="{Binding Mode=OneWay}"
                                            Click="RequestAccessButton_Click"
                                            FontSize="20" FontWeight="Bold"
                                            Width="180" Height="70"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Background="#2C3E50"
                                            Foreground="White"
                                            BorderThickness="0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="4"
              x:Name="Overlay"
              Background="#66000000"
              Visibility="Collapsed"
              MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
              Panel.ZIndex="20"/>

        <Border Grid.Row="0" Grid.RowSpan="4"
                Width="320" HorizontalAlignment="Left"
                Background="White" BorderBrush="#CCCCCC"
                BorderThickness="0,0,2,0" Panel.ZIndex="21">
            <Border.RenderTransform>
                <TranslateTransform x:Name="FilterPanelTranslate" X="-320"/>
            </Border.RenderTransform>

            <StackPanel Margin="22">
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="Filter" FontSize="26" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0"
                            FontSize="20" FontWeight="Bold"
                            Click="FilterButton_Click"/>
                </Grid>

                <TextBlock Text="Neighborhood Name:" FontSize="18"
                           FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBox x:Name="FilterNameTextBox" Padding="8,8"
                         FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                <TextBlock Text="Address:" FontSize="18"
                           FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBox x:Name="FilterAddressTextBox" Padding="8,8"
                         FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                <TextBlock Text="City:" FontSize="18"
                           FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBox x:Name="FilterCityTextBox" Padding="8,8"
                         FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                <TextBlock Text="Country:" FontSize="18"
                           FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBox x:Name="FilterCountryTextBox" Padding="8,8"
                         FontSize="18" FontWeight="Bold" Margin="0,0,0,24"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Reset Filters"
                            Padding="0,12" FontSize="16" FontWeight="Bold"
                            Click="ResetFiltersButton_Click"/>

                    <Button Grid.Column="2" Content="Apply Filters"
                            Padding="0,12" FontSize="16" FontWeight="Bold"
                            Background="#2C3E50" Foreground="White"
                            Click="ApplyFiltersButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <local:CitizenMenuView x:Name="CitizenMenu"
                               Grid.Row="0" Grid.RowSpan="4"
                               Visibility="Collapsed"
                               Panel.ZIndex="100"/>
    </Grid>
</Window>