                              Margin="0,6,0,0">

                                <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="4">
                                    <ScrollViewer CanContentScroll="True"
